<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The CLI is the "-Console" exe; the plain "-Server" name belongs to the WINDOW, because that is
         what an operator double-clicks and what the installer's shortcut points at. -->
    <AssemblyName>$(GameNameSlug)-Server-Console</AssemblyName>
    <ApplicationIcon>$(ServerIcon)</ApplicationIcon>
    <!-- The world is resident for the process's whole life and the game loop's tightest tick is 100ms, so
         collection pauses are the cost that matters, not peak footprint. Measured on a 13-million-object
         heap: full gen2 243ms -> 135ms, and a large map's deserialize 168ms -> 76ms. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\src\Mirage.Shared\Mirage.Shared.csproj" />
    <ProjectReference Include="..\Mirage.Server.Core\Mirage.Server.Core.csproj" />
    <ProjectReference Include="..\..\..\shared\src\Mirage.Updates\Mirage.Updates.csproj" />
    <!-- The game this server loads. A different game replaces this reference and the one line in
         GameModules; nothing else about the host changes. See modules/README.md. -->
    <!-- The scripting host. A world carries its own rules, so the server that loads a world is the
         thing that reads them - which is what makes Compass a build dependency of the server rather
         than of the solution alone. See docs/scripting.md. -->
    <ProjectReference Include="..\..\..\scripting\src\Mirage.Scripting\Mirage.Scripting.csproj" />
  </ItemGroup>

  <!-- The tracked world, listed so the IDE shows it. Copied to the output by _SeedFromSource below. -->
  <ItemGroup>
    <None Include="world\*.json" />
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Shipped rather than written on first boot, so the settings are discoverable. Every value is a
         default, so deleting it changes nothing. -->
    <Content Include="serverconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 🔴 A SOURCE RUN SEEDS ITSELF, the same way an installed one does.

       Program.cs lays `seed-world/` down beside the executable into the world directory, but only the
       publish projects produced that folder — so `dotnet run` resolved the per-user world, found
       nothing, and padded it blank. A developer got an empty world and had to point WorldDir somewhere
       or copy the folder by hand, while every installed copy started on the demo world.

       The names matter and are the same at both ends: `seed-world` is never named `world`, so nothing a
       build or an update writes can land on top of an authored world. SeedIfAbsent copies only where
       the target directory does NOT EXIST, and an empty one is somebody's blank canvas.

       ⚠ SkipUnchangedFiles, or every build recopies the whole world. -->
  <Target Name="_SeedFromSource" AfterTargets="Build">
    <ItemGroup>
      <_SeedWorld Include="world/**/*" />
      <_SeedData Include="data/motd.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_SeedWorld)" SkipUnchangedFiles="true"
          DestinationFolder="$(OutDir)seed-world/%(RecursiveDir)" />
    <Copy SourceFiles="@(_SeedData)" SkipUnchangedFiles="true"
          DestinationFolder="$(OutDir)seed-data/%(RecursiveDir)" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Serilog.Expressions" Version="5.0.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
