{
  "name": "Little Bram (Local)",
  "speakerNpc": 152,
  "rootNodeId": 1,
  "nodes": [
    {
      "id": 1,
      "speaker": "",
      "text": "Want to hear a joke? Maud says I'm not to tell it to customers but you're not a customer, you're an adventurer.",
      "choices": [
        {
          "label": "Go on then.",
          "nextNodeId": 2,
          "action": "None"
        },
        {
          "label": "Not right now.",
          "nextNodeId": 0,
          "action": "None"
        }
      ]
    },
    {
      "id": 2,
      "speaker": "",
      "text": "How many bandits does it take to hold a causeway?\n\n...Fewer, once you've been through. That's the joke. Maud says it's not a joke, it's just a fact said in a joke voice.",
      "choices": [
        {
          "label": "It's not bad.",
          "nextNodeId": 3,
          "action": "None"
        },
        {
          "label": "That's terrible.",
          "nextNodeId": 4,
          "action": "None"
        }
      ]
    },
    {
      "id": 3,
      "speaker": "",
      "text": "Ha! I'm telling her you said that.",
      "choices": [
        {
          "label": "Do that.",
          "nextNodeId": 0,
          "action": "None"
        }
      ]
    },
    {
      "id": 4,
      "speaker": "",
      "text": "That's what she said.\n\nI'll get a better one. I've got all week - I'm not allowed past the second stilt.",
      "choices": [
        {
          "label": "Keep working on it.",
          "nextNodeId": 0,
          "action": "None"
        }
      ]
    }
  ]
}