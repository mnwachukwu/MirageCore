# What happens when a surveyor uses one of this game's verbs.

shared model Notes

    public function Did(Player who, string action, string on)
        if action == Book.Note
            Notes.Write(who);
            yield;
        end if

        if action == Book.Identify
            Notes.Name(who, on);
            yield;
        end if

        if action == Book.Compare
            Notes.Against(who, on);
        end if

        # Opening the book reaches here too and does nothing on purpose: the client already holds every
        # value it shows, so the server has nothing to add.
    end function

    # A sighting, filled in on the field book and sent.
    #
    # ⚠ The message is named as TEXT, the same way every other name a script writes is. A game with
    # one message could skip the guard; one with two cannot, and the guard is one line either way.
    public function Recorded(Player who, string message, Values values)
        if message != "Sighting"
            yield;
        end if

        string what = values.Text("what");

        if what == ""
            who.Message("A sighting needs something to have seen.");
            yield;
        end if

        # A field the line left out is ABSENT rather than zero, and Has is what tells the two apart.
        # Here the difference does not matter and one is a sensible default, so it is not asked.
        integer many = values.Number("howMany");

        if many < 1
            many = 1;
        end if

        who.Message("Recorded: " + many + " x " + what
                + " (" + values.Text("certainty") + ").");

        Notes.Write(who);
    end function

    # Writing something down costs what a step costs, so a surveyor cannot stand still and catalog
    # forever.
    function Write(Player who)
        integer stamina = who.Number(Surveyor.Stamina);

        if stamina <= 0
            who.Message("You are too tired to write anything legible.");
            yield;
        end if

        who.SetNumber(Surveyor.Stamina, stamina - Surveyor.StepCost);
        Surveyor.Cataloged(who, who.Number(Surveyor.Specimens) + 1);

        who.Message("You write down what is in front of you.");
    end function

    # Say what the surveyor is looking at, and count it.
    function Name(Player who, string on)
        if on == ""
            who.Message("There is nothing there to identify.");
            yield;
        end if

        who.Message("You note down: " + on + ".");
        Notes.Write(who);
    end function

    # Two surveyors comparing counts. Both are told, which is the point of it — and the other body is
    # reached through the name the verb arrived with.
    function Against(Player who, string on)
        Player? them = who.Find(on);

        # Narrowed by the guard: past this line the compiler knows there is a body there, so nothing
        # below has to ask again.
        if not them.HasValue()
            who.Message("There is nobody there to compare notes with.");
            yield;
        end if

        integer mine = who.Number(Surveyor.Specimens);
        integer theirs = them.Number(Surveyor.Specimens);

        who.Message("You compare notes with " + on + ": " + mine + " against " + theirs + ".");
        them.Message(on + " compares notes with you: " + theirs + " against " + mine + ".");
    end function

end model
