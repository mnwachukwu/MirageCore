# What a surveyor IS: what they carry, where they carry it, and what the sidebar says about them.

shared model Surveyor

    # ⚠ Every one of these names reaches a save file and a socket. Renaming one is a data change rather
    # than a rename, which is why they are written once here and read everywhere else.
    public string Stamina = "stamina";
    public string StaminaMax = "staminaMax";
    public string Specimens = "specimens";
    public string Rank = "rank";

    # What a rested surveyor starts the day with, and what one step costs.
    public integer Full = 40;
    public integer StepCost = 1;

    public function Declare(Builder game)
        # Viewport rather than owner: an onlooker sees how tired somebody is and what they have earned,
        # because both are drawn over their head or beside their name. Owner would hide them from
        # everybody but the player, which is right for a purse and wrong for these.
        game.Attribute(Surveyor.Stamina, "viewport");
        game.Attribute(Surveyor.StaminaMax, "viewport");
        game.Attribute(Surveyor.Rank, "viewport");
        game.Attribute(Surveyor.Specimens, "owner");

        game.EquipSlot("satchel", "Satchel");

        game.Bar(Surveyor.Stamina, Surveyor.StaminaMax, 120, 190, 90);

        game.Heading("Survey");
        game.Field(Surveyor.Rank, "Rank", 200, 200, 160);
        game.Field(Surveyor.Specimens, "Specimens", 200, 200, 160);
        game.Meter(Surveyor.Stamina, Surveyor.StaminaMax, "Stamina", 120, 190, 90);
    end function

    # A surveyor arrives. One who has never been here is enrolled; one coming back keeps what they had,
    # because their attributes were persisted with their character.
    public function Enrol(Player who)
        if who.Has(Surveyor.StaminaMax)
            yield;
        end if

        who.SetNumber(Surveyor.StaminaMax, Surveyor.Full);
        who.SetNumber(Surveyor.Stamina, Surveyor.Full);
        who.SetNumber(Surveyor.Specimens, 0);
        who.SetText(Surveyor.Rank, Ranks.For(0));

        who.Message("The survey is yours to run. Walk, look, and write down what grows here.");
    end function

    # One more thing catalogued, and whatever that has earned.
    public function Catalogued(Player who, integer found)
        who.SetNumber(Surveyor.Specimens, found);
        who.SetText(Surveyor.Rank, Ranks.For(found));
    end function

end model
