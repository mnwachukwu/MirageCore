<?xml version="1.0" encoding="utf-8"?>
<!-- Publishes to its OWN folder, which the server's publish then copies into the package payload.

     Two projects must NOT share a PublishDir, however tempting it is when they ship together: the
     second one to run treats the first one's content files as stale leftovers and deletes them. That
     cost the payload appsettings.json and serverconfig.json, and it only appeared on the SECOND
     publish, because the first run wrote them after the sweep rather than before it.

     The copy step lives in Mirage.Server.Publish.csproj, which is also what puts this exe beside the
     server's inside one install. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>osx-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <PublishDir>$(RepoRoot)dist/server-shell/osx-x64/</PublishDir>
  </PropertyGroup>
</Project>
