<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Mirage.Modules.Survey</AssemblyName>
    <RootNamespace>Mirage.Modules.Survey</RootNamespace>
  </PropertyGroup>

  <!-- A module references the SHARED assembly and nothing else. Not the server, not the client, not the
       editor: everything a module says is said through Mirage.Shared.Extensibility, and needing more
       than this would mean the seam is not wide enough. A module that grows a second reference has
       found a gap worth reporting rather than working around. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\shared\src\Mirage.Shared\Mirage.Shared.csproj" />
  </ItemGroup>

  <!-- The records this module ships, listed so the IDE shows them beside the code that reads them.
       Not copied anywhere by the build — see modules/README.md for how they reach a world. -->
  <ItemGroup>
    <None Include="..\..\world\**\*.json" />
  </ItemGroup>

</Project>
