# The spellbook: what a character knows, what they have ready, and what happens when they cast it.
#
# behavior/spells.cm is arithmetic and declarations/magic.cm is a shape; both land on somebody
# here. The split is the same one combat.cm and fight.cm make, and for the same reason.

shared model Book

    # Twenty, as the original had. A spellbook looks like a book of empty slots, so they are all
    # declared and all shown.
    public integer Slots = 20;

    public string Ready = "prepared";
    public string ReadyName = "preparedname";

    public string Cast = "msr.cast";
    public string OpenVerb = "msr.spell.open";
    public string PrepareVerb = "msr.spell.prepare";
    public string ForgetVerb = "msr.spell.forget";
    public string CastSelf = "msr.cast.self";

    # ── What the engine carries ───────────────────────────────────────────────

    public function Declare(Builder game)
        game.Attribute(Book.Ready, "owner");
        game.Attribute(Book.ReadyName, "owner");

        loop for slot = 1 to Book.Slots
            game.Attribute(Book.At(slot), "owner");
            game.Attribute(Book.NameAt(slot), "owner");
        end loop

        # Q, as the original cast with. E is the melee key and R reaches, so the three keys a hand
        # rests on are the three things a character does.
        #
        # ONE verb, and the engine aims it. Q throws it at whatever is targeted, and Ctrl+Tab targets
        # YOURSELF - which is how the original aimed a heal inward and the only way it offered. A
        # second verb for it would be a button reading "Cast on yourself" sitting on the screen at all
        # times, and the original has no such thing anywhere.
        Verb outward = game.Action(Book.Cast, "Cast", "Magic");
        outward.OnNpc();
        outward.OnPlayer();
        outward.Aimed();
        outward.Icon("spark");
        outward.Key("Q");
        outward.Hotkeyable();

        # Acts on the spell picked out of the book. Preparing by TYPING a slot number was asking the
        # player to read one off the screen above and type it back in.
        Verb ready = game.Action(Book.PrepareVerb, "Prepare", "Magic");
        ready.Nowhere();
        ready.Icon("spark");

        Verb forget = game.Action(Book.ForgetVerb, "Forget", "Magic");
        forget.Nowhere();
        forget.Icon("clock");

        Verb open = game.Action(Book.OpenVerb, "Spells", "Magic");
        open.OnHud();
        open.Icon("book");
        open.Opens("msr.book");

        # P, which is the key the original opened its book with.
        Panel book = game.Panel("msr.book", "Spellbook", 280, 300);
        book.Smallest(200, 120);
        book.Key("P");
        book.Icon("book");

        # Right-click a page to put it on the action bar. The slot then casts that spell, which is
        # what the row does when it is picked and Q is pressed.
        book.Hotkeys(Book.Cast);
        book.Heading("Prepared");
        book.Field(Book.ReadyName, "Ready", 200, 200, 160);
        book.Heading("Known");

        loop for slot = 1 to Book.Slots
            book.Row(Book.NameAt(slot), "" + slot);
        end loop

        book.Button("Prepare", Book.PrepareVerb);
        book.Button("Forget", Book.ForgetVerb);
    end function

    # The keys a slot's two halves live under. Written here so the shape of them is stated once.
    public string function At(integer slot)
        yield "book" + slot;
    end function

    public string function NameAt(integer slot)
        yield "bookname" + slot;
    end function

    # ── Learning ──────────────────────────────────────────────────────────────

    # A scroll and only a scroll, as the original taught everything. Somebody uses one out of their
    # bag and the spell written on it goes into the book; the scroll is spent only if it was read.
    #
    # ⚠ Raised for every use, the engine's own two included — so a scroll that is also a piece of gear
    # would be worn AND read. Nothing sensible is both, and a world that authored one meant it.
    public function Read(Player who, integer item)
        integer written = Book.WrittenOn(item);

        if written < 1
            yield;
        end if

        if Book.Learn(who, written)
            who.Take(item, 1);
        end if
    end function

    # Read off the item, from a field this game added to the engine's own Items. A scroll carries one
    # spell, so it is one value about one record; scanning every spell for the one that named this
    # scroll would be the same fact stored backwards.
    public integer function WrittenOn(integer item)
        if item < 1
            yield 0;
        end if

        yield World.RecordNumber(Gear.Of, item, "teaches");
    end function

    # ⚠ The refusals are in the order they are worth reporting, which is the original's own order.
    # Known before full: a full book that already holds this spell needs no slot, so "your book is
    # full" would name the wrong reason.
    public boolean function Learn(Player who, integer number)
        string name = Spells.NameOf(number);

        if name == ""
            who.Message("There is no such spell.");
            yield false;
        end if

        integer myClass = who.Number(Classes.Key);

        if not Spells.OpenTo(number, myClass)
            who.Message("Your kind does not learn " + name + ".");
            yield false;
        end if

        integer level = Stats.LevelOf(who);
        integer needLevel = World.RecordNumber(Spells.Of, number, "levelReq");

        if level < needLevel
            who.Message("You must be level " + needLevel + " to learn " + name + ".");
            yield false;
        end if

        integer needInt = Spells.IntNeeded(number, Classes.StatOf(who, Stats.Int));

        if who.Number(Stats.Int) < needInt
            who.Message("You need " + needInt + " intelligence to learn " + name + ".");
            yield false;
        end if

        if Book.Holds(who, number)
            who.Message("You already know " + name + ".");
            yield false;
        end if

        integer free = Book.FreeSlot(who);

        if free < 1
            who.Message("Your book has no room for " + name + ".");
            yield false;
        end if

        Book.Write(who, free, number);
        who.Message("You learn " + name + ".");

        # Anybody learning their first spell wants it ready.
        if who.Number(Book.Ready) < 1
            Book.Prepare(who, free);
        end if

        yield true;
    end function

    # What a class already knows the day it enlists. Called from Classes.Take, so the opening book is
    # part of enlisting rather than a second errand.
    public function Grant(Player who, integer forClass)
        integer rows = World.Records(Spells.Known);
        integer taught = 0;

        loop for row = 1 to rows
            if World.RecordNumber(Spells.Known, row, "forClass") == forClass
                integer number = World.RecordNumber(Spells.Known, row, "spell");

                if number > 0
                    if Book.Learn(who, number)
                        taught = taught + 1;
                    end if
                end if
            end if
        end loop

        # ⚠ Counted rather than reported one at a time, and a spell that would not go in is passed
        # over in silence: an opening book is a gift rather than a list of refusals.
        if taught > 0
            who.Message("You begin knowing " + taught + " spells.");
        end if
    end function

    # ── The book itself ───────────────────────────────────────────────────────

    function Write(Player who, integer slot, integer number)
        who.SetNumber(Book.At(slot), number);
        who.SetText(Book.NameAt(slot), Spells.NameOf(number));
    end function

    public boolean function Holds(Player who, integer number)
        loop for slot = 1 to Book.Slots
            if who.Number(Book.At(slot)) == number
                yield true;
            end if
        end loop

        yield false;
    end function

    public integer function FreeSlot(Player who)
        loop for slot = 1 to Book.Slots
            if who.Number(Book.At(slot)) < 1
                yield slot;
            end if
        end loop

        yield 0;
    end function

    # A picked line carries the page it is on.
    public integer function Numbered(string picked)
        loop for slot = 1 to Book.Slots
            if picked == "" + slot
                yield slot;
            end if
        end loop

        yield 0;
    end function

    # Unlearning one, which frees the page for something else.
    #
    # ⚠ Refused in a FIGHT, as the original refused it: emptying a page is study, and a body
    # swapping its book mid-swing is a body doing something study is not. Preparing is allowed there,
    # because choosing which of the spells you already know to throw next is part of the fight.
    public function Forget(Player who, integer slot)
        if who.IsDowned
            yield;
        end if

        if slot < 1 or slot > Book.Slots
            who.Message("There is no such page.");
            yield;
        end if

        integer number = who.Number(Book.At(slot));

        if number < 1
            who.Message("That page is empty.");
            yield;
        end if

        if who.IsEngaged
            who.Message("You cannot study in the middle of a fight.");
            yield;
        end if

        who.SetNumber(Book.At(slot), 0);
        who.SetText(Book.NameAt(slot), "");

        # A page torn out from under the prepared spell would leave the ready slot pointing at nothing,
        # and the panel saying a spell is ready that the book no longer holds.
        if who.Number(Book.Ready) == number
            who.SetNumber(Book.Ready, 0);
            who.SetText(Book.ReadyName, "");
        end if

        who.Message("You forget " + Spells.NameOf(number) + ".");
    end function

    public function Prepare(Player who, integer slot)
        if slot < 1 or slot > Book.Slots
            who.Message("There is no such page.");
            yield;
        end if

        integer number = who.Number(Book.At(slot));

        if number < 1
            who.Message("That page is empty.");
            yield;
        end if

        who.SetNumber(Book.Ready, number);
        who.SetText(Book.ReadyName, Spells.NameOf(number));
        who.Message(Spells.NameOf(number) + " is ready.");
    end function

    # ── Casting ───────────────────────────────────────────────────────────────

    # Everything true of a cast before anyone is picked to receive it. Yields the mana it will cost,
    # or zero for a cast that is refused — and a refusal has already said why.
    #
    # ⚠ A REFUSAL PAYS NOTHING. Nothing was attempted, so nothing is spent and no cooldown starts.
    # That is only true of refusals: a cast that finds no target is a whiff and pays the full wait,
    # the same way a swing into air does.
    integer function Afford(Player who, integer number)
        if number < 1
            who.Message("You have no spell prepared.");
            yield 0;
        end if

        string name = Spells.NameOf(number);
        integer level = Stats.LevelOf(who);
        integer needLevel = World.RecordNumber(Spells.Of, number, "levelReq");

        if level < needLevel
            who.Message("You must be level " + needLevel + " to cast " + name + ".");
            yield 0;
        end if

        integer needInt = Spells.IntNeeded(number, Classes.StatOf(who, Stats.Int));

        if who.Number(Stats.Int) < needInt
            who.Message("You need " + needInt + " intelligence to cast " + name + ".");
            yield 0;
        end if

        integer cost = Spells.Cost(number, who.Number(Stats.Int), who.Number(Vitals.MaxMana));

        if who.Number(Vitals.Mana) < cost
            who.Message("You do not have the mana for " + name + ".");
            yield 0;
        end if

        yield cost;
    end function

    # The tier a caster is priced at when something has to put a number on them: the spell they had
    # prepared, whatever it does, and failing that the strongest damage spell in the book. Somebody who
    # has learned none is not a caster and is priced at nothing.
    public integer function CasterTier(Player who)
        integer ready = who.Number(Book.Ready);

        if ready > 0
            yield World.RecordNumber(Spells.Of, ready, "levelReq");
        end if

        integer best = 0;

        loop for slot = 1 to Book.Slots
            integer known = who.Number(Book.At(slot));

            if known > 0
                if Spells.TypeOf(known) == Spells.Costly
                    integer tier = World.RecordNumber(Spells.Of, known, "levelReq");

                    if tier > best
                        best = tier;
                    end if
                end if
            end if
        end loop

        yield best;
    end function

    # ── The pouch ─────────────────────────────────────────────────────────────
    #
    # A damaging cast burns a reagent, the caster's equivalent of a repair bill. The arithmetic
    # is spells.cm; here it meets a bag.
    #
    # ⚠ Asked for BEFORE the cast and taken AFTER it, like mana. A cast is gated by what it CAN
    # take, not by what this one rolled: a roll of nothing must not let an empty pouch cast, any more than a
    # weapon at no durability can swing.

    # What this cast is billed, before anything is rolled. Zero for a spell that is not damage, and
    # zero where the bill is waived.
    real function ReagentBill(Player who, integer number, boolean waived)
        if waived
            yield 0.0;
        end if

        if Spells.TypeOf(number) != Spells.Costly
            yield 0.0;
        end if

        yield Spells.ReagentCost(World.RecordNumber(Spells.Of, number, "levelReq"), who.Map);
    end function

    # ⚠ A world that ticked the box on nothing has casters who fight for free. Refusing every cast is
    # the alternative, and a world is not broken for leaving a field blank.
    boolean function HasReagents(Player who, real exact)
        integer many = Spells.PerCast(exact);

        if many < 1
            yield true;
        end if

        integer reagent = Gear.Reagent();

        if reagent < 1
            yield true;
        end if

        if who.Carrying(reagent) >= many
            yield true;
        end if

        who.Message("You have no " + World.RecordName(Gear.Of, reagent) + " left to cast with.");
        yield false;
    end function

    # And what it took. A guild at level two sometimes shrugs the cost off — the same privilege that
    # sometimes spares a weapon a chip.
    function Burn(Player who, real exact)
        integer many = Spells.RollReagents(exact);

        if many < 1
            yield;
        end if

        if Perks.Shrugs(who)
            yield;
        end if

        who.Take(Gear.Reagent(), many);
    end function

    function Spend(Player who, integer cost, real exact)
        who.SetNumber(Vitals.Mana, who.Number(Vitals.Mana) - cost);

        Book.Burn(who, exact);

        who.Wait(Combat.Beat(Fight.SwingSeconds, who.Map));
        who.Engage(Fight.EngagedSeconds);
        Death.BreakGraceInFight(who);
    end function

    # A spell aimed at whatever is standing there.
    public function Hurl(Player who, integer map, integer x, integer y)
        if who.IsWaiting
            yield;
        end if

        # A person is answered before a creature, the same order a swing takes. Which of the two it is
        # changes every rule that follows — the gates, the share of damage that lands, whether the
        # reagent is waived — so the cast at a person is its own path and this one is about creatures
        # from here down.
        Player? body = World.PlayerAt(map, x, y);

        if body.HasValue()
            Book.Fling(who, body.Value(), map, x, y);
            yield;
        end if

        integer number = who.Number(Book.Ready);
        integer cost = Book.Afford(who, number);

        if cost < 1
            yield;
        end if

        # Casting at a creature always pays the pouch. An arena changes what players may do to each
        # other and has never changed anything about a creature.
        real exact = Book.ReagentBill(who, number, false);

        if not Book.HasReagents(who, exact)
            yield;
        end if

        Npc? target = World.NpcAt(map, x, y);

        if not target.HasValue()
            who.Message("There is nothing there to cast at.");
            yield;
        end if

        # ⚠ What the SPELL is comes before where anybody is standing. A heal aimed at a beast is the
        # wrong spell whether or not it would have reached, and being told the range when the aim was
        # the mistake sends somebody walking closer to try it again.
        string type = Spells.TypeOf(number);

        if Spells.Restores(type)
            who.Message("That would be a kindness wasted.");
            yield;
        end if

        if type == "GiveItem"
            who.Message("There is nobody there to hand anything to.");
            yield;
        end if

        # The engine's own reach, counted across map borders. The world scrolls contiguously, so a
        # body one tile over a seam is one tile away; arithmetic on the coordinates would call it
        # another map and refuse a cast the player can see landing.
        integer gap = World.Distance(who.Map, who.X, who.Y, map, x, y);

        if gap < 0 or gap > Spells.Range
            who.Message("That is too far away.");
            yield;
        end if

        # And the engine's own trace, which is the one the client colored the target arrow with — so a
        # refusal here agrees with what the player was shown rather than nearly agreeing.
        if not World.CanSee(who.Map, who.X, who.Y, map, x, y)
            who.Message("You cannot see a clear line to that.");
            yield;
        end if

        Book.Spend(who, cost, exact);
        target.Engage(Fight.EngagedSeconds);

        # ⚠ Rolled AFTER the cast is paid for. A cast the sky took off course still happened: the mana
        # went, the reagent went, and the beat went. Rolling it before the spend would make a gale a
        # discount rather than a hazard.
        if Combat.WindTakesIt(who.Map)
            who.Message("The wind tears your spell apart.");
            yield;
        end if

        who.ThrowAtNpc(target, "bolt", 120, 160, 255);

        integer int = who.Number(Stats.Int);
        integer level = Stats.LevelOf(who);
        integer amount = World.RecordNumber(Spells.Of, number, "amount");
        integer raw = Combat.Vary(Spells.Power(int, amount));
        boolean crit = false;

        if Combat.CanFocus(who)
            crit = Combat.Rolls(Combat.PlayerChance(int, level,
                                                    Combat.PlayerCritDivisor, Combat.PlayerCritCap));

            if crit
                raw = Combat.Crit(raw);
            end if
        end if

        integer defence = target.Number(Stats.Def);
        integer taken = Combat.Resolve(raw, Combat.Protection(defence, defence), Combat.PveDamageFloor);

        # ⚠ Only health is mitigated. Draining mana or stamina goes through whatever a body's armor
        # is, because armor is not what holds those.
        if type != "SubHp"
            taken = raw;
        end if

        Book.Drain(who, target, type, taken, crit, map, x, y);
    end function

    # What a drain does to the creature it landed on.
    function Drain(Player who, Npc target, string type, integer taken, boolean crit,
                   integer map, integer x, integer y)
        string vital = Spells.Vital(type);

        if type != "SubHp"
            integer left = target.Number(vital) - taken;

            if left < 0
                left = 0;
            end if

            target.SetNumber(vital, left);
            target.Float("" + taken, 140, 120, 220);
            yield;
        end if

        Fight.Wound(target, taken, crit);
        Loot.Credit(target, who, taken);

        integer health = target.Number(Vitals.Health) - taken;

        if health > 0
            target.SetNumber(Vitals.Health, health);

            # A spell is a hit, so it answers like one. Without this an ambling creature never
            # fights back against a caster.
            Beasts.Answer(target, who);
            yield;
        end if

        Fight.Slain(who, target, map, x, y);
    end function

    # ── A spell aimed at a person ─────────────────────────────────────────────
    #
    # Two halves that share a target and nothing else.
    #
    # Anything RESTORING reaches whoever is standing there, with no gate but the range and the line. A
    # heal is not an attack, and putting it through the duelling rules would stop somebody patching up
    # a guildmate on a protected tile — which is the one place they are most likely to be doing it.
    #
    # Anything HARMING goes through the whole of duel.cm first and then answers the way a swing does:
    # the same block, the same sidestep, the same three quarters of what lands.

    function Fling(Player who, Player them, integer map, integer x, integer y)
        integer number = who.Number(Book.Ready);
        integer cost = Book.Afford(who, number);

        if cost < 1
            yield;
        end if

        string type = Spells.TypeOf(number);
        boolean harms = Spells.Harms(type);

        if harms
            string refused = Duel.Judge(who, them);

            if refused != ""
                who.Message(refused);
                yield;
            end if
        end if

        # ⚠ Nothing is cast at a body that is already down, restoring included. A heal on a corpse is
        # the caster paying for nothing, and the engine puts them back full anyway.
        if them.Number(Vitals.Health) < 1
            who.Message("There is nothing left there to cast at.");
            yield;
        end if

        integer gap = World.Distance(who.Map, who.X, who.Y, map, x, y);

        if gap < 0 or gap > Spells.Range
            who.Message("That is too far away.");
            yield;
        end if

        if not World.CanSee(who.Map, who.X, who.Y, map, x, y)
            who.Message("You cannot see a clear line to that.");
            yield;
        end if

        # ⚠ The pouch is waived on an arena, and only between people. It is the same waiver a death
        # gets there, for the same reason: nothing a bout costs is meant to be felt afterwards. A cast
        # at a CREATURE standing on an arena still pays — an arena changes what players may do to each
        # other and has never changed anything about the rest of the world.
        real exact = Book.ReagentBill(who, number, Places.EitherArena(who, them));

        if not Book.HasReagents(who, exact)
            yield;
        end if

        if harms
            Death.StartedIt(who);
            them.Engage(Fight.EngagedSeconds);
        end if

        Book.Spend(who, cost, exact);

        if Combat.WindTakesIt(who.Map)
            who.Message("The wind tears your spell apart.");
            them.Message(who.Name + "'s spell comes apart in the wind.");
            yield;
        end if

        who.ThrowAtPlayer(them, "bolt", 120, 160, 255);

        if type == "GiveItem"
            Book.HandOver(who, them, number);
            yield;
        end if

        if harms
            Book.Sap(who, them, type, number);
            yield;
        end if

        Book.Mend(who, them, type, number);
    end function

    # Handing something over at range. What the spell was authored to conjure, into their bag.
    function HandOver(Player who, Player them, integer number)
        integer item = World.RecordNumber(Spells.Of, number, "item");
        integer many = World.RecordNumber(Spells.Of, number, "many");

        if item < 1 or many < 1
            yield;
        end if

        them.Give(item, many);
        them.Float("+" + many, 120, 220, 140);

        who.Message("You hand " + them.Name + " what they needed.");
        them.Message(who.Name + " conjures something into your hands.");
    end function

    # Putting something back into somebody else. The same magnitude a self-cast restores.
    function Mend(Player who, Player them, string type, integer number)
        integer amount = World.RecordNumber(Spells.Of, number, "amount");
        integer back = Combat.Vary(Spells.Power(who.Number(Stats.Int), amount));

        Vitals.Give(them, Spells.Vital(type), Spells.Ceiling(type), back);

        them.Float("+" + back, 120, 220, 140);
        them.Burst(120, 200, 255, 60);

        who.Message("You mend " + them.Name + " for " + back + ".");
        them.Message(who.Name + " mends you for " + back + ".");
    end function

    # And taking something out of them. The reactions are melee's exactly: a shield turns a spell
    # aside and wears for it, and a free hand steps out of one. Neither is a roll a caster can beat by
    # casting harder, so a defensive kit stays worth wearing against a caster.
    function Sap(Player who, Player them, string type, integer number)
        integer theirLevel = Stats.LevelOf(them);
        integer theirDef = them.Number(Stats.Def);

        if Combat.CanDodge(them)
            if Combat.Rolls(Combat.PlayerChance(theirDef, theirLevel, Combat.PlayerDodgeDivisor, Combat.PlayerDodgeCap))
                Combat.Spend(them, Combat.DodgeCostShare);
                who.Message(them.Name + " steps out of it.");
                them.Message("You step out of " + who.Name + "'s spell.");
                yield;
            end if
        end if

        if Combat.CanBlock(them)
            if Combat.Rolls(Combat.PlayerChance(theirDef, theirLevel, Combat.PlayerBlockDivisor, Combat.PlayerBlockCap))
                Combat.Spend(them, Combat.BlockCostShare);
                Gear.Chip(them, Sheet.Shield);
                who.Message(them.Name + " turns it aside.");
                them.Message("Your shield turns aside " + who.Name + "'s spell.");
                yield;
            end if
        end if

        integer int = who.Number(Stats.Int);
        integer amount = World.RecordNumber(Spells.Of, number, "amount");
        integer raw = Combat.Vary(Spells.Power(int, amount));
        boolean crit = false;

        if Combat.CanFocus(who)
            crit = Combat.Rolls(Combat.PlayerChance(int, Stats.LevelOf(who),
                                                    Combat.PlayerCritDivisor, Combat.PlayerCritCap));

            if crit
                raw = Combat.Crit(raw);
            end if
        end if

        # ⚠ Only health is mitigated, and only health is shared down. Armor is not what holds mana or
        # breath, so draining either goes through whatever somebody is wearing — which is the same rule
        # a cast at a creature runs.
        if type != "SubHp"
            Book.Drown(who, them, type, raw);
            yield;
        end if

        integer full = Combat.Resolve(raw, Combat.Protection(theirLevel, theirDef), Combat.MinDamageFloor);
        integer damage = Math.Round(full * Duel.DamageShare);

        if damage < 1
            who.Message("Your spell does nothing to " + them.Name + ".");
            them.Message(who.Name + "'s spell cannot get through your guard.");
            yield;
        end if

        Duel.Land(who, them, damage, crit);
    end function

    # A drain: straight out of the pool it names, never past nothing.
    function Drown(Player who, Player them, string type, integer taken)
        string vital = Spells.Vital(type);
        integer left = them.Number(vital) - taken;

        if left < 0
            left = 0;
        end if

        them.SetNumber(vital, left);
        them.Float("" + taken, 140, 120, 220);

        who.Message("You draw " + taken + " out of " + them.Name + ".");
        them.Message(who.Name + " draws " + taken + " out of you.");
    end function

    # A spell aimed at the caster. Restoring, or a thing handed over.
    public function Inward(Player who)
        if who.IsWaiting
            yield;
        end if

        integer number = who.Number(Book.Ready);
        integer cost = Book.Afford(who, number);

        if cost < 1
            yield;
        end if

        string type = Spells.TypeOf(number);

        if Spells.Harms(type)
            who.Message("You would regret that.");
            yield;
        end if

        # Nothing restoring costs a reagent, so the bill is nothing; it is asked for anyway rather than
        # written as a zero, because what is and is not billed is spells.cm's answer and not this
        # function's.
        Book.Spend(who, cost, Book.ReagentBill(who, number, false));
        who.Burst(120, 200, 255, 60);

        if type == "GiveItem"
            integer item = World.RecordNumber(Spells.Of, number, "item");
            integer many = World.RecordNumber(Spells.Of, number, "many");

            if item > 0 and many > 0
                who.Give(item, many);
                who.Message("You conjure what you asked for.");
            end if

            yield;
        end if

        integer amount = World.RecordNumber(Spells.Of, number, "amount");
        integer back = Combat.Vary(Spells.Power(who.Number(Stats.Int), amount));

        # ⚠ Spent before the restore, so a mana spell cannot pay for itself. Restoring into the pool
        # the cost came out of is the one case where the order of two writes decides whether the game
        # has an economy.
        Vitals.Give(who, Spells.Vital(type), Spells.Ceiling(type), back);
        who.Float("+" + back, 120, 220, 140);
    end function

end model
