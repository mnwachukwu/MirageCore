# Guild quests: a standing bounty on one kind of creature, worked by the whole roster.
#
# This is what actually levels a guild. The kill trickle is one point a body; a bounty pays tens of
# thousands, and it is the only thing on the ballooning curve that moves it at all.
#
# A leader takes one out, pays for it out of their own pocket, and the guild has a day to fill it.
# Three a day at most, and abandoning one does not give the slot back, so a leader cannot re-roll
# cheaply for an easy target.

shared model Bounty

    public string TakeVerb = "msr.guild.bounty";
    public string DropVerb = "msr.guild.abandon";

    # ── The numbers, all from the original ────────────────────────────────────

    public integer MaxPerDay = 3;
    public integer CostPerLevel = 17500;
    public integer DurationHours = 24;

    # A bounty on an ordinary creature is hundreds of kills, scaling with how hard it is.
    public integer BaseKills = 300;
    public integer KillsPerDifficulty = 1;
    public integer MaxKills = 1000;

    # A bounty on a boss is tens, on a much shallower slope.
    public integer BossBaseKills = 30;
    public integer BossKillsPerHundred = 10;
    public integer BossMaxKills = 100;

    # The roll that sizes a bounty moves the count and the reward together, so asking for more always
    # pays more.
    public integer VariationPercent = 25;

    public integer BaseExp = 33000;
    public integer ExpPerDifficulty = 300;
    public integer BaseGold = 8750;
    public integer GoldPerDifficulty = 175;

    # A boss asks for far fewer kills, so it pays half.
    public integer BossRewardPercent = 50;

    # A guild that cannot level has no use for experience, so a maxed one is paid in gold instead.
    public integer MaxLevelGoldBonusPercent = 25;

    # ── Where a bounty is written ─────────────────────────────────────────────

    public string Target = "gqtarget";
    public string Needed = "gqneed";
    public string Slain = "gqhave";
    public string Expires = "gqends";
    public string ExpReward = "gqexp";
    public string GoldReward = "gqgold";

    # Three a day, counted against the day they were taken on.
    public string TakenToday = "gqtoday";
    public string CountedOn = "gqday";

    # ── Declaring ─────────────────────────────────────────────────────────────

    public function Declare(Builder game)
        # Taken FROM somebody, the way the original's were: a board, a keeper, whoever a world puts
        # them behind. On the sidebar it would be a button on every screen, most of them nowhere near
        # anyone offering work.
        Verb take = game.Action(Bounty.TakeVerb, "Take a bounty", "Guild");
        take.OnNpc();
        take.Icon("scroll");

        Verb drop = game.Action(Bounty.DropVerb, "Abandon the bounty", "Guild");
        drop.OnNpc();
        drop.Icon("clock");
    end function

    # ── The arithmetic ────────────────────────────────────────────────────────

    # What a leader pays to take one out. Level zero is free, which is the one thing a guild that has
    # earned nothing can still do.
    public integer function Cost(integer level)
        if level < 1
            yield 0;
        end if

        yield level * Bounty.CostPerLevel;
    end function

    # How hard a creature is: the three stats a fight actually spends.
    public integer function Difficulty(integer beast)
        yield World.RecordNumber("NPCs", beast, Stats.Str)
              + World.RecordNumber("NPCs", beast, Stats.Def)
              + World.RecordNumber("NPCs", beast, Stats.Int);
    end function

    public boolean function IsBoss(integer beast)
        yield World.RecordTruth("NPCs", beast, "boss");
    end function

    # A roll of nought to a hundred becomes a factor between three quarters and five quarters. Fifty
    # is the flat baseline.
    public real function Variation(integer roll)
        real spread = Bounty.VariationPercent / 100.0;

        yield 1.0 - spread + roll / 100.0 * 2.0 * spread;
    end function

    public integer function KillsFor(integer difficulty, integer roll, boolean boss)
        real baseline = Bounty.BaseKills + difficulty * Bounty.KillsPerDifficulty;
        integer most = Bounty.MaxKills;

        if boss
            baseline = Bounty.BossBaseKills + difficulty * Bounty.BossKillsPerHundred / 100.0;
            most = Bounty.BossMaxKills;
        end if

        integer kills = Math.Round(baseline * Bounty.Variation(roll));

        if kills < 1
            yield 1;
        end if

        if kills > most
            yield most;
        end if

        yield kills;
    end function

    public integer function ExpFor(integer difficulty, integer level, integer roll, boolean boss)
        # A guild at the top cannot level, so experience is worth nothing to it and it is paid none.
        if level >= Guilds.MaxLevel
            yield 0;
        end if

        real reward = (Bounty.BaseExp * (level + 1) + difficulty * Bounty.ExpPerDifficulty)
                      * Bounty.Variation(roll);

        if boss
            reward = reward * Bounty.BossRewardPercent / 100.0;
        end if

        yield Math.Round(reward);
    end function

    public integer function GoldFor(integer difficulty, integer level, integer roll, boolean boss)
        real reward = (Bounty.BaseGold * (level + 1) + difficulty * Bounty.GoldPerDifficulty)
                      * Bounty.Variation(roll);

        if boss
            reward = reward * Bounty.BossRewardPercent / 100.0;
        end if

        if level >= Guilds.MaxLevel
            reward = reward * (100 + Bounty.MaxLevelGoldBonusPercent) / 100.0;
        end if

        integer paid = Math.Round(reward);
        integer floor = Bounty.Cost(level) + Bounty.BaseGold;

        # Filling a bounty always leaves the vault better off than taking it out did.
        if paid < floor
            yield floor;
        end if

        yield paid;
    end function

    # ── Choosing a target ─────────────────────────────────────────────────────
    #
    # Weighted toward the guild's level: a higher guild trends toward harder creatures without ever
    # being held to them. The weight peaks at the target difficulty and falls off either side, so the
    # draw is a preference rather than a band.

    public integer function Pick(integer level, integer roll)
        integer least = -1;
        integer most = -1;

        loop for beast = 1 to World.Records("NPCs")
            if World.RecordTruth("NPCs", beast, "hostile")
                integer hard = Bounty.Difficulty(beast);

                if least < 0 or hard < least
                    least = hard;
                end if

                if hard > most
                    most = hard;
                end if
            end if
        end loop

        if least < 0
            yield 0;
        end if

        real aim = least + (most - least) * (level / (Guilds.MaxLevel * 1.0));
        real total = 0.0;

        loop for beast = 1 to World.Records("NPCs")
            if World.RecordTruth("NPCs", beast, "hostile")
                total = total + Bounty.Weight(beast, aim);
            end if
        end loop

        real wanted = roll / 100.0 * total;
        real seen = 0.0;
        integer last = 0;

        loop for beast = 1 to World.Records("NPCs")
            if World.RecordTruth("NPCs", beast, "hostile")
                last = beast;
                seen = seen + Bounty.Weight(beast, aim);

                if wanted < seen
                    yield beast;
                end if
            end if
        end loop

        yield last;
    end function

    real function Weight(integer beast, real aim)
        yield 1.0 / (1.0 + Math.Abs(Bounty.Difficulty(beast) - aim));
    end function

    # ── Taking one out ────────────────────────────────────────────────────────

    public function Take(Player who)
        integer guild = World.GuildOf(who);

        if guild < 1
            who.Message("You are not in a guild.");
            yield;
        end if

        if World.GuildRank(who) != "leader"
            who.Message("Only your guild's leader may take a bounty out.");
            yield;
        end if

        if World.GuildNumber(guild, Bounty.Target) > 0
            who.Message("Your guild is already working one.");
            yield;
        end if

        integer today = Ledger.Today();

        if World.GuildNumber(guild, Bounty.CountedOn) != today
            World.SetGuildNumber(guild, Bounty.CountedOn, today);
            World.SetGuildNumber(guild, Bounty.TakenToday, 0);
        end if

        if World.GuildNumber(guild, Bounty.TakenToday) >= Bounty.MaxPerDay
            who.Message("Your guild has taken out all it may today.");
            yield;
        end if

        integer level = Guilds.LevelOf(guild);
        integer beast = Bounty.Pick(level, Combat.Roll(100));

        if beast < 1
            who.Message("There is nothing worth hunting.");
            yield;
        end if

        if not Bounty.Charge(who, level)
            yield;
        end if

        integer difficulty = Bounty.Difficulty(beast);
        boolean boss = Bounty.IsBoss(beast);
        integer roll = Combat.Roll(100);

        # ⚠ Taking one out spends a slot whether or not it is ever filled. Abandoning gives nothing back.
        World.SetGuildNumber(guild, Bounty.TakenToday, World.GuildNumber(guild, Bounty.TakenToday) + 1);

        World.SetGuildNumber(guild, Bounty.Target, beast);
        World.SetGuildNumber(guild, Bounty.Needed, Bounty.KillsFor(difficulty, roll, boss));
        World.SetGuildNumber(guild, Bounty.Slain, 0);
        World.SetGuildNumber(guild, Bounty.ExpReward, Bounty.ExpFor(difficulty, level, roll, boss));
        World.SetGuildNumber(guild, Bounty.GoldReward, Bounty.GoldFor(difficulty, level, roll, boss));
        World.SetGuildNumber(guild, Bounty.Expires, World.Now() + Bounty.DurationHours * 3600);

        World.TellThese(World.GuildMembers(guild),
                        "A bounty: " + World.GuildNumber(guild, Bounty.Needed) + " of "
                        + World.RecordName("NPCs", beast) + ".");
    end function

    # The leader pays out of their own pocket, in the world's own coin.
    boolean function Charge(Player who, integer level)
        integer cost = Bounty.Cost(level);

        if cost < 1
            yield true;
        end if

        integer coin = Gear.Coin();

        if coin < 1
            who.Message("There is no coin in this world to pay with.");
            yield false;
        end if

        if who.Carrying(coin) < cost
            who.Message("A bounty costs " + cost + " gold.");
            yield false;
        end if

        who.Take(coin, cost);

        yield true;
    end function

    public function Drop(Player who)
        integer guild = World.GuildOf(who);

        if guild < 1
            yield;
        end if

        if World.GuildRank(who) != "leader"
            who.Message("Only your guild's leader may abandon it.");
            yield;
        end if

        if World.GuildNumber(guild, Bounty.Target) < 1
            who.Message("Your guild has no bounty out.");
            yield;
        end if

        Bounty.Clear(guild);

        World.TellThese(World.GuildMembers(guild), "The bounty has been abandoned.");
    end function

    function Clear(integer guild)
        World.SetGuildNumber(guild, Bounty.Target, 0);
        World.SetGuildNumber(guild, Bounty.Needed, 0);
        World.SetGuildNumber(guild, Bounty.Slain, 0);
        World.SetGuildNumber(guild, Bounty.Expires, 0);
        World.SetGuildNumber(guild, Bounty.ExpReward, 0);
        World.SetGuildNumber(guild, Bounty.GoldReward, 0);
    end function

    # ── Working it ────────────────────────────────────────────────────────────

    # Every member's kill counts, wherever they are. Called from the one place a player kills a
    # creature, so a swing and a spell both count.
    public function Killed(Player who, integer kind)
        integer guild = World.GuildOf(who);

        if guild < 1 or kind < 1
            yield;
        end if

        if World.GuildNumber(guild, Bounty.Target) != kind
            yield;
        end if

        integer have = World.GuildNumber(guild, Bounty.Slain) + 1;
        integer need = World.GuildNumber(guild, Bounty.Needed);

        World.SetGuildNumber(guild, Bounty.Slain, have);
        World.TellThese(World.GuildMembers(guild),
                        World.RecordName("NPCs", kind) + " - " + have + " of " + need + ".");

        if have < need
            yield;
        end if

        Bounty.Fill(guild);
    end function

    function Fill(integer guild)
        integer exp = World.GuildNumber(guild, Bounty.ExpReward);
        integer gold = World.GuildNumber(guild, Bounty.GoldReward);

        Bounty.Clear(guild);

        World.GiveGuildGold(guild, gold);
        World.SetGuildNumber(guild, Ledger.WeeklyIncome,
                             World.GuildNumber(guild, Ledger.WeeklyIncome) + gold);

        World.TellThese(World.GuildMembers(guild),
                        "The bounty is filled: " + exp + " experience and " + gold + " gold.");

        Guilds.Credit(guild, exp);
    end function

    # A bounty nobody filled inside its day lapses, and pays nothing.
    public function Tick(Player who)
        integer guild = World.GuildOf(who);

        if guild < 1 or World.GuildNumber(guild, Bounty.Target) < 1
            yield;
        end if

        if World.GuildNumber(guild, Bounty.Expires) > World.Now()
            yield;
        end if

        Bounty.Clear(guild);

        World.TellThese(World.GuildMembers(guild), "The bounty has run out.");
    end function

end model
