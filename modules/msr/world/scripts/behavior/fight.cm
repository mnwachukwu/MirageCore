# What happens when two bodies meet: a swing, what it does, and what is left of whoever took it.
#
# combat.cm is arithmetic and knows nothing about a world. This is where it lands on somebody: the
# rolls, the messages, the picture, the death. One is a formula and the other is a fight.

shared model Fight

    public string Attack = "msr.attack";

    # How long a swing marks somebody as being in one. Regen reads this, so running away is a
    # decision rather than a formality.
    public integer EngagedSeconds = 10;

    # And how long before they may swing again.
    public integer SwingSeconds = 1;

    # ── Declaring ─────────────────────────────────────────────────────────────

    public string Reach = "msr.interact";

    public function Declare(Builder game)
        # ⚠ A KEY and nothing else. The original never put swinging on a menu: right-clicking a
        # body offered talking to it, trading with it and inviting it, and hitting it was the key under
        # your finger. An entry for it turns every creature in the world into a two-click fight.
        Verb hit = game.Action(Fight.Attack, "Attack", "Combat");
        hit.Nowhere();
        hit.Icon("sword");

        # ⚠ E, which is the key the ENGINE reaches for whatever you are facing with. Binding it takes
        # that over, deliberately: in the original this was the melee key, and Q was the spell key.
        # Declaring it is how a game says the reach belongs to its own rule now.
        hit.Key("E");
        hit.Hotkeyable();

        # The reaching has to go somewhere, or taking E costs the world its shops and its
        # conversations. This verb does what E used to, on R - a KEY and no menu entry, because
        # the menu already offers talking to a body and shopping with one. A third line saying
        # the same thing is what a right-click on a shopkeeper does not need.
        Verb reach = game.Action(Fight.Reach, "Interact", "Combat");
        reach.Nowhere();
        reach.Icon("bubble");
        reach.Key("R");
        reach.Interacts();
    end function

    # ── Leaving a trail ───────────────────────────────────────────────────────
    #
    # A body down to a third of what it can hold drips onto every fresh tile it crosses. The original
    # did this and it is the only way a fight that has moved is readable afterwards: the ground says
    # which way the wounded one went.
    #
    # ⚠ Weaker than the stain a KILL leaves, and deliberately - a trail that marked the ground as
    # heavily as a death would make one wounded runner look like a massacre.

    public real BleedingBelow = 0.34;
    public integer TrailSize = 1;
    public integer TrailAmount = 25;

    public function Bleed(Player who)
        integer most = who.Number(Vitals.MaxHealth);

        if most < 1
            yield;
        end if

        if who.Number(Vitals.Health) > most * Fight.BleedingBelow
            yield;
        end if

        World.Stain(who.Map, who.X, who.Y, Fight.TrailSize, Fight.TrailAmount);
    end function

    # ── A player swings at a creature ─────────────────────────────────────────

    public function Strike(Player who, integer map, integer x, integer y)
        # A person standing there is answered before a creature. Both arrive through the same verb on
        # the same key, and which of the two it is changes every rule that follows — so the swing at
        # a person goes to duel.cm and this function is about creatures from here down.
        Player? body = World.PlayerAt(map, x, y);

        if body.HasValue()
            Duel.Strike(who, body.Value());
            yield;
        end if

        Npc? target = World.NpcAt(map, x, y);

        if not target.HasValue()
            who.Message("There is nothing there to fight.", "combat");
            yield;
        end if

        # ⚠ The cooldown is the engine's own. It stops a client that sends the verb as fast as it can
        # from swinging that fast.
        if who.IsWaiting
            yield;
        end if

        who.Wait(Combat.Beat(Fight.SwingSeconds, who.Map));
        who.Engage(Fight.EngagedSeconds);
        target.Engage(Fight.EngagedSeconds);
        Death.BreakGraceInFight(who);

        # The wind takes it before anything else is rolled.
        if Combat.WindTakesIt(who.Map)
            who.Sweep(false);
            who.Message("The wind takes your swing.", "combat");
            yield;
        end if

        integer level = Stats.LevelOf(who);
        integer defence = target.Number(Stats.Def);

        # A creature that turns the swing aside, or steps out of it.
        if Combat.Rolls(Combat.NpcChance(defence, Combat.NpcDodgeDivisor, Combat.NpcDodgeCap))
            who.Sweep(false);
            who.Message(target.Name + " steps aside.", "combat");
            yield;
        end if

        if Combat.Rolls(Combat.NpcChance(defence, Combat.NpcBlockDivisor, Combat.NpcBlockCap))
            who.Sweep(false);
            who.Message(target.Name + " turns it aside.", "combat");
            yield;
        end if

        integer raw = Combat.Vary(Combat.Swing(who.Number(Stats.Str)));
        boolean crit = false;

        # A critical needs a weapon in hand and the breath to put behind it.
        if Combat.CanCrit(who)
            crit = Combat.Rolls(Combat.PlayerChance(who.Number(Stats.Str), level,
                                                    Combat.PlayerCritDivisor, Combat.PlayerCritCap));

            if crit
                Combat.Spend(who, Combat.CritCostShare);
                raw = Combat.Crit(raw);
            end if
        end if

        # A creature has no level of its own, so its own defence stands in for one.
        integer damage = Combat.Resolve(raw, Combat.Protection(defence, defence), Combat.PveDamageFloor);

        who.Sweep(true);
        Gear.Chip(who, Sheet.Weapon);
        Fight.Wound(target, damage, crit);
        Loot.Credit(target, who, damage);

        integer left = target.Number(Vitals.Health) - damage;

        if left > 0
            target.SetNumber(Vitals.Health, left);

            # A creature that never notices anybody still fights back. Without this a body authored
            # to amble is a punching bag, and that is half the original's bestiary.
            Beasts.Answer(target, who);
            yield;
        end if

        Fight.Slain(who, target, map, x, y);
    end function

    # ── One creature swings at another ────────────────────────────────────────
    #
    # The engine notices this pairing on its own: a body closes on anything within its range that is
    # not its own kind and not in its group, and raises OnNpcContact when it arrives. A world with a
    # wolf and a deer in it needs nothing but this function to have them fight.
    #
    # ⚠ Neither side has a level, so each stands in for its own — the same substitution Strike makes
    # for the creature it is hitting.

    public function Clash(Npc it, Npc other)
        if it.IsWaiting
            yield;
        end if

        it.Wait(Combat.Beat(Fight.SwingSeconds, it.Map));
        it.Engage(Fight.EngagedSeconds);
        other.Engage(Fight.EngagedSeconds);

        integer defence = other.Number(Stats.Def);

        if Combat.Rolls(Combat.NpcChance(defence, Combat.NpcDodgeDivisor, Combat.NpcDodgeCap))
            it.Sweep(false);
            yield;
        end if

        if Combat.Rolls(Combat.NpcChance(defence, Combat.NpcBlockDivisor, Combat.NpcBlockCap))
            it.Sweep(false);
            yield;
        end if

        integer raw = Combat.Vary(Combat.Swing(it.Number(Stats.Str)));
        boolean crit = Combat.Rolls(Combat.NpcChance(it.Number(Stats.Str),
                                                    Combat.NpcCritDivisor, Combat.NpcBlockCap));

        if crit
            raw = Combat.Crit(raw);
        end if

        integer damage = Combat.Resolve(raw, Combat.Protection(defence, defence), Combat.PveDamageFloor);

        it.Sweep(true);
        Fight.Wound(other, damage, crit);
        Loot.CreditBeast(other, damage);

        integer left = other.Number(Vitals.Health) - damage;

        if left > 0
            other.SetNumber(Vitals.Health, left);
            Beasts.AnswerNpc(other, it);
            yield;
        end if

        Fight.Fell(it, other);
    end function

    # ── A creature swings at a player ─────────────────────────────────────────
    #
    # The same four steps, the other way round, with the player's own numbers on defence.

    public function Maul(Npc it, Player who)
        if it.IsWaiting
            yield;
        end if

        it.Wait(Combat.Beat(Fight.SwingSeconds, it.Map));
        it.Engage(Fight.EngagedSeconds);
        who.Engage(Fight.EngagedSeconds);
        Death.BreakGraceInFight(who);

        # The wind takes it before anybody reacts, so a blow it took costs the body nothing.
        if Combat.WindTakesIt(it.Map)
            it.Sweep(false);
            who.Message(it.Name + " swings wide in the wind.", "combat");
            yield;
        end if

        integer level = Stats.LevelOf(who);
        integer defence = who.Number(Stats.Def);

        if Combat.CanDodge(who)
            if Combat.Rolls(Combat.PlayerChance(defence, level, Combat.PlayerDodgeDivisor, Combat.PlayerDodgeCap))
                Combat.Spend(who, Combat.DodgeCostShare);
                who.Message("You step aside.", "combat");
                yield;
            end if
        end if

        if Combat.CanBlock(who)
            if Combat.Rolls(Combat.PlayerChance(defence, level, Combat.PlayerBlockDivisor, Combat.PlayerBlockCap))
                Combat.Spend(who, Combat.BlockCostShare);
                Gear.Chip(who, Sheet.Shield);
                who.Message("You turn it aside.", "combat");
                yield;
            end if
        end if

        integer raw = Combat.Vary(Combat.Swing(it.Number(Stats.Str)));

        if Combat.Rolls(Combat.NpcChance(it.Number(Stats.Str), Combat.NpcCritDivisor, Combat.NpcBlockCap))
            raw = Combat.Crit(raw);
        end if

        # ⚠ Three steps rather than one, in the original's order: what a body turns aside, then the
        # softer hand a creature lays on a PERSON, then the hour. The last two stack, so a blow after
        # dark is the disfavored number boosted rather than the raw one.
        integer damage = Combat.Nightly(Combat.Softened(
            Combat.Resolve(raw, Combat.Protection(level, defence), Combat.MinDamageFloor)));

        it.Sweep(true);
        who.Float("" + damage, 220, 60, 60);
        who.Message(it.Name + " hits you for " + damage + ".", "combat");

        Fight.Took(it, who, damage);
    end function

    # ── A creature that fights at range ───────────────────────────────────────
    #
    # The original’s casters backed out of melee and threw spells from the gap they had made. The engine
    # keeps the gap — a body authored to keep its distance closes to its standoff and holds there — and
    # this is what it does once it is standing where it meant to stand.
    #
    # ⚠ Intelligence stands in for strength, which is what it does everywhere else in this game: a bolt
    # is a swing delivered at range, and the range is paid for by the body having to hold a gap open
    # rather than by the bolt landing harder.
    #
    # ⚠ Neither a block nor a dodge answers one. Both are reactions to something arriving at arm’s
    # reach, and the answer to a body throwing from four tiles away is to close the four tiles.

    # How long between bolts. Slower than a swing, because the body is not in the fight it is shaping.
    public integer LooseSeconds = 2;

    public function Loose(Npc it, Player who)
        if who.IsDowned
            yield;
        end if

        integer int = it.Number(Stats.Int);

        # A body authored with none has nothing to throw. It keeps its distance and does nothing, which
        # is a heckler rather than a mistake.
        if int < 1
            yield;
        end if

        if it.IsWaiting
            yield;
        end if

        it.Wait(Combat.Beat(Fight.LooseSeconds, it.Map));
        it.Engage(Fight.EngagedSeconds);
        who.Engage(Fight.EngagedSeconds);
        Death.BreakGraceInFight(who);

        it.ThrowAtPlayer(who, "bolt", 150, 120, 255);

        # The wind takes a bolt as readily as a blow, and before anybody reacts.
        if Combat.WindTakesIt(it.Map)
            who.Message(it.Name + " looses wide in the wind.", "combat");
            yield;
        end if

        integer level = Stats.LevelOf(who);
        integer damage = Combat.Nightly(Combat.Softened(
            Combat.Resolve(Combat.Vary(Combat.Swing(int)),
                           Combat.Protection(level, who.Number(Stats.Def)), Combat.MinDamageFloor)));

        who.Float("" + damage, 150, 120, 255);
        who.Message(it.Name + " hits you for " + damage + ".", "combat");

        Fight.Took(it, who, damage);
    end function

    # Every way a creature can hurt a person ends here — a swing, and a bolt. Two copies would be two
    # answers to a refused death, and the forgotten one leaves a body standing at nothing.
    function Took(Npc it, Player who, integer damage)
        integer left = who.Number(Vitals.Health) - damage;

        if left > 0
            who.SetNumber(Vitals.Health, left);
            yield;
        end if

        who.SetNumber(Vitals.Health, 0);

        boolean died = who.Kill("slain by " + it.Name);

        if not died
            # ⚠ Something refused the death. A live body left standing at nothing is the bug that
            # follows: nothing anywhere sweeps for one, so it would stand there with regen quietly
            # ticking it back up. A refusal leaves them alive rather than neither.
            who.SetNumber(Vitals.Health, 1);
        end if
    end function
    # ── Which of the two a creature does ──────────────────────────────────────────
    #
    # Read off the record rather than carried on the body, because it is a fact about the KIND: every
    # copy of that creature fights the same way, and one that decided at spawn would be an archer by
    # accident.

    public function Meet(Npc it, Player who)
        # A body already out of action is not in the fight. Without this the same corpse is reached,
        # hit and killed again every beat, and each death costs whatever the last one did over again.
        if who.IsDowned
            yield;
        end if

        if it.Behavior == Beasts.KeepsDistance
            Fight.Loose(it, who);
            yield;
        end if

        Fight.Maul(it, who);
    end function

    public function MeetNpc(Npc it, Npc other)
        if it.Behavior == Beasts.KeepsDistance
            Fight.LooseAt(it, other);
            yield;
        end if

        Fight.Clash(it, other);
    end function

    # And the same bolt at another creature. A world with an archer and a wolf in it needs nothing
    # further to have the archer shoot the wolf.
    public function LooseAt(Npc it, Npc other)
        integer int = it.Number(Stats.Int);

        if int < 1
            yield;
        end if

        if it.IsWaiting
            yield;
        end if

        it.Wait(Combat.Beat(Fight.LooseSeconds, it.Map));
        it.Engage(Fight.EngagedSeconds);
        other.Engage(Fight.EngagedSeconds);

        it.ThrowAtNpc(other, "bolt", 150, 120, 255);

        if Combat.WindTakesIt(it.Map)
            yield;
        end if

        # ⚠ A creature has no level of its own, so its own defence stands in for one — the same
        # substitution every other creature-on-creature roll in this game makes.
        integer defence = other.Number(Stats.Def);
        integer damage = Combat.Resolve(Combat.Vary(Combat.Swing(int)),
                                        Combat.Protection(defence, defence), Combat.PveDamageFloor);

        Fight.Wound(other, damage, false);
        Loot.CreditBeast(other, damage);

        integer left = other.Number(Vitals.Health) - damage;

        if left > 0
            other.SetNumber(Vitals.Health, left);
            Beasts.AnswerNpc(other, it);
            yield;
        end if

        Fight.Fell(it, other);
    end function

    # ── What a wound looks like ───────────────────────────────────────────────

    public function Wound(Npc target, integer damage, boolean crit)
        if crit
            # Two, as the original wrote them.
            target.Float("" + damage + "!!", 255, 210, 80);
            target.Burst(190, 20, 20, 80);
            yield;
        end if

        target.Float("" + damage, 255, 240, 240);
        target.Burst(190, 20, 20, 40);
    end function

    # ── What a kill is worth ──────────────────────────────────────────────────

    # ⚠ A creature killed by a creature pays NOBODY. The original credited a kill to whoever landed the
    # blow, and a body that is not a player has no sheet to credit — so a wolf farming deer on an empty
    # map is an event nobody profits from, which is the point.

    function Fell(Npc it, Npc other)
        integer map = other.Map;
        integer x = other.X;
        integer y = other.Y;

        # The stain goes down BEFORE the body leaves. Once it is dead there is nothing left to ask
        # where it was standing.
        World.Stain(map, x, y, 2, 90);

        string name = other.Name;
        boolean died = other.Kill("slain");

        if not died
            yield;
        end if

        World.TellNear(map, x, y, it.Name + " kills " + name + ".", "combat");
    end function

    # Every way a player can kill a creature ends here — a swing, and a spell. Two copies would be
    # two experience curves, and the second one rots.
    public function Slain(Player who, Npc target, integer map, integer x, integer y)
        # ⚠ The stain goes down BEFORE the body leaves. Once it is dead there is nothing to ask where
        # it was standing.
        World.Stain(map, x, y, 2, 90);

        string name = target.Name;

        # ⚠ Read BEFORE the body goes, because a handle whose body has left answers zero — and a quest
        # counting kills would then count them all as the same creature, which is no creature.
        integer kind = target.Kind;

        boolean died = target.Kill("slain");

        if not died
            # Nothing was there to kill, so nothing was earned. Paying out anyway is how a verb
            # spammed at an empty square becomes a way to farm experience.
            yield;
        end if

        World.TellNear(map, x, y, name + " falls.", "combat");

        # A creature's worth is what it was made of. The original computed this from the length of the
        # fight it would have been; this is the same shape with the stats it had.
        integer worth = Combat.Swing(target.Number(Stats.Def)) + Combat.Swing(target.Number(Stats.Str));

        # The hour and the sky both pay, and they compound: a kill made in a gale after dark is worth
        # both. The guild trickle below is untouched by either, being one point whatever the kill was.
        Levels.Earn(who, Combat.Worth(worth, map));

        # ⚠ A guild earns ONE point for a kill, whatever the kill was worth to the player. The two
        # curves have nothing to do with each other: a guild's runs to hundreds of millions and is
        # climbed by questing, and the kill trickle is a rounding error against it on purpose.
        Guilds.Earn(who, Guilds.ExpPerKill);
        Perks.Trickle(who);

        # The one place a player kills a creature, so a kill counts toward a quest whether it was a
        # swing or a spell. A second call site would be a second rule, and the forgotten one would
        # not surface until a quest refused to finish.
        Quests.Killed(who, kind);
        GuildQuest.Killed(who, kind);

        # And the land it died on pays whoever holds it, which is what makes holding any worth doing.
        Territory.Earned(who, map);
    end function

end model
