# Who may wield what, and what a scroll does when it is read.
#
# What this game hangs on an item lives in declarations/gear.cm. This file gives those facts meaning.

shared model Gear

    public string Of = "Items";
    # ⚠ A LIST on the thing itself, not a table beside it. One field naming the classes that may
    # have it: no second family to author, no limit to raise as a world grows, and the question is one
    # read rather than a walk of every row. A piece that names none is open to everybody.
    public string WieldableBy = "mayWield";

    # ── The gate ──────────────────────────────────────────────────────────────

    # ⚠ NO LIST on a piece means every class may wield it, which is the common case and so the
    # one that costs nothing to author. The same shape the spell gate takes, read the same way.
    public boolean function OpenTo(integer item, integer forClass)
        yield World.RecordAllows("Items", item, Gear.WieldableBy, forClass);
    end function

    # Everything this game asks before somebody should be holding a piece: the class it is written
    # for, and the level it was meant for.
    public boolean function MayWield(Player who, integer item)
        if not Gear.OpenTo(item, who.Number(Classes.Key))
            yield false;
        end if

        yield Stats.LevelOf(who) >= Gear.LevelNeeded(item);
    end function

    public integer function LevelNeeded(integer item)
        yield World.RecordNumber(Gear.Of, item, "levelReq");
    end function

    # ── Wearing out in a fight ────────────────────────────────────────────────
    #
    # A piece does not lose a point every time it is used. It loses one on a roll that gets likelier as
    # it wears: healthy gear shrugs off three hits in four, and gear under a quarter chips every time.
    # A kit degrades slowly at first and then quickly, so repairing it is a decision.
    #
    # Rain doubles what a chip costs, and a guild at level two has a chance to shrug one off entirely.
    # ⚠ That privilege is about ORDINARY wear only — what dying costs is untouched by it.

    public integer HealthyPercent = 75;
    public integer WornPercent = 50;
    public integer DamagedPercent = 25;

    public integer HealthyChance = 25;
    public integer WornChance = 50;
    public integer DamagedChance = 75;
    public integer CriticalChance = 100;

    public integer RainWear = 2;

    public string Rainy = "rain";

    # How likely this piece is to chip, by how worn it already is.
    public integer function ChipChance(integer left, integer full)
        if full < 1
            yield 0;
        end if

        integer share = left * 100 / full;

        if share >= Gear.HealthyPercent
            yield Gear.HealthyChance;
        end if

        if share >= Gear.WornPercent
            yield Gear.WornChance;
        end if

        if share >= Gear.DamagedPercent
            yield Gear.DamagedChance;
        end if

        yield Gear.CriticalChance;
    end function

    # What a hit costs a kit ON AVERAGE, over a whole hundred-to-nothing cycle: the durability spent
    # divided by the hits it takes to spend it, band by band. Four bands twenty-five wide at a quarter,
    # a half, three quarters, and certainty come to about 0.48.
    #
    # ⚠ Read off the bands above rather than written down, because the thing priced against it is a
    # CASTER'S upkeep. A number copied here goes stale the moment a band moves, and it fails quietly:
    # nothing throws, casters simply stop paying their share.
    public real function AverageChip()
        real hits = 0.0;

        hits = hits + Gear.BandHits(100 - Gear.HealthyPercent, Gear.HealthyChance);
        hits = hits + Gear.BandHits(Gear.HealthyPercent - Gear.WornPercent, Gear.WornChance);
        hits = hits + Gear.BandHits(Gear.WornPercent - Gear.DamagedPercent, Gear.DamagedChance);
        hits = hits + Gear.BandHits(Gear.DamagedPercent, Gear.CriticalChance);

        if hits <= 0.0
            yield 0.0;
        end if

        # ⚠ Pinned to six places. The band widths divide unevenly, so the sum above carries a tail in
        # its last digit, and the answer feeds a CEILING — where a tail is the difference between
        # charging two of something and charging three.
        yield Math.Round(100.0 / hits, 6);
    end function

    # Hits spent crossing one band: the points in it over the share of a point each hit takes.
    real function BandHits(integer width, integer chance)
        if chance < 1
            yield 0.0;
        end if

        yield width * 100.0 / chance;
    end function

    # One hit's worth of wear on whatever is in that slot. A piece with no durability budget at all is
    # indestructible and never chips.
    public function Chip(Player who, string slot)
        integer item = World.WornIn(who, slot);

        if item < 1
            yield;
        end if

        integer full = World.DurabilityFull(who, item);

        if full < 1
            yield;
        end if

        if not Combat.Rolls(Gear.ChipChance(World.DurabilityLeft(who, item), full))
            yield;
        end if

        if Perks.Shrugs(who)
            yield;
        end if

        integer points = 1;

        if World.Weather(who.Map) == Gear.Rainy
            points = Gear.RainWear;
        end if

        if World.WearOut(who, item, points) > 0
            if World.DurabilityLeft(who, item) <= 0
                if who.TakeOff(item)
                    who.Message("Your gear has broken.");
                end if
            end if
        end if
    end function

    # ── The coin, and the reagent ─────────────────────────────────────────────
    #
    # Two items a rule needs to name: what this world spends, and what a cast burns. Each is a box an
    # author ticks on exactly one item. Found once by walking the items and kept, because a world's
    # items do not change under a running server. Minus one means nobody ticked the box.

    public string CoinField = "coin";
    public string ReagentField = "reagent";

    integer minted = 0;
    integer ground = 0;

    public integer function Coin()
        if Gear.minted == 0
            Gear.minted = Gear.Marked(Gear.CoinField);
        end if

        yield Gear.minted;
    end function

    public integer function Reagent()
        if Gear.ground == 0
            Gear.ground = Gear.Marked(Gear.ReagentField);
        end if

        yield Gear.ground;
    end function

    integer function Marked(string field)
        loop for num = 1 to World.Records(Gear.Of)
            if World.RecordTruth(Gear.Of, num, field)
                yield num;
            end if
        end loop

        yield -1;
    end function

    # ── Refusing ──────────────────────────────────────────────────────────────
    #
    # Asked before the piece goes on, so a refusal means it never did. A rule told afterwards could
    # only take it off again: the player sees a flicker, and for the moment between the two the wrong
    # body is wearing the wrong thing.
    #
    # ⚠ A blank answer lets it happen. Every refusal here names something the player can do something
    # about, because a refusal with no reason reads as the game being broken.
    public string function Judge(Player who, integer item)
        # Only gear is gated. A potion, a key, a scroll — nothing this game says restricts any of them,
        # and refusing something nobody gated would refuse everything.
        if Gear.MayWield(who, item)
            yield "";
        end if

        integer needed = Gear.LevelNeeded(item);

        if Stats.LevelOf(who) < needed
            yield "You must be level " + needed + " to use that.";
        end if

        yield "Your kind was never trained for that.";
    end function

end model
