# What a guild is worth to the people in it.
#
# One privilege a level, cumulative, and every one of them switches off the moment the tax goes
# unpaid. Levelling a guild is slow and expensive, and these five are what the money buys.
#
# ⚠ Two of the five reach nothing here, because the engine does the thing they modify: what a
# creature drops and how a swing wears a weapon are Core's, and a rule has no hold on either. They
# are declared anyway, so the levels read correctly and so what is missing is visible rather than
# silently absent.

shared model Perks

    public integer DropRateLevel = 1;
    public integer PreventWearLevel = 2;
    public integer BonusExpLevel = 3;
    public integer DoubleDropLevel = 4;
    public integer VaultGoldLevel = 5;

    public integer DropRateBonusPercent = 20;
    public integer PreventWearChancePercent = 20;
    public integer BonusExpPercent = 10;
    public integer DoubleDropChancePercent = 5;

    public integer VaultGoldChancePercent = 25;
    public integer VaultGold = 35;

    # Whether a guild's privileges are in force at that level: it has reached the level, and its tax
    # is paid. A guild at level five in arrears has none of them.
    public boolean function Active(integer guild, integer level)
        if guild < 1
            yield false;
        end if

        if World.GuildNumber(guild, Ledger.PerksActive) < 1
            yield false;
        end if

        yield Guilds.LevelOf(guild) >= level;
    end function

    # ── Level three: a tenth more experience ──────────────────────────────────

    public integer function Bonus(Player who, integer worth)
        if not Perks.Active(World.GuildOf(who), Perks.BonusExpLevel)
            yield 0;
        end if

        yield Math.Round(worth * Perks.BonusExpPercent / 100.0);
    end function

    # ── Level two: gear sometimes shrugs off a hit ────────────────────────────
    #
    # ⚠ Ordinary wear only. What dying costs a kit is untouched by this, so the privilege is not an
    # answer to a war.

    public boolean function Shrugs(Player who)
        if not Perks.Active(World.GuildOf(who), Perks.PreventWearLevel)
            yield false;
        end if

        yield Combat.Rolls(Perks.PreventWearChancePercent);
    end function

    # ── Level five: a kill sometimes pays the vault ───────────────────────────
    #
    # Into the day's pot rather than the vault itself, and credited at the settlement after the
    # debits — so a day's earnings cannot bail out the same day's bill.

    public function Trickle(Player who)
        integer guild = World.GuildOf(who);

        if not Perks.Active(guild, Perks.VaultGoldLevel)
            yield;
        end if

        if not Combat.Rolls(Perks.VaultGoldChancePercent)
            yield;
        end if

        World.SetGuildNumber(guild, Ledger.Pending,
                             World.GuildNumber(guild, Ledger.Pending) + Perks.VaultGold);
    end function

end model
