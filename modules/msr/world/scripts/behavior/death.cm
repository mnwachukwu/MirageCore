# What dying costs, and where you wake up.
#
# The engine takes the body out of play and puts it back. Everything between those two — the gear
# that wears, the experience that goes, the flag the killer picks up, how long you lie there — is
# this file, and it runs while the body is still on the tile it fell on.
#
# Five kinds of death, and which one it is decides all of it:
#
#   an arena kill      costs nothing at all
#   a guild-war kill   costs worn gear and nothing else, at double the usual rate
#   a murderer's death costs double, and drops the bag
#   too far apart      costs nothing, and earns the killer nothing
#   anything else      the usual: gear, experience, and a flag on whoever did it

shared model Death

    # ── Wear, as a share of a piece's full durability ─────────────────────────

    public integer NormalWearPercent = 10;
    public integer MurdererWearPercent = 20;

    # A war death wears double, and the vault pays most of putting it right.
    public integer WarWearPercent = 20;

    # ── The murderer's flag ───────────────────────────────────────────────────
    #
    # Held as an expiry of our own rather than as the engine's mark, because killing a murderer
    # SHORTENS theirs and the engine's mark answers yes or no. The mark is set alongside it, so the
    # name plate everybody else sees says the same thing this number does.

    public string MurdererUntil = "pkuntil";

    public integer MurdererSeconds = 3600;
    public integer MurdererKillRelief = 1800;

    # How long the flashing name lasts on whoever swung first.
    public integer AggressorSeconds = 30;

    # ── Lying there ───────────────────────────────────────────────────────────
    #
    # Ten seconds a death, one more step each time, shedding a step per minute and capped at two
    # minutes. A war death overrides it with a flat half minute.

    public string Steps = "deathsteps";
    public string LastDeath = "diedat";

    public integer StepSeconds = 10;
    public integer MaxSteps = 12;
    public integer WarRespawnSeconds = 30;

    # ── Reading the flag ──────────────────────────────────────────────────────

    public boolean function IsMurderer(Player who)
        yield who.Number(Death.MurdererUntil) > World.Now();
    end function

    # ── The breathing space after one ─────────────────────────────────────────
    #
    # A murderer who has just died is treated as though they were not one for a minute. They come back
    # on open ground wearing a flag everybody may swing at, and without this they are killed again
    # where they land — which is a sentence nobody chose the length of.
    #
    # ⚠ It is the ONE thing that reads the flag differently, so nothing asks IsMurderer to decide
    # whether the world is hunting somebody. IsHunted is that question, and it is the one a protected
    # map and a guard both ask.

    public string GraceUntil = "graceuntil";

    public integer GraceSeconds = 60;

    public function BeginGrace(Player who)
        who.SetNumber(Death.GraceUntil, World.Now() + Death.GraceSeconds);

        # The name plate comes off with it. A murderer nobody may touch who still wears the mark is a
        # body everybody keeps swinging at for nothing.
        who.Mark(0);
        who.Message("You have a minute before the world comes for you again.");
    end function

    public boolean function InGrace(Player who)
        yield who.Number(Death.GraceUntil) > World.Now();
    end function

    # It ends the moment they are in a fight, and the mark goes back on for whatever is left of the
    # sentence.
    public function BreakGrace(Player who)
        if not Death.InGrace(who)
            yield;
        end if

        who.SetNumber(Death.GraceUntil, 0);

        integer left = who.Number(Death.MurdererUntil) - World.Now();

        if left > 0
            who.Mark(left);
        end if

        who.Message("Your minute is up.");
    end function

    # ⚠ A skirmish with a creature in a town does NOT end it. The minute is for walking away from
    # where you fell, and a wolf wandering through a safe place is not what it was given against.
    public function BreakGraceInFight(Player who)
        if Places.IsProtected(who.Map)
            yield;
        end if

        Death.BreakGrace(who);
    end function

    # Whether the world is hunting them.
    public boolean function IsHunted(Player who)
        yield Death.IsMurderer(who) and not Death.InGrace(who);
    end function

    public function MarkMurderer(Player who)
        integer now = World.Now();
        integer expiry = now;

        if Death.IsMurderer(who)
            expiry = who.Number(Death.MurdererUntil);
        end if

        expiry = expiry + Death.MurdererSeconds;

        who.SetNumber(Death.MurdererUntil, expiry);
        who.Mark(expiry - now);

        World.Tell(who.Name + " has murdered somebody.");

        # And the town answers. The guards standing near enough to have seen it come after them, which
        # is the whole of what a guard is for.
        Beasts.CallGuards(who, who.Map, who.X, who.Y);
    end function

    # Killing a murderer takes half an hour off their sentence. Two deaths clear a fresh flag.
    function Relieve(Player who)
        integer left = who.Number(Death.MurdererUntil) - Death.MurdererKillRelief;

        if left <= World.Now()
            who.SetNumber(Death.MurdererUntil, 0);
            who.Mark(0);
            World.Tell(who.Name + " has paid for it.");
            yield;
        end if

        who.SetNumber(Death.MurdererUntil, left);
        who.Mark(left - World.Now());
        World.Tell(who.Name + " is still paying for it.");
    end function

    # Whoever swings first wears the flashing name for half a minute. Not in an arena, where nothing
    # is at stake, and not against somebody already flagged, who is fair game.
    public function StartedIt(Player who)
        who.Flag(Death.AggressorSeconds);
    end function

    # ── A death ───────────────────────────────────────────────────────────────

    public function Fell(Player who, Player killer, string cause)
        integer level = Stats.LevelOf(who);

        # Where the map author says leaving this place lands you, which outranks whatever respawn
        # point the player bought for themselves. A war death overrides it again, below.
        Death.SendHome(who);

        # A murderer gets their minute, whatever the death cost them below.
        if Death.IsMurderer(who)
            Death.BeginGrace(who);
        end if

        # The bout ends here whatever it cost, so nothing dealt before now counts toward the next one.
        string creditedTo = Duel.CreditedTo(who);
        Duel.ClearCredit(who);

        boolean byPlayer = killer.IsHere;

        # Nobody under ten loses anything, to anybody.
        if level < Duel.MinLevel
            who.Message("You are spared the cost of that death.");
            Death.LieThere(who, false);
            yield;
        end if

        if byPlayer and Places.EitherArena(who, killer)
            who.Message("It was only a bout. You have lost nothing.");
            Death.LieThere(who, false);
            yield;
        end if

        # A war death: the credited killer's guild is the one at war, not whoever landed the last
        # blow. Worn gear is the only thing it costs.
        #
        # ⚠ A death in a territory contest is a war death too, and for the same reason — it is agreed
        # hostility over land rather than murder, so it costs a kit and nothing else.
        if byPlayer
            Player? credited = who.Find(creditedTo);

            if credited.HasValue()
                if Guilds.AtWar(who, credited.Value()) or Contest.Fighting(credited.Value(), who)
                    # A grudge war has no ground of its own, so they come back where they fell and
                    # the fight carries on. The body has not moved yet, so the tile is still readable.
                    who.RespawnAt(who.Map, who.X, who.Y);

                    Guilds.WarDeath(who, credited.Value());
                    Death.LieThere(who, true);
                    yield;
                end if
            end if
        end if

        # Too far apart in level, and it costs the loser nothing.
        if byPlayer and Death.TooFarApart(who, killer)
            who.Message("They were too far above you for that to cost you anything.");
            killer.Message("They were too far below you to be worth anything.");
            Death.LieThere(who, false);
            yield;
        end if

        if Death.IsMurderer(who)
            Death.Murderer(who, killer, byPlayer);
            Death.LieThere(who, false);
            yield;
        end if

        Death.Ordinary(who, killer, byPlayer);
        Death.LieThere(who, false);
    end function

    boolean function TooFarApart(Player who, Player killer)
        integer gap = Stats.LevelOf(who) - Stats.LevelOf(killer);

        yield Math.Abs(gap) >= Duel.LevelGapProtection;
    end function

    # A murderer's death: the bag on the ground, a roll on every piece worn, double the wear, double
    # the experience, and half an hour off the sentence.
    #
    # ⚠ The drops run BEFORE the wear. A piece that breaks on a death is unequipped by the wear, and
    # if that ran first the piece would be scattered as ordinary luggage rather than getting the
    # equipped roll it was owed. The order carries the rule; do not swap it.
    function Murderer(Player who, Player killer, boolean byPlayer)
        who.Message("You are a murderer, and it costs you double.");

        Death.BurnReagents(who, Death.MurdererWearPercent);
        Death.DropCarried(who, 100);
        Death.DropWorn(who);
        Death.WearGear(who, Death.MurdererWearPercent);

        integer lost = Death.LoseExp(who, 2);

        if byPlayer
            Death.Pay(who, killer, lost);
            Death.Relieve(who);
        end if
    end function

    # The usual death. Killing somebody who was not a murderer and had not started it makes the
    # killer one.
    #
    # ⚠ Drops before wear here too, for the same reason.
    function Ordinary(Player who, Player killer, boolean byPlayer)
        Death.BurnReagents(who, Death.NormalWearPercent);
        Death.DropCarried(who, Death.NormalDropPercent);
        Death.WearGear(who, Death.NormalWearPercent);

        integer lost = Death.LoseExp(who, 1);

        if not byPlayer
            yield;
        end if

        Death.Pay(who, killer, lost);

        if who.IsAggressor
            killer.Message("They started it. That one was free.");
            yield;
        end if

        Death.MarkMurderer(killer);
    end function

    # ── Where they wake up ────────────────────────────────────────────────────
    #
    # The map they died on gets first say, through the boot point its author wrote — or its region's,
    # for a map that named none. Saying nothing leaves it to the engine, which answers with the
    # player's own respawn point and then the world's.

    public function SendHome(Player who)
        integer exit = World.ExitMap(who.Map);

        if exit < 1
            yield;
        end if

        who.RespawnAt(exit, World.ExitX(who.Map), World.ExitY(who.Map));
    end function

    # ── What falls on the ground ──────────────────────────────────────────────
    #
    # An ordinary death scatters a fifth of what is in the bag, at random, and leaves what is worn
    # alone. A murderer's death empties the bag outright and rolls a quarter on each worn piece as
    # well, so killing one is worth doing.
    #
    # Coin is a special case in both: a slot of it drops a part rather than the lot. An ordinary
    # death loses some of it and a murderer loses all of it.

    public integer NormalDropPercent = 20;
    public integer WornDropPercent = 25;

    # Each carried slot rolls separately at that chance. At a hundred the whole bag goes.
    public function DropCarried(Player who, integer chance)
        integer coin = Gear.Coin();

        loop each slot in World.BagOf(who)
            if not World.SlotIsWorn(who, slot)
                if Combat.Rolls(chance)
                    Death.Scatter(who, slot, coin, chance);
                end if
            end if
        end loop
    end function

    # And every worn piece rolls a quarter, which only a murderer faces.
    public function DropWorn(Player who)
        loop each slot in World.BagOf(who)
            if World.SlotIsWorn(who, slot)
                if Combat.Rolls(Death.WornDropPercent)
                    World.DropSlot(who, slot, 0);
                end if
            end if
        end loop
    end function

    # One slot on the ground. A slot of coin drops part of itself on an ordinary death and the whole
    # pile on a murderer's; anything else goes whole either way.
    function Scatter(Player who, integer slot, integer coin, integer chance)
        if World.ItemInSlot(who, slot) != coin or chance >= 100
            World.DropSlot(who, slot, 0);
            yield;
        end if

        integer held = World.CountInSlot(who, slot);

        World.DropSlot(who, slot, Combat.Roll(held) + 1);
    end function

    # ── What it costs ─────────────────────────────────────────────────────────

    # Every piece they are wearing loses that share of its full durability, and a piece worn to
    # nothing comes off. It stays in the bag; nothing on a death destroys a piece of gear.
    public function WearGear(Player who, integer percent)
        loop each item in World.WornBy(who)
            integer full = World.DurabilityFull(who, item);

            if full > 0
                integer points = Death.WearOn(full, percent);

                if World.WearOut(who, item, points) > 0
                    if World.DurabilityLeft(who, item) <= 0
                        if who.TakeOff(item)
                            who.Message("Your gear has been ruined.");
                        end if
                    end if
                end if
            end if
        end loop
    end function

    # ── What a caster loses ───────────────────────────────────────────────────
    #
    # Reagents are a caster's durability, so a death destroys them the way it wears a kit: at the same
    # share, doubled for a murderer, and priced off the spell they had prepared rather than off
    # anything they are holding. A warrior's weapon wears from the weapon; a caster's pouch empties
    # from the book, so somebody carrying both pays both.
    #
    # ⚠ Run BEFORE the drops, so what survives this still faces the ordinary drop roll — the same
    # ordering the wear itself is under, and for the same reason.

    public integer CasterDeathMultiplier = 10;

    # What this death is owed from the pouch, never more than is in it. Answered without taking
    # anything, because a war death prices the loss into the vault's bill before deciding how much of
    # it the player actually bears.
    public integer function ReagentLoss(Player who, integer percent)
        integer tier = Book.CasterTier(who);

        if tier < 1
            yield 0;
        end if

        integer reagent = Gear.Reagent();

        if reagent < 1
            yield 0;
        end if

        integer held = who.Carrying(reagent);

        if held < 1
            yield 0;
        end if

        integer lost = Math.Round(Spells.BaseReagentCost(tier) * Death.CasterDeathMultiplier
                                  * percent / Death.NormalWearPercent);

        if lost > held
            yield held;
        end if

        if lost < 1
            yield 0;
        end if

        yield lost;
    end function

    public function TakeReagents(Player who, integer many)
        if many < 1
            yield;
        end if

        who.Take(Gear.Reagent(), many);
        who.Message("You lose " + many + " of what you cast with.");
    end function

    public function BurnReagents(Player who, integer percent)
        Death.TakeReagents(who, Death.ReagentLoss(who, percent));
    end function

    # What a share of a piece's durability comes to, never less than a point: a death always leaves
    # a mark, whatever the piece is made of.
    public integer function WearOn(integer full, integer percent)
        integer points = Math.Round(full * percent / 100.0);

        if points < 1
            yield 1;
        end if

        yield points;
    end function

    # A tenth of the level's experience, doubled for a murderer. Never below zero and never a level.
    integer function LoseExp(Player who, integer multiplier)
        integer level = Stats.LevelOf(who);
        integer lost = Math.Round(Stats.ToNextLevel(level - 1) * multiplier / 10.0);
        integer held = who.Number(Stats.Exp);

        if lost > held
            lost = held;
        end if

        if lost < 1
            yield 0;
        end if

        who.SetNumber(Stats.Exp, held - lost);
        who.Message("You lose " + lost + " experience.");

        yield lost;
    end function

    # What the loser lost, the winner takes. Whoever dealt the most damage is the one who earns it,
    # which is the same person the war rule credits.
    function Pay(Player who, Player killer, integer lost)
        if lost < 1
            yield;
        end if

        killer.Message("You take " + lost + " experience from " + who.Name + ".");

        Levels.Earn(killer, lost);
    end function

    # ── How long they lie there ───────────────────────────────────────────────

    public function LieThere(Player who, boolean inWar)
        if inWar
            who.Down(Death.WarRespawnSeconds);
            yield;
        end if

        integer now = World.Now();
        integer since = who.Number(Death.LastDeath);
        integer steps = who.Number(Death.Steps);

        # A step is shed for every whole minute since the last death, and never below none.
        if since > 0 and now > since
            integer shed = (now - since) / 60;

            if shed > steps
                shed = steps;
            end if

            steps = steps - shed;
        end if

        steps = steps + 1;

        if steps > Death.MaxSteps
            steps = Death.MaxSteps;
        end if

        who.SetNumber(Death.Steps, steps);
        who.SetNumber(Death.LastDeath, now);
        who.Down(steps * Death.StepSeconds);
    end function

end model
