# The three pools, and what puts back into them.
#
# A pool is two numbers: what a body has, and what it can hold. Only the current value is really
# stored. The ceiling is derived from the formula in stats.cm and recomputed whenever anything it
# reads changes — stored instead, the two drift apart, and a character whose maximum disagrees with
# their level is a bug nobody sees until they heal.
#
# ⚠ Stamina does not come back while you run, and the pools shrink in snow. Both are read off the
# world rather than off the body: running is the engine's own movement state, and the weather is the
# engine's own sky.

shared model Vitals

    # What a body has now. These reach a save file, so they are written once here.
    public string Health = "hp";
    public string Mana = "mp";
    public string Stamina = "sp";

    # And what it can hold. Derived, but carried as attributes because the CLIENT draws the bars from
    # them and has no way to run a formula.
    public string MaxHealth = "maxhp";
    public string MaxMana = "maxmp";
    public string MaxStamina = "maxsp";

    # ── What the engine is told ───────────────────────────────────────────────

    public function Declare(Builder game)
        # Anybody who can see you can see your condition; a bar over a head is public by nature.
        game.Attribute(Vitals.Health, "viewport");
        game.Attribute(Vitals.MaxHealth, "viewport");
        game.Attribute(Vitals.Mana, "viewport");
        game.Attribute(Vitals.MaxMana, "viewport");
        game.Attribute(Vitals.Stamina, "viewport");
        game.Attribute(Vitals.MaxStamina, "viewport");

        # Nobody sees what a pool is owed; it rides along with the character so a reconnect does not
        # lose a part-paid tick.
        game.Attribute(Vitals.HealthOwed, "owner");
        game.Attribute(Vitals.ManaOwed, "owner");
        game.Attribute(Vitals.StaminaOwed, "owner");
        game.Attribute(Vitals.LastRun, "owner");

        # Three bars over every head, in the colors MSR drew them.
        game.Bar(Vitals.Health, Vitals.MaxHealth, 190, 40, 40);
        game.Bar(Vitals.Mana, Vitals.MaxMana, 60, 90, 200);
        game.Bar(Vitals.Stamina, Vitals.MaxStamina, 60, 170, 70);

        # And the same three on the sidebar, where the numbers are readable.
        game.Heading("Condition");
        game.Meter(Vitals.Health, Vitals.MaxHealth, "Health", 190, 40, 40);
        game.Meter(Vitals.Mana, Vitals.MaxMana, "Mana", 60, 90, 200);
        game.Meter(Vitals.Stamina, Vitals.MaxStamina, "Stamina", 60, 170, 70);
    end function


    # ── Running ────────────────────────────────────────────────────────────────
    #
    # A point a step, whatever is worn. The original charged nothing for the armor: a shield already
    # pays for itself in the fight, where it is the only piece whose defense is rolled for rather than
    # applied and every block it wins costs stamina the moment it lands. Charging for the walk as well
    # taxed the same choice twice, and it fell hardest on a low-level body, where crossing a field
    # between two creatures cost most of a pool before the fight had started.
    #
    # ⚠ An empty bar brings them down to a WALK rather than stopping them. Being winded is a pace.

    public integer RunCost = 1;

    # When the last step at a run was taken, in seconds. Read by Rest, which pays nothing back into
    # stamina while a sprint is still running.
    public string LastRun = "lastrun";

    # How long after a step a sprint still counts as running. A body fills as soon as it stops, and
    # without a hold the rest rate refunds a sprint about as fast as it is spent.
    public integer SprintHold = 3;

    public string function MayRun(Player who)
        if who.Number(Vitals.Stamina) > 0
            yield "";
        end if

        yield "winded";
    end function

    public function Ran(Player who)
        integer cost = Vitals.RunCost;

        if World.Weather(who.Map) == Combat.Hot
            cost = cost * Combat.HeatCostMultiplier;
        end if

        integer left = who.Number(Vitals.Stamina) - cost;

        if left < 0
            left = 0;
        end if

        who.SetNumber(Vitals.Stamina, left);
        who.SetNumber(Vitals.LastRun, World.Now());
    end function

    boolean function Sprinting(Player who)
        integer last = who.Number(Vitals.LastRun);

        if last < 1
            yield false;
        end if

        yield World.Now() - last < Vitals.SprintHold;
    end function

    # ── Drinking something ────────────────────────────────────────────────────
    #
    # A draught puts something back, and a negative amount TAKES it instead, which is the original’s
    # other half: one that trades health for mana is one item rather than two rules.
    #
    # ⚠ One that would do nothing is REFUSED rather than drunk. A full bar, or an empty one to take
    # from, costs neither the item nor the beat — the engine paces a draught by the item leaving the
    # bag rather than by the use being offered.

    public function Drink(Player who, integer item)
        integer health = World.RecordNumber(Gear.Of, item, "restoresHealth");
        integer mana = World.RecordNumber(Gear.Of, item, "restoresMana");
        integer stamina = World.RecordNumber(Gear.Of, item, "restoresStamina");

        if health == 0 and mana == 0 and stamina == 0
            yield;
        end if

        boolean any = false;

        if Vitals.Pour(who, Vitals.Health, Vitals.MaxHealth, health)
            any = true;
        end if

        if Vitals.Pour(who, Vitals.Mana, Vitals.MaxMana, mana)
            any = true;
        end if

        if Vitals.Pour(who, Vitals.Stamina, Vitals.MaxStamina, stamina)
            any = true;
        end if

        if not any
            who.Message("It would do nothing for you.");
            yield;
        end if

        who.Take(item, 1);
    end function

    # One pool. False when there was nothing to do, which is what decides whether the draught is spent.
    boolean function Pour(Player who, string key, string ceiling, integer amount)
        if amount == 0
            yield false;
        end if

        integer have = who.Number(key);
        integer most = who.Number(ceiling);
        integer want = have + amount;

        if want > most
            want = most;
        end if

        if want < 0
            want = 0;
        end if

        if want == have
            yield false;
        end if

        who.SetNumber(key, want);

        if amount > 0
            who.Float("+" + (want - have), 120, 220, 120);
        end if

        yield true;
    end function

    # ── The ceilings ──────────────────────────────────────────────────────────

    # Recomputed from the formulas, and the pools topped up to match where they grew.
    #
    # ⚠ Called anywhere level or a stat changes. A ceiling written once at enrollment is a ceiling
    # that is wrong from the first level up, and the bar would read full at a value it has outgrown.
    public function Refresh(Player who)
        integer level = Stats.LevelOf(who);

        # ⚠ The class counts a second time here. Its spread became the character's four stats at
        # enlistment, and it is added to every ceiling for as long as they play, so a class still
        # matters once the opening twenty points stop mattering. Somebody who has not enlisted reads
        # zero and gets the plain curve.
        integer health = Stats.MaxHealth(level, who.Number(Stats.Def), Classes.StatOf(who, Stats.Def));
        integer mana = Stats.MaxMana(level, who.Number(Stats.Int), Classes.StatOf(who, Stats.Int));
        integer stamina = Stats.MaxStamina(level, who.Number(Stats.Spd), Classes.StatOf(who, Stats.Spd));

        # ⚠ Snow shrinks what a body can hold, health least of the three. Applied to the ceiling
        # rather than to regen, so a blizzard is felt at once; the cap below takes the current value
        # down with it, so walking into one is noticed rather than worked out later.
        if World.Weather(who.Map) == Combat.Snowy
            health = Math.Round(health * Vitals.SnowHealth);
            mana = Math.Round(mana * Vitals.SnowOther);
            stamina = Math.Round(stamina * Vitals.SnowOther);
        end if

        who.SetNumber(Vitals.MaxHealth, health);
        who.SetNumber(Vitals.MaxMana, mana);
        who.SetNumber(Vitals.MaxStamina, stamina);

        # A ceiling that came down takes the current value with it, or the bar draws past its end.
        Vitals.Cap(who, Vitals.Health, health);
        Vitals.Cap(who, Vitals.Mana, mana);
        Vitals.Cap(who, Vitals.Stamina, stamina);
    end function

    function Cap(Player who, string key, integer ceiling)
        if who.Number(key) > ceiling
            who.SetNumber(key, ceiling);
        end if
    end function

    # Everything full. What a new character starts with, and what waking up after a death is.
    public function Fill(Player who)
        Vitals.Refresh(who);

        who.SetNumber(Vitals.Health, who.Number(Vitals.MaxHealth));
        who.SetNumber(Vitals.Mana, who.Number(Vitals.MaxMana));
        who.SetNumber(Vitals.Stamina, who.Number(Vitals.MaxStamina));
    end function

    # ── Putting it back ───────────────────────────────────────────────────────
    #
    # Health does not come back in a fight. That is the shape of the original's regen: a fight can be
    # lost, and retreating is a decision. Mana and stamina do come back mid-fight, at half rate, so a
    # caster can sustain without casting for free.

    # ── How often the original paid, in hundredths of a second ──────────────────────────
    #
    # The original ran five clocks rather than one rate. Each pool was paid a whole amount when its own
    # clock came round, and which clock applied depended on where you were standing and whether you
    # were in a fight.
    #
    # The tick here is one second, so a pool is paid the share of an interval that a tick is worth and
    # the fraction left over is carried to the next one. Over any stretch of time the total matches the
    # original exactly, and no pool is handed an interval's worth all at once.
    #
    # Hundredths rather than tenths because 1.25 seconds is not a whole number of tenths, and rounding
    # the safe-ground clock is rounding the one rate a player notices.
    #
    # Being in a fight beats being somewhere protected. Fighting inside a town gets ordinary combat
    # regen rather than a fast one, which is what stops a safe tile being a place to fight from.

    public integer HealthEvery = 250;
    public integer HealthSafeEvery = 125;
    public integer OtherEvery = 250;
    public integer OtherSafeEvery = 100;
    public integer InCombatEvery = 500;

    # One tick, in the same hundredths. Change Rules.TickEvery and this follows it.
    public integer TickHundredths = 100;

    # What a pool is owed but has not been paid yet, in thousandths of a point. Carried because a slow
    # clock on a small pool would otherwise round away to nothing every tick and never pay at all.
    public string HealthOwed = "hpowed";
    public string ManaOwed = "mpowed";
    public string StaminaOwed = "spowed";

    # What snow costs. Health suffers least because being cold is not being hurt.
    public real SnowHealth = 0.9;
    public real SnowOther = 0.8;

    public function Rest(Player who)
        # A body out of action neither mends nor tires. It comes back with whatever getting up gives
        # it, and a pool creeping up under the panel would make the wait mean something it does not.
        if who.IsDowned
            yield;
        end if

        integer def = who.Number(Stats.Def);
        integer int = who.Number(Stats.Int);
        integer spd = who.Number(Stats.Spd);

        # Stamina does not come back while it is being SPENT - not in a fight, and not while a sprint
        # is still running. It is the one pool whose cost is paid continuously, so any rate generous
        # enough to feel like recovery would refund a sprint as fast as it was spent. Stopping the
        # clock rather than shrinking it is what lets a rest stay quick while the pool stays a budget.
        integer legs = Stats.StaminaRegen(spd);

        if Vitals.Sprinting(who) or who.IsEngaged
            legs = 0;
        end if

        # Health does not come back in a fight at all, and mana comes back on the slow clock.
        if who.IsEngaged
            Vitals.Owe(who, Vitals.Mana, Vitals.MaxMana, Vitals.ManaOwed,
                       Stats.ManaRegen(int), Vitals.InCombatEvery);
            yield;
        end if

        integer heart = Vitals.HealthEvery;
        integer other = Vitals.OtherEvery;

        if Places.IsProtected(who.Map)
            heart = Vitals.HealthSafeEvery;
            other = Vitals.OtherSafeEvery;
        end if

        Vitals.Owe(who, Vitals.Health, Vitals.MaxHealth, Vitals.HealthOwed,
                   Stats.HealthRegen(def), heart);
        Vitals.Owe(who, Vitals.Mana, Vitals.MaxMana, Vitals.ManaOwed, Stats.ManaRegen(int), other);
        Vitals.Owe(who, Vitals.Stamina, Vitals.MaxStamina, Vitals.StaminaOwed, legs, other);
    end function

    # One pool, one tick of its own clock. `amount` is what the original paid when that clock came
    # round and `every` is how long it took to come round, both as the original wrote them. This pays
    # the share one tick is worth and keeps the remainder for the next.
    function Owe(Player who, string key, string ceilingKey, string owedKey,
                 integer amount, integer every)
        if amount < 1 or every < 1
            yield;
        end if

        integer owed = who.Number(owedKey) + amount * Vitals.TickHundredths * 1000 / every;
        integer whole = owed / 1000;

        who.SetNumber(owedKey, owed - whole * 1000);

        if whole > 0
            Vitals.Give(who, key, ceilingKey, whole);
        end if
    end function

    # One pool, never past its ceiling. It writes only when the value changes: every write ships an
    # attribute to everybody who can see the body, and a full bar rewritten every tick is that traffic
    # for nothing.
    public function Give(Player who, string key, string ceilingKey, integer back)
        integer ceiling = who.Number(ceilingKey);
        integer now = who.Number(key);

        if now >= ceiling
            yield;
        end if

        integer wanted = now + back;

        if wanted > ceiling
            wanted = ceiling;
        end if

        who.SetNumber(key, wanted);
    end function

end model
