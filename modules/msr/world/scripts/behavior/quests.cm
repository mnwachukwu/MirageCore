# Taking a quest, counting toward it, and handing it back.
#
# What a quest IS lives in declarations/quests.cm. This file covers what a character does with one.
#
# A character carries one number per quest and one per goal, and nothing else. Where a quest is up to
# is a fact about the character, so it lives on the character rather than in a table beside them that
# a deletion, a rollback, or a second server could disagree with. It costs a declared key per slot.

shared model Quests

    public string Of = "Quest";
    public string Goals = "QuestGoal";
    public string Gates = "QuestGate";

    # ── The dials ─────────────────────────────────────────────────────────────

    # How many quests and goals a character's own record can hold. Below what an author may write, on
    # purpose: a world may author two hundred quests, and a character carries what they have touched.
    public integer Tracked = 40;
    public integer Counted = 120;

    # How many lines the journal shows. A window, not a limit — a reader wants the handful they are
    # working on, and eight of them fit.
    public integer Shown = 8;

    # What a slot holds. Nothing is not-started; the rest are the whole lifecycle.
    #
    # ⚠ A run that is NOT the first is its own state, because it pays differently. Taking a
    # finished quest again is a repeat run, and handing that one in pays the repeat rewards rather than
    # the first-run rewards.
    public integer Taken = 1;
    public integer Finished = 2;
    public integer Repeating = 3;

    # ── When a finished quest opens again ─────────────────────────────────────

    public integer Never = 0;
    public integer Daily = 1;
    public integer Weekly = 2;
    public integer Monthly = 3;
    public integer Seasonally = 4;

    # One number naming the period a day falls in, for that cadence. Two runs in the same period give
    # the same number; a quest re-opens when the number changes.
    #
    # ⚠ A SEASON IGNORES THE DAY and answers with the number the world is keeping. A season is not a
    # slice of the calendar — it starts when the world starts one and runs thirteen whole weeks from
    # there — so there is nothing about a date that could name it. Every caller passes today, which is
    # the only day the answer would be right for anyway.
    public integer function PeriodOf(integer cadence, integer day)
        if cadence == Quests.Daily
            yield day;
        end if

        if cadence == Quests.Weekly
            yield Calendar.WeekOf(day);
        end if

        if cadence == Quests.Monthly
            yield Calendar.MonthKey(day);
        end if

        if cadence == Quests.Seasonally
            yield Season.Which();
        end if

        yield 0;
    end function

    # ⚠ Stamped with ONE added, so a quest finished in period zero is told apart from one never
    # finished at all. Nothing else reads the number.
    public string function PeriodAt(integer slot)
        yield "qwhen" + slot;
    end function

    # Whether a run of this quest is underway, first time or not. Three places ask, and a repeat run
    # that any one of them missed would be a quest nobody could advance, hand in, or see in the journal.
    public boolean function Underway(Player who, integer number)
        integer holding = who.Number(Quests.At(number));

        yield holding == Quests.Taken or holding == Quests.Repeating;
    end function

    public integer function CadenceOf(integer number)
        yield World.RecordNumber(Quests.Of, number, "cadence");
    end function

    # Whether a finished quest has come round again: it re-opens at all, and the period it was
    # finished in has passed.
    public boolean function ComeRound(Player who, integer number)
        integer cadence = Quests.CadenceOf(number);

        if cadence == Quests.Never
            yield false;
        end if

        yield who.Number(Quests.PeriodAt(number))
              != Quests.PeriodOf(cadence, Calendar.Today()) + 1;
    end function

    public string Offer = "msr.quest.offer";
    public string Hand = "msr.quest.hand";

    # ── What the engine carries ───────────────────────────────────────────────

    public function Declare(Builder game)
        loop for slot = 1 to Quests.Tracked
            game.Attribute(Quests.At(slot), "owner");
            game.Attribute(Quests.PeriodAt(slot), "owner");
        end loop

        loop for row = 1 to Quests.Counted
            game.Attribute(Quests.CountAt(row), "owner");
        end loop

        loop for line = 1 to Quests.Shown
            game.Attribute(Quests.LineAt(line), "owner");
            game.Attribute(Quests.LineIdAt(line), "owner");
        end loop

        game.Attribute(Quests.Carried, "owner");

        game.Attribute(Quests.OfferName, "owner");
        game.Attribute(Quests.OfferText, "owner");
        game.Attribute(Quests.OfferWants, "owner");
        game.Attribute(Quests.OfferPays, "owner");

        loop for line = 1 to Quests.Offers
            game.Attribute(Quests.OfferLineAt(line), "owner");
            game.Attribute(Quests.OfferIdAt(line), "owner");
        end loop

        # A conversation choice reaches these. A choice names a verb by the id it was declared with,
        # and picking it opens whatever panel that verb opens, so a giver's own dialogue can end in
        # "Tell me more" and bring up the journal.
        Verb ask = game.Action(Quests.Offer, "Ask about work", "Quests");
        ask.OnNpc();
        ask.Icon("scroll");
        ask.Opens("msr.offer");

        # Both act on the line picked off the board rather than on anything in the world, so neither is
        # offered anywhere a body could be pointed at.
        Verb read = game.Action(Quests.ReadVerb, "What it involves", "Quests");
        read.Nowhere();
        read.Icon("scroll");

        Verb take = game.Action(Quests.TakeVerb, "Take it on", "Quests");
        take.Nowhere();
        take.Icon("coin");

        Verb drop = game.Action(Quests.DropVerb, "Give it up", "Quests");
        drop.Nowhere();
        drop.Icon("clock");

        # Offered only while there is something to hand in, following the original: its menu listed
        # the quests you could actually turn in at that body and nothing else.
        #
        # ⚠ A condition reads the ASKER and not the body asked, so this is "you are carrying work"
        # rather than "this one wants it back". The narrower half is the handler's, which answers a
        # wrong giver by saying so.
        Verb hand = game.Action(Quests.Hand, "Hand it in", "Quests");
        hand.OnNpc();
        hand.NeedsAtLeast(Quests.Carried, 1);
        hand.Icon("coin");

        # What one giver had when you asked, and the window on whichever of them you picked. The
        # original opened this per quest off the NPC's own menu; here the menu asks, and the board is
        # what it answers with.
        Panel offer = game.Panel("msr.offer", "On offer", 330, 300);
        offer.Smallest(300, 200);
        offer.Icon("scroll");

        loop for line = 1 to Quests.Offers
            offer.Row(Quests.OfferLineAt(line), Quests.OfferIdAt(line));
        end loop

        offer.Field(Quests.OfferName, "", 240, 220, 160);
        offer.Field(Quests.OfferText, "", 200, 200, 160);
        offer.Field(Quests.OfferWants, "Wants", 220, 190, 140);
        offer.Field(Quests.OfferPays, "Pays", 240, 210, 120);
        offer.Button("What it involves", Quests.ReadVerb);
        offer.Button("Take it on", Quests.TakeVerb);

        Verb log = game.Action(Quests.LogVerb, "Journal", "Quests");
        log.OnHud();
        log.Icon("scroll");
        log.Opens("msr.journal");

        # J, which is the key the original opened its log with.
        Panel journal = game.Panel("msr.journal", "Journal", 320, 320);
        journal.Smallest(280, 220);
        journal.Key("J");
        journal.Icon("scroll");
        journal.Heading("Underway");

        loop for line = 1 to Quests.Shown
            journal.Row(Quests.LineAt(line), Quests.LineIdAt(line));
        end loop

        journal.Button("Give it up", Quests.DropVerb);
    end function

    public string function At(integer slot)
        yield "quest" + slot;
    end function

    public string function CountAt(integer row)
        yield "qcount" + row;
    end function

    # How many are underway. Carried on the body because the verb that hands one in is offered off it:
    # a condition asks about an attribute, so the count has to BE one.
    public string Carried = "qheld";

    public string DropVerb = "msr.quest.drop";
    public string LogVerb = "msr.quest.log";

    # The journal's own rows carry the quest's number, so giving one up knows which.
    public string function LineIdAt(integer line)
        yield "qjid" + line;
    end function

    public string function LineAt(integer line)
        yield "qlog" + line;
    end function

    # ── Taking one ────────────────────────────────────────────────────────────

    # Somebody asked a creature about work. Every quest that creature offers and this character may
    # take is accepted at once — the original offered them one at a time through a dialogue, and a
    # list they can read afterwards is the same answer without a screen this game cannot draw.
    public function Ask(Player who, integer map, integer x, integer y)
        Npc? giver = World.NpcAt(map, x, y);

        if not giver.HasValue()
            who.Message("There is nobody there to ask.");
            yield;
        end if

        # ⚠ The board is cleared whoever they asked, so a window left open over yesterday's offers
        # cannot be accepted from. It shows what THIS body has, now.
        who.SetText(Quests.OfferName, "");
        who.SetText(Quests.OfferText, "");
        who.SetText(Quests.OfferWants, "");
        who.SetText(Quests.OfferPays, "");

        if Quests.Post(who, giver.Value()) < 1
            who.Message(giver.Value().Name + " has nothing for you.");
        end if
    end function
    # ── What is on offer ──────────────────────────────────────────────────────
    #
    # 🔴 The original NAMED each quest on the giver's own menu and opened a window on the one you
    # picked - its description, what it wants, and what it pays - with a button to take it. A verb is
    # declared ONCE, at load, so a menu entry per quest per giver is the one shape this engine cannot
    # make. The list is the same choice moved one step in: ask, see what they have, read one, take it.
    #
    # ⚠ Written onto the ASKER rather than looked up on the giver, because a panel reads a body and the
    # body it reads is the player's. So the offer is a picture of what one NPC had when they asked.

    public integer Offers = 5;

    public string OfferName = "qoname";
    public string OfferText = "qotext";
    public string OfferWants = "qowants";
    public string OfferPays = "qopays";

    public string function OfferLineAt(integer line)
        yield "qoline" + line;
    end function

    public string function OfferIdAt(integer line)
        yield "qoid" + line;
    end function

    public string ReadVerb = "msr.quest.read";
    public string TakeVerb = "msr.quest.take";

    # What one NPC has for this body right now, as lines to pick from. Everything they could take, and
    # nothing they could not: a quest they have already finished this period is not on offer.
    public integer function Post(Player who, Npc giver)
        integer kind = giver.Kind;
        integer many = World.Records(Quests.Of);
        integer line = 0;

        loop for number = 1 to many
            if number <= Quests.Tracked and World.RecordNumber(Quests.Of, number, "giver") == kind
                if Quests.Offerable(who, number) and line < Quests.Offers
                    line = line + 1;
                    who.SetText(Quests.OfferLineAt(line), World.Record(Quests.Of, number, "name"));
                    who.SetText(Quests.OfferIdAt(line), "" + number);
                end if
            end if
        end loop

        loop for blank = line + 1 to Quests.Offers
            who.SetText(Quests.OfferLineAt(blank), "");
            who.SetText(Quests.OfferIdAt(blank), "");
        end loop

        yield line;
    end function

    # Whether it could be taken if they asked for it. The same gates Take applies, asked before rather
    # than after - a board listing work you cannot accept is a board that lies.
    boolean function Offerable(Player who, integer number)
        integer holding = who.Number(Quests.At(number));

        if holding == Quests.Taken or holding == Quests.Repeating
            yield false;
        end if

        if holding == Quests.Finished and not Quests.ComeRound(who, number)
            yield false;
        end if

        yield Quests.Allows(who, number);
    end function

    # The window on one of them, written when they ask to read it.
    public function Read(Player who, string picked)
        integer number = Quests.Numbered(picked);

        if number < 1
            who.Message("Pick something off the list first.");
            yield;
        end if

        who.SetText(Quests.OfferName, World.Record(Quests.Of, number, "name"));
        who.SetText(Quests.OfferText, World.Record(Quests.Of, number, "description"));
        who.SetText(Quests.OfferWants, Quests.Wanted(number));
        who.SetText(Quests.OfferPays, Quests.Paid(number));
    end function

    # And taking it, which is all the window is for.
    public function Accept(Player who, string picked)
        integer number = Quests.Numbered(picked);

        if number < 1
            who.Message("Pick something off the list first.");
            yield;
        end if

        if not Quests.Take(who, number)
            who.Message("That is not yours to take.");
            yield;
        end if

        Quests.Write(who);
    end function

    # 🔴 Giving one up costs what has been done, and a FIRST run costs the taking as well: it
    # goes back to never having been taken, so it can be taken again from the start. A run of one that
    # was finished before goes back to FINISHED rather than to nothing - otherwise giving up a repeat
    # is how you get a second go at the richer first-time reward.
    public function Abandon(Player who, string picked)
        integer number = Quests.Numbered(picked);

        if number < 1
            who.Message("Pick something out of the journal first.");
            yield;
        end if

        integer holding = who.Number(Quests.At(number));

        if holding != Quests.Taken and holding != Quests.Repeating
            who.Message("You are not doing that one.");
            yield;
        end if

        if holding == Quests.Repeating
            who.SetNumber(Quests.At(number), Quests.Finished);
        end if

        if holding == Quests.Taken
            who.SetNumber(Quests.At(number), 0);
        end if

        Quests.Clear(who, number);
        who.Message("You give up on " + World.Record(Quests.Of, number, "name") + ".");
        Quests.Write(who);
    end function

    # A picked line carries the quest's number as text.
    integer function Numbered(string picked)
        loop for number = 1 to Quests.Tracked
            if picked == "" + number
                yield number;
            end if
        end loop

        yield 0;
    end function

    # What it wants, in a line: the first goal is the one worth naming, and a quest with several says
    # so rather than listing them down a window this size.
    string function Wanted(integer number)
        integer rows = World.Records(Quests.Goals);
        integer found = 0;
        string first = "";

        loop for row = 1 to rows
            if World.RecordNumber(Quests.Goals, row, "quest") == number
                found = found + 1;

                if found == 1
                    first = World.RecordNumber(Quests.Goals, row, "many")
                            + " " + World.Record(Quests.Goals, row, "quarry");
                end if
            end if
        end loop

        if found < 1
            yield "a word with somebody";
        end if

        if found > 1
            yield first + ", and " + (found - 1) + " more";
        end if

        yield first;
    end function

    string function Paid(integer number)
        integer exp = World.RecordNumber(Quests.Of, number, "rewardExp");
        integer item = World.RecordNumber(Quests.Of, number, "rewardItem");

        if item > 0
            yield exp + " experience, and "
                  + World.RecordNumber(Quests.Of, number, "rewardMany")
                  + " " + World.RecordName("Items", item);
        end if

        yield exp + " experience";
    end function


    # ⚠ The refusals are silent. A giver offering four quests to somebody who qualifies for one would
    # otherwise say three things nobody asked about, and a quest you cannot take yet is a rung on a
    # ladder rather than news.
    public boolean function Take(Player who, integer number)
        if number < 1 or number > Quests.Tracked
            yield false;
        end if

        integer holding = who.Number(Quests.At(number));

        if holding == Quests.Taken or holding == Quests.Repeating
            yield false;
        end if

        # Finished, and its period has not come round yet.
        if holding == Quests.Finished and not Quests.ComeRound(who, number)
            yield false;
        end if

        if not Quests.Allows(who, number)
            yield false;
        end if

        # A quest taken again is a REPEAT run, and the state is the only thing that remembers — so
        # handing it in pays what a repeat pays rather than what the first run did.
        integer run = Quests.Taken;

        if holding == Quests.Finished
            run = Quests.Repeating;
        end if

        who.SetNumber(Quests.At(number), run);
        Quests.Clear(who, number);
        who.Message("You take on " + World.Record(Quests.Of, number, "name") + ".");
        yield true;
    end function

    # Everything this game asks before somebody may take one.
    public boolean function Allows(Player who, integer number)
        integer prereq = World.RecordNumber(Quests.Of, number, "prereq");

        if prereq > 0 and who.Number(Quests.At(prereq)) != Quests.Finished
            yield false;
        end if

        if Stats.LevelOf(who) < World.RecordNumber(Quests.Of, number, "reqLevel")
            yield false;
        end if

        if who.Number(Stats.Str) < World.RecordNumber(Quests.Of, number, "reqStr")
            yield false;
        end if

        if who.Number(Stats.Def) < World.RecordNumber(Quests.Of, number, "reqDef")
            yield false;
        end if

        if who.Number(Stats.Spd) < World.RecordNumber(Quests.Of, number, "reqSpd")
            yield false;
        end if

        if who.Number(Stats.Int) < World.RecordNumber(Quests.Of, number, "reqInt")
            yield false;
        end if

        yield Quests.OpenTo(number, who.Number(Classes.Key));
    end function

    # ⚠ No row for a quest means every class may take it.
    public boolean function OpenTo(integer number, integer forClass)
        integer rows = World.Records(Quests.Gates);
        boolean gated = false;

        loop for row = 1 to rows
            if World.RecordNumber(Quests.Gates, row, "forQuest") == number
                gated = true;

                if World.RecordNumber(Quests.Gates, row, "forClass") == forClass
                    yield true;
                end if
            end if
        end loop

        yield not gated;
    end function

    # ── Counting toward one ───────────────────────────────────────────────────

    # Called from the one place a creature dies, so a kill counts whether it was a swing or a spell.
    # A second call site would be a second rule, and the forgotten one would not surface until a
    # quest refused to finish.
    public function Killed(Player who, integer kind)
        integer rows = World.Records(Quests.Goals);
        boolean moved = false;

        loop for row = 1 to rows
            if row <= Quests.Counted and World.RecordNumber(Quests.Goals, row, "quarry") == kind
                integer quest = World.RecordNumber(Quests.Goals, row, "forQuest");

                if quest > 0 and quest <= Quests.Tracked and Quests.Underway(who, quest)
                    integer done = who.Number(Quests.CountAt(row));
                    integer needed = World.RecordNumber(Quests.Goals, row, "many");

                    if done < needed
                        who.SetNumber(Quests.CountAt(row), done + 1);
                        moved = true;

                        if done + 1 >= needed
                            who.Message(World.Record(Quests.Of, quest, "name") + ": that is all of them.");
                        end if
                    end if
                end if
            end if
        end loop

        if moved
            Quests.Write(who);
        end if
    end function

    # Whether every goal of a quest is met. A quest with no goals is met the moment it is taken,
    # which is how a delivery works.
    public boolean function Done(Player who, integer number)
        integer rows = World.Records(Quests.Goals);

        loop for row = 1 to rows
            if row <= Quests.Counted and World.RecordNumber(Quests.Goals, row, "forQuest") == number
                if who.Number(Quests.CountAt(row)) < World.RecordNumber(Quests.Goals, row, "many")
                    yield false;
                end if
            end if
        end loop

        yield true;
    end function

    function Clear(Player who, integer number)
        integer rows = World.Records(Quests.Goals);

        loop for row = 1 to rows
            if row <= Quests.Counted and World.RecordNumber(Quests.Goals, row, "forQuest") == number
                who.SetNumber(Quests.CountAt(row), 0);
            end if
        end loop
    end function

    # ── Handing one back ──────────────────────────────────────────────────────

    public function Give(Player who, integer map, integer x, integer y)
        Npc? taker = World.NpcAt(map, x, y);

        if not taker.HasValue()
            who.Message("There is nobody there to hand it to.");
            yield;
        end if

        integer kind = taker.Kind;
        integer many = World.Records(Quests.Of);
        integer paid = 0;

        loop for number = 1 to many
            if number <= Quests.Tracked and Quests.Underway(who, number)
                if Quests.TakenBy(number) == kind and Quests.Done(who, number)
                    Quests.Pay(who, number);
                    paid = paid + 1;
                end if
            end if
        end loop

        if paid < 1
            who.Message(taker.Name + " has nothing to settle with you.");
        end if

        Quests.Write(who);
    end function

    # Who takes it back: the turn-in creature, or the giver when nobody else was named.
    public integer function TakenBy(integer number)
        integer taker = World.RecordNumber(Quests.Of, number, "turnIn");

        if taker > 0
            yield taker;
        end if

        yield World.RecordNumber(Quests.Of, number, "giver");
    end function

    function Pay(Player who, integer number)
        boolean again = who.Number(Quests.At(number)) == Quests.Repeating;

        who.SetNumber(Quests.At(number), Quests.Finished);

        # The period it was finished in. It stays shut until that period has passed. One is added so
        # a quest finished in period nought is told apart from one never finished.
        who.SetNumber(Quests.PeriodAt(number),
                      Quests.PeriodOf(Quests.CadenceOf(number), Calendar.Today()) + 1);

        string name = World.Record(Quests.Of, number, "name");
        integer item = Quests.PaidItem(number, again);
        integer amount = Quests.PaidMany(number, again);

        if item > 0 and amount > 0
            who.Give(item, amount);
        end if

        who.Message(name + " is settled.");

        # ⚠ Last, because earning may take them up a level and levelling says so. A payout announced
        # after the level-up reads as the reward for the level rather than for the quest.
        Levels.Earn(who, Quests.PaidExp(number, again));
    end function

    # ── What a run pays ───────────────────────────────────────────────────────
    #
    # A later run has its own reward set. ⚠ A repeat reward left at nought is not "pays nothing" — it
    # is "nobody said", and it falls back to what the first run paid. A quest an author set a cadence
    # on and no repeat rewards for still pays.

    public integer function PaidExp(integer number, boolean again)
        if again
            integer paid = World.RecordNumber(Quests.Of, number, "repeatExp");

            if paid > 0
                yield paid;
            end if
        end if

        yield World.RecordNumber(Quests.Of, number, "rewardExp");
    end function

    public integer function PaidItem(integer number, boolean again)
        if again
            integer paid = World.RecordNumber(Quests.Of, number, "repeatItem");

            if paid > 0
                yield paid;
            end if
        end if

        yield World.RecordNumber(Quests.Of, number, "rewardItem");
    end function

    public integer function PaidMany(integer number, boolean again)
        if again
            if World.RecordNumber(Quests.Of, number, "repeatItem") > 0
                yield World.RecordNumber(Quests.Of, number, "repeatMany");
            end if
        end if

        yield World.RecordNumber(Quests.Of, number, "rewardMany");
    end function

    # ── The journal ───────────────────────────────────────────────────────────

    # A window over what is underway, rewritten whenever it changes. The panel reads these keys live
    # off the player, so a game with no journal code still draws one. Somebody with forty quests taken
    # has a screen nobody can read; the eight they are working on is the useful answer.
    public function Write(Player who)
        integer many = World.Records(Quests.Of);
        integer line = 0;
        integer held = 0;

        loop for number = 1 to many
            if number <= Quests.Tracked and Quests.Underway(who, number)
                held = held + 1;

                if line < Quests.Shown
                    line = line + 1;
                    who.SetText(Quests.LineAt(line), Quests.Says(who, number));
                    who.SetText(Quests.LineIdAt(line), "" + number);
                end if
            end if
        end loop

        # Everything underway, not just the eight the journal has room for: what the verb is gated on
        # is whether there is anything to hand in at all.
        who.SetNumber(Quests.Carried, held);

        # Everything past the last one is blanked, or a quest that was settled goes on being shown.
        loop for blank = line + 1 to Quests.Shown
            who.SetText(Quests.LineAt(blank), "");
            who.SetText(Quests.LineIdAt(blank), "");
        end loop
    end function

    # One line: what it is called, and how far along it is.
    string function Says(Player who, integer number)
        string name = World.Record(Quests.Of, number, "name");

        if Quests.Done(who, number)
            yield name + " - ready to hand in";
        end if

        integer rows = World.Records(Quests.Goals);

        loop for row = 1 to rows
            if row <= Quests.Counted and World.RecordNumber(Quests.Goals, row, "forQuest") == number
                integer done = who.Number(Quests.CountAt(row));
                integer needed = World.RecordNumber(Quests.Goals, row, "many");

                if done < needed
                    yield name + " - " + done + " of " + needed;
                end if
            end if
        end loop

        yield name;
    end function

end model
