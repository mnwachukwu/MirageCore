# Experience, and what it buys.

shared model Levels

    # ── Earning it ────────────────────────────────────────────────────────────

    public function Earn(Player who, integer worth)
        if worth < 1
            yield;
        end if

        # A guild at level three pays its members a tenth more for everything they earn.
        worth = worth + Perks.Bonus(who, worth);

        integer level = Stats.LevelOf(who);

        if level >= Stats.MaxLevel
            who.Message("You gain " + worth + " experience.", "rewards");
            Levels.Mark(who);
            yield;
        end if

        integer held = who.Number(Stats.Exp) + worth;

        who.Message("You gain " + worth + " experience.", "rewards");

        # ⚠ A LOOP, not an if. A kill worth more than a whole level has to carry through every level
        # it pays for - one that granted a single level would silently eat the rest.
        loop while held >= Stats.ToNextLevel(level) and level < Stats.MaxLevel
            held = held - Stats.ToNextLevel(level);
            level = level + 1;

            Levels.Rise(who, level);
        end loop

        who.SetNumber(Stats.Level, level);
        who.SetNumber(Stats.Exp, held);
        Levels.Mark(who);
    end function

    # What this level costs to leave, which is the number the experience bar fills toward. Written
    # rather than derived because the CLIENT draws the bar and has no way to run a formula.
    #
    # ⚠ A body at the ceiling has nowhere left to fill to. Its own experience is the ceiling, so
    # the bar reads full and stays there rather than dividing by a zero.
    public function Mark(Player who)
        integer level = Stats.LevelOf(who);

        if level >= Stats.MaxLevel
            who.SetNumber(Stats.NextLevel, Math.Max(1, who.Number(Stats.Exp)));
            yield;
        end if

        who.SetNumber(Stats.NextLevel, Stats.ToNextLevel(level));
    end function

    # ── What a level buys ─────────────────────────────────────────────────────

    function Rise(Player who, integer level)
        who.SetNumber(Stats.Level, level);
        who.SetNumber(Stats.Points, who.Number(Stats.Points) + Stats.PointsPerLevel);

        # The pools grow with the level, and the ceiling has to be recomputed before anybody reads it.
        Vitals.Refresh(who);

        who.Float("Level " + level, 255, 230, 120);
        who.Message("You are level " + level + ", with " + Stats.PointsPerLevel + " points to spend.", "system");

        World.TellOn(who.Map, who.Name + " reaches level " + level + ".", "system");
    end function

    # ── Spending it ───────────────────────────────────────────────────────────
    #
    # ⚠ ALL OR NOTHING. The original took the whole allocation in one message and applied it in
    # one go: an allocation that asks for more than is there buys nothing at all rather than buying
    # what it can afford and dropping the rest. Somebody who staged four points with three left is
    # told so and keeps all three, which is not the same as quietly getting three of what they asked.

    public function Train(Player who, integer str, integer def, integer spd, integer int)
        # A body out of action does not train. It is lying on the floor.
        if who.IsDowned
            yield;
        end if

        if str < 0 or def < 0 or spd < 0 or int < 0
            who.Message("You cannot take a point back out.", "system");
            yield;
        end if

        integer total = str + def + spd + int;

        # Nothing staged. Pressing Confirm on an empty form is not a mistake worth a message.
        if total < 1
            yield;
        end if

        if total > who.Number(Stats.Points)
            who.Message("You do not have that many points to spend.", "system");
            yield;
        end if

        who.SetNumber(Stats.Str, who.Number(Stats.Str) + str);
        who.SetNumber(Stats.Def, who.Number(Stats.Def) + def);
        who.SetNumber(Stats.Spd, who.Number(Stats.Spd) + spd);
        who.SetNumber(Stats.Int, who.Number(Stats.Int) + int);
        who.SetNumber(Stats.Points, who.Number(Stats.Points) - total);

        # One line per stat RAISED, not per point: three points into strength is one sentence, and
        # strength with intelligence is two.
        if str > 0
            who.Message("You feel stronger.", "system");
        end if

        if def > 0
            who.Message("You feel tougher.", "system");
        end if

        if spd > 0
            who.Message("You feel quicker.", "system");
        end if

        if int > 0
            who.Message("You feel wiser.", "system");
        end if

        # Three of the four move a ceiling, and the fourth is cheap to recompute anyway.
        Vitals.Refresh(who);
    end function

end model
