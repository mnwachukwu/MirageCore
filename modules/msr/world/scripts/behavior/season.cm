# Which season it is.
#
# Thirteen weeks, turning over on the same weekday the week itself resets on — so a season is a whole
# number of weeks and never a slice of one.
#
# ⚠ The number is KEPT ON THE WORLD rather than worked out from the epoch. A season that began when
# the server did is the original's rule; arithmetic on the epoch would say a world three days old is
# in its two-hundredth season, and would renumber every season the moment the length changed.
#
# ⚠ And nothing is settled retroactively. A world that has never run adopts its first week reset as
# the start of season one, and a server brought back after a year away begins a season rather than
# ending fifty of them.
#
# What reads the number: the seasonal quest cadence, the leaderboard that ranks guilds on the land
# they held, and the archive that keeps each finished table.

shared model Season

    public integer Weeks = 13;

    # What is kept on the world.
    public string Key = "season";
    public string Began = "seasonbegan";
    public string Walked = "seasonwalked";

    public integer function Which()
        yield World.Number(Season.Key);
    end function

    # Walked day by day rather than answered from today, so a server that was off over a reset still
    # crosses it when it comes back — the same catch-up the guild ledger does, for the same reason.
    public function Tick()
        integer today = Calendar.Today();
        integer last = World.Number(Season.Walked);

        # A world nobody has run before starts from today. Walking from 1970 would run four hundred
        # seasons past before the first player arrived.
        if last < 1
            last = today - 1;
        end if

        loop while last < today
            last = last + 1;

            Season.Day(last);
        end loop

        World.SetNumber(Season.Walked, today);
    end function

    function Day(integer day)
        if not Calendar.IsSunday(day)
            yield;
        end if

        integer began = World.Number(Season.Began);

        # The first reset a world ever sees is the start of season one.
        if began < 1
            World.SetNumber(Season.Began, day);
            World.SetNumber(Season.Key, 1);
            yield;
        end if

        if (day - began) / 7 < Season.Weeks
            yield;
        end if

        # ⚠ The season that is finishing is ended BEFORE the number moves on, because everything the
        # ending reads — who scored what, who placed where — is about that one.
        Season.End(Season.Which());
        Season.Clear();

        World.SetNumber(Season.Began, day);
        World.SetNumber(Season.Key, Season.Which() + 1);

        World.Tell("Season " + Season.Which() + " begins.");
    end function

    # The original's /guildreset season: pay the table out and start the next one without waiting for
    # the thirteenth Sunday. The same two calls the Sunday itself makes, in the same order.
    public function EndNow()
        integer number = Season.Which();

        Season.End(number);
        Season.Clear();

        World.SetNumber(Season.Began, Calendar.Today());
        World.SetNumber(Season.Key, number + 1);

        World.Tell("Season " + Season.Which() + " begins.");
    end function

    # ── The leaderboard ───────────────────────────────────────────────────────
    #
    # A guild scores for the land it holds, once a week, and the longer it has held a piece the more
    # that week is worth. Thirteen weeks later the season ends: the scorers are ranked, paid, written
    # into a record that is never overwritten, and set back to nothing.
    #
    # ⚠ Scoring SKIPS the season's first week, so control established before the season began carries
    # in rather than paying from the first Sunday.

    public integer ScoringFromWeek = 1;

    public integer PointsPerWeek = 100;
    public integer HoldBonusPercent = 25;
    public integer HoldBonusCapWeeks = 12;

    # What a guild scores for one territory this week, held that many war nights running. The bonus
    # compounds a quarter a week and stops climbing after a quarter of a year.
    public integer function HoldScore(integer weeksHeld)
        integer streak = Math.Min(Math.Max(weeksHeld, 0), Season.HoldBonusCapWeeks);

        yield Math.Round(Season.PointsPerWeek * (1.0 + Season.HoldBonusPercent / 100.0 * streak));
    end function

    # What each placing is worth: gold into the vault now, and gold to each member who has actually
    # been playing. Fourth and below take the flat scorer's share; a guild that scored nothing takes
    # nothing.

    public integer function VaultPrize(integer placing)
        if placing == 1
            yield 700000;
        end if

        if placing == 2
            yield 350000;
        end if

        if placing == 3
            yield 175000;
        end if

        if placing > 3
            yield 35000;
        end if

        yield 0;
    end function

    public integer function MemberPrize(integer placing)
        if placing == 1
            yield 175000;
        end if

        if placing == 2
            yield 87500;
        end if

        if placing == 3
            yield 35000;
        end if

        if placing > 3
            yield 17500;
        end if

        yield 0;
    end function

    # ── Where a season's running total is kept ────────────────────────────────

    public string Scored = "gseason";

    # What a guild took and lost fighting over land this season. Counted only for a death in a
    # CONTEST: a grudge war is not on the season's table, so its kills do not weigh on a placing.
    public string Kills = "gwarkills";
    public string Deaths = "gwardeaths";

    # The season a guild was last paid out for, so ranking can walk the table by picking the best
    # guild that has not been paid yet rather than holding a sorted list it has no way to keep.
    public string PaidIn = "gseasonpaid";
    public string ScoredOn = "gscoredon";

    public integer function ScoreOf(integer guild)
        yield World.GuildNumber(guild, Season.Scored);
    end function

    # ── Scoring a week ────────────────────────────────────────────────────────
    #
    # Walked from the same weekly reset the guild ledger runs on, so a week's score lands on the same
    # Sunday the week's books close.
    #
    # ⚠ Guarded by the day it last ran on, PER GUILD, so settling a day twice scores nothing twice.

    public function ScoreWeek(integer day)
        if not Calendar.IsSunday(day)
            yield;
        end if

        if Season.Which() < 1
            yield;
        end if

        if Season.WeeksIn(day) < Season.ScoringFromWeek
            yield;
        end if

        loop for region = 1 to World.Records(Territory.Of)
            if Territory.IsContested(region)
                Season.ScoreOne(region, day);
            end if
        end loop
    end function

    # How many whole weeks into the season this day is.
    public integer function WeeksIn(integer day)
        integer began = World.Number(Season.Began);

        if began < 1
            yield 0;
        end if

        yield Math.Max(0, (day - began) / 7);
    end function

    function ScoreOne(integer region, integer day)
        integer holder = Territory.OwnerOf(region);

        if holder < 1
            yield;
        end if

        if World.GuildNumber(holder, Season.ScoredOn) == day
            yield;
        end if

        World.SetGuildNumber(holder, Season.ScoredOn, day);
        World.SetGuildNumber(holder, Season.Scored,
                             Season.ScoreOf(holder) + Season.HoldScore(Territory.HeldFor(region)));
    end function

    # ── Ending one ────────────────────────────────────────────────────────────
    #
    # Called the moment the number changes. Everything it does reads the season that just finished, so
    # it runs BEFORE the number moves on.

    public function End(integer number)
        integer placing = 0;

        # Ranked by taking the best guild still unpaid, over and over. A script holds no table to
        # sort, and the number of guilds that scored anything in a season is small.
        loop while true
            integer guild = Season.BestUnpaid(number);

            if guild < 1
                yield;
            end if

            placing = placing + 1;

            World.SetGuildNumber(guild, Season.PaidIn, number);
            Season.Pay(guild, placing, number);
        end loop
    end function

    # The best guild that has not been paid for this season, or nothing when they all have. Anything
    # at or below zero never places: a guild that held no land all season did not compete.
    integer function BestUnpaid(integer number)
        integer best = 0;

        loop each guild in World.Guilds()
            if Season.ScoreOf(guild) > 0
                if World.GuildNumber(guild, Season.PaidIn) != number
                    if best < 1 or Season.Outranks(guild, best)
                        best = guild;
                    end if
                end if
            end if
        end loop

        yield best;
    end function

    # ⚠ Every level of this exists to stop two guilds sharing a placing, and a placing is money:
    # the score, then what the guild did in the field, then how many stand in it.
    #
    # ⚠ The original breaks a remaining tie on the NAME. Compass has no ordering on text - Contains
    # and IndexOf, but nothing that says which of two words comes first - so two guilds level on all
    # three keep whatever order the engine hands them.
    boolean function Outranks(integer guild, integer than)
        integer scored = Season.ScoreOf(guild);
        integer other = Season.ScoreOf(than);

        if scored != other
            yield scored > other;
        end if

        integer net = Season.NetOf(guild);
        integer theirs = Season.NetOf(than);

        if net != theirs
            yield net > theirs;
        end if

        integer many = Season.SizeOf(guild);
        integer them = Season.SizeOf(than);

        if many != them
            yield many > them;
        end if

        yield false;
    end function

    # What a guild took minus what it lost, over land, this season.
    public integer function NetOf(integer guild)
        yield World.GuildNumber(guild, Season.Kills) - World.GuildNumber(guild, Season.Deaths);
    end function

    # The whole roster rather than who is online: a placing is about the guild, and half of it being
    # asleep on the night the season ends is not a fact about the guild.
    integer function SizeOf(integer guild)
        integer many = 0;

        loop each account in World.AccountsIn(guild)
            many = many + 1;
        end loop

        yield many;
    end function

    # What a placing is worth, and the line that goes into the record.
    function Pay(integer guild, integer placing, integer number)
        integer vault = Season.VaultPrize(placing);
        integer apiece = Season.MemberPrize(placing);

        if vault > 0
            World.GiveGuildGold(guild, vault);
            World.SetGuildNumber(guild, Ledger.WeeklyIncome,
                                 World.GuildNumber(guild, Ledger.WeeklyIncome) + vault);
        end if

        # ⚠ By POST, and only to members who have been playing. Everything else a rule can do reaches
        # a body in the world, and what a guild earned over thirteen weeks is owed to the people who
        # earned it whether or not they happened to be logged in tonight.
        integer reached = World.MailMembers(guild, Gear.Coin(), apiece,
                                            "Season " + number,
                                            "Your guild placed " + placing + " in season " + number
                                            + ". Here is your share.", true);

        Season.Record(number, placing, guild);

        World.Tell(World.GuildName(guild) + " placed " + placing + " in season " + number
                   + " with " + Season.ScoreOf(guild) + " points.");

        World.TellThese(World.GuildMembers(guild),
                        "Your guild placed " + placing + ". The vault takes " + vault
                        + " gold, and " + reached + " of you were sent " + apiece + " apiece.");
    end function

    # ── The record ────────────────────────────────────────────────────────────
    #
    # Kept on the world, one line per placing, and never overwritten — a season's final table is the
    # only thing left of it once the counters are back at nothing.

    # One store per finished season, a key per placing. World.KeptCount answers how many placed, so
    # nothing has to keep a count beside the table.
    public string function Archive(integer number)
        yield "season" + number;
    end function

    # ⚠ Padded. Keys walk in ORDINAL order, so "10" comes before "2" and a table read back
    # unpadded would put tenth place second.
    public string function RowAt(integer placing)
        if placing < 10
            yield "00" + placing;
        end if

        if placing < 100
            yield "0" + placing;
        end if

        yield "" + placing;
    end function

    function Record(integer number, integer placing, integer guild)
        string table = Season.Archive(number);
        string row = Season.RowAt(placing);

        World.SetKeptNumber(table, row, "placing", placing);
        World.SetKeptText(table, row, "guild", World.GuildName(guild));
        World.SetKeptNumber(table, row, "score", Season.ScoreOf(guild));
        World.SetKeptNumber(table, row, "kills", World.GuildNumber(guild, Season.Kills));
        World.SetKeptNumber(table, row, "deaths", World.GuildNumber(guild, Season.Deaths));
    end function

    # And the counters go back to nothing. Land and streaks survive — a season is a scoreboard, not a
    # map, and resetting who holds what would hand every territory back on the same evening.
    function Clear()
        loop each guild in World.Guilds()
            World.SetGuildNumber(guild, Season.Scored, 0);
            World.SetGuildNumber(guild, Season.Kills, 0);
            World.SetGuildNumber(guild, Season.Deaths, 0);
        end loop
    end function

end model
