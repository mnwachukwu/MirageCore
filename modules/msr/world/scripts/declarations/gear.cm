# What this game hangs on an item the ENGINE owns.
#
# An item's own properties are a closed set, because Core cannot act on a property it has never heard
# of; it knows a weapon has power and durability because it spends both. What a game knows about that
# sword is open, and it belongs on the sword rather than in a table beside it: a level requirement is
# a fact about the item, and a second family keyed by item number stores that fact where it can be
# forgotten.
#
# Extend adds these rows to the editor's own Items form. There is no new folder, no new file, and no
# new packet — an extended family is the same family with more rows on it.

model ItemRules
    # The level MSR needed to wield a piece. Core spends an item's power and durability and has no
    # opinion about who may hold it, which is exactly the kind of fact this is for.
    public integer levelReq;

    # ⚠ The spell a scroll carries, on the scroll rather than on the spell. One value about one item,
    # so it is a field; typed as this game's own Spell model, so the editor draws a picker listing
    # the spells by name.
    public Spell teaches;

    # ⚠ The war currency, and exactly ONE item in a world should carry it. It is what a guild's
    # weekly tax is offset with, and it is earned by killing for your guild in a declared war.
    public boolean valor;

    # ⚠ And the coin, also exactly one. Core spends a guild's vault gold on its own and needs no name
    # for it; anything a RULE charges a person — a bounty, a toll — is charged in this.
    public boolean coin;

    # ⚠ And the casting reagent, also exactly one. A damaging cast spends it, which is what makes a
    # caster's upkeep cost what a warrior's repair bill costs. A world with none authored has casters
    # who fight for free.
    public boolean reagent;

    public shared function Describe(Records these)
        these.Extend("Items");

        these.Caption("levelReq", "Level needed");
        these.Caption("teaches", "Spell written on it");
        these.Caption("valor", "This is valor");
        these.Caption("coin", "This is the coin");
        these.Caption("reagent", "This is the casting reagent");

        these.Range("levelReq", 0, 255);
    end function
end model

# What the Donate button on the vault sends.

model Donation
    public integer amount;
end model

# Which classes may wield which gear.
#
# ⚠ A FAMILY RATHER THAN A FIELD, because the original allowed a LIST of classes per item and a record
# holds fields and not lists. The same shape SpellGate takes, and for the same reason — and as there,
# no row for an item means every class may wield it.

model GearGate
    # Typed as a plain number and pointed at the engine's own Items, so an author picks "Iron Key"
    # rather than remembering that the Iron Key is 214. Items have no model a field could be typed as,
    # which is the whole reason Points exists.
    public integer item;
    public Class forClass;

    public shared function Describe(Records these)
        these.Are("Gear gates", "Gear gate", 500);
        these.Icon("key");

        these.Points("item", "Items");

        these.Caption("item", "Gear");
        these.Caption("forClass", "Wielded by");
    end function
end model
