# What this game hangs on a CREATURE the engine owns.
#
# Core's own creature record says how a body looks, how it moves, how far it notices, and which group
# it belongs to. It has no stats, because an engine that has never heard of strength cannot spend it.
# So every number a fight reads off a creature is here, and an author fills them in on the same form
# the rest of the creature is authored on.
#
# A spawned body carries a copy of these, and Fight.Strike and Fight.Maul read that copy. Anything
# choosing a kind of creature rather than a particular one reads them off the record instead.

model BeastRules
    public integer str;
    public integer def;
    public integer spd;
    # ⚠ Also what a body that KEEPS ITS DISTANCE throws with. A creature authored to hold off with
    # none of this stands there doing nothing, which is a heckler rather than a mistake.
    public integer int;

    public integer hp;

    # Carried by a creature that answers a crime. Every copy of that kind is a guard.
    public boolean guard;

    # Whether it is something a guild would be sent after: a creature that fights, rather than a
    # shopkeeper or a sign. Guild quests are drawn from these and nothing else.
    public boolean hostile;

    # A boss is asked for in tens rather than hundreds, and pays proportionally less for it.
    public boolean boss;

    public shared function Describe(Records these)
        these.Extend("NPCs");

        these.Caption("str", "Strength");
        these.Caption("def", "Defense");
        these.Caption("spd", "Speed");
        these.Caption("int", "Intelligence");
        these.Caption("hp", "Health");
        these.Caption("guard", "Answers a crime");
        these.Caption("hostile", "Fights");
        these.Caption("boss", "A boss");

        these.Range("str", 0, 255);
        these.Range("def", 0, 255);
        these.Range("spd", 0, 255);
        these.Range("int", 0, 255);
        these.Range("hp", 0, 100000);
    end function
end model
