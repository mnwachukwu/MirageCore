<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <!-- Builds windows and views on a headless platform, which is the only thing that proves the XAML
         actually loads: bindings here are reflective and a broken view compiles clean. -->
    <PackageReference Include="Avalonia.Headless.NUnit" Version="12.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\editor\src\Mirage.Editor\Mirage.Editor.csproj" />

    <!-- One icon vocabulary, two tables drawing it: the editor fills paths and the client draws
         pixels. GameIconTests holds both against Core's list, and neither side's own tests would
         notice a glyph that exists on one surface only. -->
    <ProjectReference Include="..\..\..\client\src\Mirage.Client.Shell\Mirage.Client.Shell.csproj" />
  </ItemGroup>

  <!-- 🔴 THE EDITOR'S CATALOG IS THE ONE THIS ASSEMBLY RUNS AGAINST.
       Both applications ship a catalog at lang\*.json, and this is the one project that references
       both — so two sets of four identically named files are copied into one output folder and
       whichever lands second wins. That order is a property of the build graph rather than of
       anything written down: the editor's won here and the client's won on every CI runner, where
       every editor key resolved to its bracketed fallback and a hundred assertions failed on text
       that was never missing.

       So the editor's four are copied last, by name, after the content copy that raced. Ordered
       AfterTargets="CopyFilesToOutputDirectory" because that is the target the race happens in. -->
  <Target Name="EditorCatalogWinsOverTheClients" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <EditorCatalog Include="$(MSBuildThisFileDirectory)..\..\..\editor\src\Mirage.Editor\lang\*.json" />
    </ItemGroup>

    <Error Condition="'@(EditorCatalog)' == ''"
           Text="The editor ships no lang\*.json. Every localized string in this suite would read as its own key." />

    <Copy SourceFiles="@(EditorCatalog)" DestinationFolder="$(OutDir)lang" SkipUnchangedFiles="true" />
  </Target>

  <!-- Hands the editor's source path to LocalizationConventionTests. Reflection can tell us a type's
       BASE CLASS but not whether it USES localized strings, and "uses localized strings" is the
       condition that actually needs a refresh hook - so that one check reads the sources. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>EditorSourceRoot</_Parameter1>
      <!-- Baked in at build time because the test reads the editor's SOURCE, not its assembly, and a
           test binary has no idea where the repository is. It is a separate literal from the
           ProjectReference above, so relocating either project means editing both. The two tests
           that use it fail loudly with "Editor source root not found" rather than scanning zero
           files and passing. -->
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\..\editor\src\Mirage.Editor</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>


  <!-- Source-scanning checks need the repo, not the output dir: a redirected build (how the suites run
       while the editor holds a file lock) puts the binary outside the tree, so walking up from
       AppContext.BaseDirectory would silently find nothing and skip the check instead of running it. -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\..</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
