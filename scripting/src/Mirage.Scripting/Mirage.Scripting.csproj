<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mirage.Scripting</RootNamespace>
  </PropertyGroup>

  <!-- Compass is a SIBLING CHECKOUT, not a package: it publishes no NuGet feed, and the fleet consumes
       its shared code by relative path. Anyone building this project needs D:\Repos\Compass (or whatever
       the checkout is called locally) beside this repository — see docs/scripting.md.

       Counted from this file: Mirage.Scripting -> src -> scripting -> the repository -> the folder both
       checkouts sit in. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Compass\src\Compass.Compiler\Compass.Compiler.csproj" />
    <ProjectReference Include="..\..\..\..\Compass\src\Compass.Interpreter\Compass.Interpreter.csproj" />
    <!-- Compass.Cli is an executable, and referencing it is deliberate: SourceDiscovery and ProjectFile
         are public, and they are where a .cmp project, its references, and a folder of sources are read.
         Re-implementing that here would be a second reader of somebody else's file format, drifting from
         the one their own tool uses. Its entry point is inert to a library that references it.
         See docs/scripting.md for the tidier arrangement this is waiting on. -->
    <ProjectReference Include="..\..\..\..\Compass\src\Compass.Cli\Compass.Cli.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\src\Mirage.Shared\Mirage.Shared.csproj" />
  </ItemGroup>

</Project>
