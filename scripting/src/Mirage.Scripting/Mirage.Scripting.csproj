<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Mirage.Scripting</RootNamespace>
  </PropertyGroup>

  <!-- Compass is a SIBLING CHECKOUT, not a package: it publishes no NuGet feed, and the fleet consumes
       its shared code by relative path. Anyone building this project needs D:\Repos\Compass (or whatever
       the checkout is called locally) beside this repository — see docs/scripting.md.

       Counted from this file: Mirage.Scripting -> src -> scripting -> the repository -> the folder both
       checkouts sit in. -->
  <!-- The compiler, the interpreter, and the runtime they share. Nothing else: deciding WHICH files make
       up a program is a host's business, not the compiler's, and this host has its own answer — see
       ScriptModule. Compass's own command-line tool keeps that decision in its driver for the same
       reason, and its other embedder (the Wasm playground) references exactly these three. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Compass\src\Compass.Compiler\Compass.Compiler.csproj" />
    <ProjectReference Include="..\..\..\..\Compass\src\Compass.Interpreter\Compass.Interpreter.csproj" />
    <ProjectReference Include="..\..\..\..\Compass\src\Compass.Runtime\Compass.Runtime.csproj" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\shared\src\Mirage.Shared\Mirage.Shared.csproj" />
  </ItemGroup>

</Project>
