<!-- DefaultTargets is Build (gated, see the note above that target), NOT PublishAll: a solution build
     invokes each project's DEFAULT targets, so defaulting to PublishAll bypassed the gate entirely. -->
<Project Sdk="Microsoft.Build.NoTargets/3.7.0" DefaultTargets="Build">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DistRoot>$(RepoRoot)dist/</DistRoot>
    <InstallerRoot>$(RepoRoot)dist/installers/</InstallerRoot>
    <!-- Each app packs into its own installer subfolder to keep a local build readable. That folder
         is NOT what prevents a collision: CI attaches every file under installers/ to one GitHub
         release, and release assets are a flat namespace. The CHANNEL is what separates the apps -
         Velopack names its feed releases.{channel}.json with no pack id in it, so all three apps on
         channel "win" would write one filename three times. See _Channel in each target below. -->
    <AppInstallerDir>$(InstallerRoot)server/</AppInstallerDir>
    <!-- Velopack identity, derived from $(GameName) (see Directory.Build.props). _PackId = the per-user
         install-folder name (%LocalAppData%\$(_PackId)) and the prefix of every artifact vpk emits;
         it equals the friendly slug, so vpk's Setup.exe needs no rename below. _PackTitle = the visible
         shortcut / "Apps & features" name. -->
    <_PackId>$(GameNameSlug)-Server</_PackId>
    <_PackTitle>$(GameName) Server</_PackTitle>
    <!-- Its own app's icon — see the note in Mirage.Client.Publish.csproj. -->
    <_InstallerIcon>$(RepoRoot)assets/icons/server.ico</_InstallerIcon>
    <_Csproj>$(RepoRoot)server/src/Mirage.Server.Host/Mirage.Server.Host.csproj</_Csproj>
    <!-- The shell is a SECOND exe in this package, not a fourth app: one installer, two exes.
         mainExe is the WINDOW: it is what the shortcut launches and what an operator expects from a
         double-click. The headless CLI ships beside it as "-Server-Console" for a service manager. -->
    <_ShellCsproj>$(RepoRoot)server/src/Mirage.Server.Shell/Mirage.Server.Shell.csproj</_ShellCsproj>
  </PropertyGroup>

  <!-- DebugType=none covers MANAGED symbols only. Avalonia's SkiaSharp and HarfBuzz ship NATIVE .pdb
       files as package content — 105 MB between them, which more than doubles the installer. -->
  <!-- Publish into an EMPTY folder, always. $(_Rid) is passed by the caller.

       A repeat publish into a stale folder silently drops the project's own content files —
       appsettings.json, serverconfig.json, lang/*.json — while leaving anything the SDK never tracked
       alone. It packages into an installer whose server cannot start (ServerStrings.Load throws on the
       missing lang/en.json). Only bites on the SECOND publish, which is why CI never saw it.

       Both folders: the shell has the same problem in its own, where it drops lang/shell/*.json and
       every label renders as "[Window_Title]". -->
  <Target Name="_CleanPayload">
    <RemoveDir Directories="$(DistRoot)server/$(_Rid);$(DistRoot)server-shell/$(_Rid)" />
  </Target>

  <Target Name="_StripPublishPdbs">
    <ItemGroup>
      <_StrayPdb Include="$(DistRoot)server/*/*.pdb" />
    </ItemGroup>
    <Delete Files="@(_StrayPdb)" />
  </Target>

  <!-- Folds the shell's output into the server's payload. RecursiveDir keeps lang/shell/ nested —
       flattened, it would overwrite the server's own table and stop it booting. Copied rather than
       published straight in, because two projects cannot share a PublishDir. -->
  <Target Name="_CopyShellIntoPayload">
    <ItemGroup>
      <_ShellPayload Include="$(DistRoot)server-shell/$(_Rid)/**/*" Exclude="$(DistRoot)server-shell/$(_Rid)/**/*.pdb" />
    </ItemGroup>
    <Error Condition="'@(_ShellPayload)' == ''"
           Text="The shell published nothing into $(DistRoot)server-shell/$(_Rid)/. The installer would ship without it." />
    <Copy SourceFiles="@(_ShellPayload)" DestinationFolder="$(DistRoot)server/$(_Rid)/%(RecursiveDir)" />
    <!-- Staging only. Once its contents are in the payload it has no reader, and leaving it behind puts
         a second server-looking folder next to dist/client and dist/editor that nothing ships.
         The parent goes only once the last runtime has cleared out of it, so a multi-RID publish does
         not delete a leg that has not been copied yet. -->
    <RemoveDir Directories="$(DistRoot)server-shell/$(_Rid)" />
    <ItemGroup>
      <_ShellStagingLeft Include="$(DistRoot)server-shell/**/*" />
    </ItemGroup>
    <RemoveDir Directories="$(DistRoot)server-shell" Condition="'@(_ShellStagingLeft)' == ''" />
  </Target>

  <!-- The authored world, shipped as seed/ and never as data/. An install therefore cannot overwrite a
       world an operator already has: putting it into play is a deliberate copy of seed/ into data/, which
       the README's Getting Started section and the site's Setup page both spell out. The SERVER and the
       EDITOR ship the same payload from this same source folder, so neither install needs the other.
       Globbed rather than listed, so content added since the last release ships without an edit here.

       Nothing here has to be excluded. A server keeps its own state — accounts, guilds, market listings,
       trade journals, seasons, dropped items — in data/, which is a different folder; a world holds only
       what an author wrote, so the whole of it ships.

       A second, much smaller payload rides along as seed-data/: the defaults an INSTALLATION starts with
       rather than a world, which today is the MOTD. Same rule at the far end — laid down only where there
       is nothing already.

       Runs after the publish, because _CleanPayload empties the folder first. -->
  <Target Name="_CopySeedIntoPayload">
    <ItemGroup>
      <_SeedPayload Include="$(RepoRoot)server/src/Mirage.Server.Host/world/**/*" />
      <_SeedDataPayload Include="$(RepoRoot)server/src/Mirage.Server.Host/data/motd.json" />
    </ItemGroup>
    <Error Condition="'@(_SeedPayload)' == ''"
           Text="No world found under server/src/Mirage.Server.Host/world/. The installer would ship without a world to start from." />
    <Copy SourceFiles="@(_SeedPayload)" DestinationFolder="$(DistRoot)server/$(_Rid)/seed-world/%(RecursiveDir)" />
    <Copy SourceFiles="@(_SeedDataPayload)" DestinationFolder="$(DistRoot)server/$(_Rid)/seed-data/%(RecursiveDir)" />
  </Target>

  <!-- ═══════════════════════════════════════ WINDOWS ═══════════════════════════════════════ -->

  <Target Name="PublishServer_Win">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_CleanPayload" Properties="_Rid=win-x64" />
    <Message Text="── Publishing Server / win-x64 ──" Importance="High" />
    <Exec Command="dotnet publish &quot;$(_Csproj)&quot; /p:PublishProfile=win-x64 --nologo" />
    <Message Text="── Publishing Server Shell / win-x64 (same folder) ──" Importance="High" />
    <Exec Command="dotnet publish &quot;$(_ShellCsproj)&quot; /p:PublishProfile=win-x64 --nologo" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_CopyShellIntoPayload" Properties="_Rid=win-x64" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_CopySeedIntoPayload" Properties="_Rid=win-x64" />
  </Target>

  <Target Name="PackageServer_Win" DependsOnTargets="PublishServer_Win;_StripPublishPdbs">
    <Message Text="── Packaging Server / win-x64 (.exe installer) ──" Importance="High" />
    <PropertyGroup>
      <_Channel>server-win</_Channel>
    </PropertyGroup>
    <MakeDir Directories="$(AppInstallerDir)" />
    <Exec Command="dotnet tool run vpk pack --packId $(_PackId) --packVersion $(Version) --packTitle &quot;$(_PackTitle)&quot; --packAuthors &quot;$(GameAuthor)&quot; --packDir &quot;$(DistRoot)server/win-x64&quot; --mainExe $(GameNameSlug)-Server.exe --runtime win-x64 --channel $(_Channel) --icon &quot;$(_InstallerIcon)&quot; --outputDir &quot;$(AppInstallerDir)&quot;"
          WorkingDirectory="$(RepoRoot)" />
    <!-- vpk already emits the friendly $(_PackId)-$(_Channel)-Setup.exe (packId = the slug), so no Setup rename is needed.
         Only the portable bundle needs vpk's "-Portable" tag dropped. -->
    <ItemGroup>
      <_ServerPortable Include="$(AppInstallerDir)$(_PackId)-*-Portable.zip" />
    </ItemGroup>
    <Move SourceFiles="@(_ServerPortable)"
          DestinationFiles="$(AppInstallerDir)$(_PackId)-$(_Channel).zip" />
  </Target>

  <Target Name="PublishAll_Win" DependsOnTargets="PackageServer_Win">
    <Message Text="═══ Server / Windows complete ═══" Importance="High" />
  </Target>

  <!-- ═══════════════════════════════════════ LINUX ═════════════════════════════════════════ -->

  <Target Name="PublishServer_Linux">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_CleanPayload" Properties="_Rid=linux-x64" />
    <Message Text="── Publishing Server / linux-x64 ──" Importance="High" />
    <Exec Command="dotnet publish &quot;$(_Csproj)&quot; /p:PublishProfile=linux-x64 --nologo" />
    <Message Text="── Publishing Server Shell / linux-x64 (same folder) ──" Importance="High" />
    <Exec Command="dotnet publish &quot;$(_ShellCsproj)&quot; /p:PublishProfile=linux-x64 --nologo" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_CopyShellIntoPayload" Properties="_Rid=linux-x64" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_CopySeedIntoPayload" Properties="_Rid=linux-x64" />
  </Target>

  <Target Name="PackageServer_Linux" DependsOnTargets="PublishServer_Linux;_StripPublishPdbs">
    <Message Text="── Packaging Server / linux-x64 (AppImage) ──" Importance="High" />
    <PropertyGroup>
      <_Channel>server-linux</_Channel>
    </PropertyGroup>
    <MakeDir Directories="$(AppInstallerDir)" />
    <!-- [linux] cross-compiles a Linux bundle from the Windows host; the Windows target omits the
         directive and uses a bare 'vpk pack' (a directive applies only when target OS != host OS).
         macOS cannot be cross-built, so its leg hand-rolls a .app.tar.gz instead of using vpk. -->
    <Exec Command="dotnet tool run vpk [linux] pack --packId $(_PackId) --packVersion $(Version) --packTitle &quot;$(_PackTitle)&quot; --packAuthors &quot;$(GameAuthor)&quot; --packDir &quot;$(DistRoot)server/linux-x64&quot; --mainExe $(GameNameSlug)-Server --runtime linux-x64 --channel $(_Channel) --icon &quot;$(_InstallerIcon)&quot; --outputDir &quot;$(AppInstallerDir)&quot;"
          WorkingDirectory="$(RepoRoot)" />
    <!-- vpk names the AppImage "{PackId}-{Channel}.AppImage" itself once the channel is not the
         platform default, which ours no longer are. It used to emit a bare "{PackId}.AppImage" and
         this target renamed it; that rename now matches nothing, so it is gone. -->
  </Target>

  <Target Name="PublishAll_Linux" DependsOnTargets="PackageServer_Linux">
    <Message Text="═══ Server / Linux complete ═══" Importance="High" />
  </Target>

  <!-- ═══════════════════════════════════════ MACOS ═════════════════════════════════════════ -->

  <Target Name="PublishServer_Osx">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_CleanPayload" Properties="_Rid=osx-x64" />
    <Message Text="── Publishing Server / osx-x64 ──" Importance="High" />
    <Exec Command="dotnet publish &quot;$(_Csproj)&quot; /p:PublishProfile=osx-x64 --nologo" />
    <Message Text="── Publishing Server Shell / osx-x64 (same folder) ──" Importance="High" />
    <Exec Command="dotnet publish &quot;$(_ShellCsproj)&quot; /p:PublishProfile=osx-x64 --nologo" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_CopyShellIntoPayload" Properties="_Rid=osx-x64" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="_CopySeedIntoPayload" Properties="_Rid=osx-x64" />
  </Target>

  <Target Name="PackageServer_Osx" DependsOnTargets="PublishServer_Osx;_StripPublishPdbs">
    <Message Text="── Packaging Server / osx-x64 (.app.tar.gz) ──" Importance="High" />
    <PropertyGroup>
      <_Channel>server-osx</_Channel>
      <_AppBundleName>$(GameNameSlug)-Server.app</_AppBundleName>
      <_AppBundle>$(DistRoot)$(_AppBundleName)</_AppBundle>
    </PropertyGroup>
    <!-- Stage the .app bundle, tar it, then remove the staging dir (it's only an intermediate). -->
    <RemoveDir Directories="$(_AppBundle)" />
    <MakeDir Directories="$(_AppBundle)/Contents/MacOS;$(_AppBundle)/Contents/Resources;$(AppInstallerDir)" />
    <ItemGroup>
      <_OsxFiles Include="$(DistRoot)server/osx-x64/**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_OsxFiles)"
          DestinationFolder="$(_AppBundle)/Contents/MacOS/%(RecursiveDir)" />
    <!-- The name has to match CFBundleIconFile in installer/Info.plist, minus the extension. -->
    <Copy SourceFiles="$(RepoRoot)assets/icons/server.icns"
          DestinationFiles="$(_AppBundle)/Contents/Resources/AppIcon.icns" />
    <!-- Generate Info.plist from the template, substituting the $(GameName)-derived values so the bundle
         name / executable / version track Directory.Build.props (no separate macOS touchpoint to maintain). -->
    <PropertyGroup>
      <_Plist>$([System.IO.File]::ReadAllText('$(RepoRoot)server/installer/Info.plist'))</_Plist>
      <_Plist>$(_Plist.Replace('@EXECUTABLE@', '$(_PackId)'))</_Plist>
      <_Plist>$(_Plist.Replace('@DISPLAYNAME@', '$(_PackTitle)'))</_Plist>
      <_Plist>$(_Plist.Replace('@VERSION@', '$(Version)'))</_Plist>
    </PropertyGroup>
    <WriteLinesToFile File="$(_AppBundle)/Contents/Info.plist" Lines="$(_Plist)" Overwrite="true" />
    <!-- Run from dist/ with relative paths only. An absolute Windows path carries a drive colon,
         which GNU tar reads as a host:path remote spec and tries to resolve as a hostname; the bsdtar
         in System32 takes it literally. Which one answers to `tar` depends on PATH order, so neither
         side of that is something to depend on. -->
    <Exec Command="tar -czf installers/server/$(GameNameSlug)-Server-$(_Channel).app.tar.gz $(_AppBundleName)"
          WorkingDirectory="$(DistRoot)" />
    <RemoveDir Directories="$(_AppBundle)" />
  </Target>

  <Target Name="PublishAll_Osx" DependsOnTargets="PackageServer_Osx">
    <Message Text="═══ Server / macOS complete ═══" Importance="High" />
  </Target>

  <!-- ══════════════════════════════════════ ALL PLATFORMS ══════════════════════════════════ -->

  <Target Name="PublishAll" DependsOnTargets="PublishAll_Win;PublishAll_Linux;PublishAll_Osx">
    <Message Text="═══════════════════════════════════════════════════" Importance="High" />
    <Message Text="  Server publish complete — all platforms           " Importance="High" />
    <Message Text="═══════════════════════════════════════════════════" Importance="High" />
  </Target>

  <!-- Publishing is a release action, not part of an ordinary build — see the note in
       Mirage.Publish.csproj.  Packaging runs only for an explicit /t:PublishAll (or PublishAll_Win /
       PublishAll_Linux / PublishAll_Osx for one platform).
       The hint is hooked with AfterTargets rather than by redefining Build, which the NoTargets SDK
       imports after this file and would silently override — the same trap that left the old
       Build/PublishAll alias dead. -->
  <Target Name="_PublishHint" AfterTargets="Build">
    <Message Importance="High"
             Text="$(MSBuildProjectName): packaging skipped. Run `dotnet msbuild &quot;$(MSBuildProjectFullPath)&quot; /t:PublishAll` to publish." />
  </Target>

</Project>
