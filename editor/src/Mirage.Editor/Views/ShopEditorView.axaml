<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Mirage.Editor.Models"
             xmlns:controls="using:Mirage.Editor.Controls"
             xmlns:mui="using:Mirage.Ui.Controls"
             xmlns:vm="using:Mirage.Editor.ViewModels"
             Grid.IsSharedSizeScope="True"
             x:DataType="vm:ShopEditorViewModel"
             x:Class="Mirage.Editor.Views.ShopEditorView">

  <Grid x:Name="PanelGrid" RowDefinitions="*,Auto">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" MinWidth="120"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*" MinWidth="200"/>
    </Grid.ColumnDefinitions>

    <!-- ── Left: shop list ── -->
    <DockPanel x:Name="LeftPanel" Grid.Column="0">
      <TextBox x:Name="_filterTextBox"
               DockPanel.Dock="Top"
               Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Margin="4,4,4,2"
               FontSize="11">
        <TextBox.InnerRightContent>
          <Button Classes="clearFilter" Content="×" Focusable="False"
                  Command="{Binding ClearFilterCommand}"
                  IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </TextBox.InnerRightContent>
      </TextBox>
      <TextBlock DockPanel.Dock="Bottom"
                 Text="{Binding FilterStatus}"
                 IsVisible="{Binding IsFilterActive}"
                 FontSize="11" Foreground="#8B84AE"
                 Margin="4,2" HorizontalAlignment="Right"/>
      <ListBox ItemsSource="{Binding FilteredItems}"
               SelectedItem="{Binding SelectedShop}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="&#x1F512;" FontSize="10" VerticalAlignment="Center"
                         Foreground="{DynamicResource MirageFaintBrush}"
                         IsVisible="{Binding LockedByOther}"
                         ToolTip.Tip="{Binding LockHolder}"/>
              <Ellipse Width="7" Height="7" Fill="{DynamicResource MirageWarnBrush}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsDirty}"/>
              <TextBlock Text="{Binding DisplayName}" Padding="4,2"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource MirageLineSoftBrush}"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Right: editor panel ── -->
    <Grid Grid.Column="2">
      <TextBlock x:Name="_selectPrompt"
                 IsVisible="{Binding SelectedShop, Converter={x:Static ObjectConverters.IsNull}}"
                 Foreground="#6B6491" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontStyle="Italic"/>
      <ScrollViewer IsVisible="{Binding SelectedShop, Converter={x:Static ObjectConverters.IsNotNull}}"
                    IsEnabled="{Binding !IsSelectedLocked}">
        <StackPanel Margin="16" Spacing="8">

          <TextBlock x:Name="_sectionTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>

          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_nameLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding SelectedShop.Name}" />
          </mui:FormRow>

          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_typeLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
              <RadioButton x:Name="_storeRadio" IsChecked="{Binding SelectedShop.IsStore, Mode=TwoWay}" GroupName="ShopType"/>
              <RadioButton x:Name="_innRadio"   IsChecked="{Binding SelectedShop.IsInn, Mode=TwoWay}"   GroupName="ShopType"/>
            </StackPanel>
          </mui:FormRow>

          <!-- Keeper NPC — the NPC this shop/inn is assigned to; visible for both store and inn (NPC epic S3) -->
          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_keeperLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <controls:DropdownAutoCompleteBox Grid.Column="1"
                             ItemsSource="{Binding SelectedShop.KeeperEntries}"
                             SelectedItem="{Binding SelectedShop.SelectedKeeper, Mode=TwoWay}"
                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                             FilterMode="Custom" MinimumPrefixLength="0"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="110"
                IsVisible="{Binding SelectedShop.IsStore}">
            <TextBlock x:Name="_fixesItemsLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <CheckBox  Grid.Column="1"
                       IsChecked="{Binding SelectedShop.FixesItems}" />
          </mui:FormRow>

          <mui:FormRow LabelWidth="110"
                IsVisible="{Binding SelectedShop.IsInn}">
            <TextBlock x:Name="_allowBankingLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <CheckBox  Grid.Column="1"
                       IsChecked="{Binding SelectedShop.AllowBanking}" />
          </mui:FormRow>

          <!-- Barter table — visible for Store-type shops only -->
          <TextBlock x:Name="_tradesHeader" Margin="0,8,0,2"
                     IsVisible="{Binding SelectedShop.IsStore}"/>
          <Border BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding SelectedShop.IsStore}">
            <StackPanel>
              <!-- Header row: 2* for item pickers, 1* for qty, fixed col for the per-row remove button -->
              <Grid ColumnDefinitions="2*,*,2*,*,34" Background="#2A2A2A">
                <TextBlock x:Name="_colGiveItem" Grid.Column="0" Padding="6,4" FontWeight="SemiBold"/>
                <TextBlock x:Name="_colGiveQty"  Grid.Column="1" Padding="6,4" FontWeight="SemiBold"/>
                <TextBlock x:Name="_colGetItem"  Grid.Column="2" Padding="6,4" FontWeight="SemiBold"/>
                <TextBlock x:Name="_colGetQty"   Grid.Column="3" Padding="6,4" FontWeight="SemiBold"/>
              </Grid>
              <!-- Empty-state hint shown when the shop has no trades yet -->
              <TextBlock x:Name="_noBartersHint" Margin="8,6" Foreground="#8B84AE" FontStyle="Italic"
                         IsVisible="{Binding SelectedShop.HasNoBarters}"/>
              <!-- Barter rows bound to observable collection; bounded scroll region keeps long lists usable -->
              <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedShop.Barters}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="2*,*,2*,*,34" HorizontalAlignment="Stretch">
                        <controls:DropdownAutoCompleteBox Grid.Column="0"
                                         ItemsSource="{Binding ItemEntries}"
                                         SelectedItem="{Binding SelectedGiveItem, Mode=TwoWay}"
                                         ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                                         FilterMode="Custom" MinimumPrefixLength="0"
                                         PlaceholderText="{Binding GiveItemPlaceholder}"
                                         BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding GiveQuantity}"
                                       Minimum="{Binding GiveQuantityMin}" Maximum="{Binding GiveQuantityMax}" FormatString="0"
                                       BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <controls:DropdownAutoCompleteBox Grid.Column="2"
                                         ItemsSource="{Binding ItemEntries}"
                                         SelectedItem="{Binding SelectedGetItem, Mode=TwoWay}"
                                         ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                                         FilterMode="Custom" MinimumPrefixLength="0"
                                         PlaceholderText="{Binding GetItemPlaceholder}"
                                         BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <NumericUpDown Grid.Column="3" Value="{Binding GetQuantity}"
                                       Minimum="{Binding GetQuantityMin}" Maximum="{Binding GetQuantityMax}" FormatString="0"
                                       BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <Button Grid.Column="4" Content="-" FontWeight="Bold"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectedShop.RemoveBarterCommand}"
                                CommandParameter="{Binding}"
                                Classes="glyph" Margin="2,0,0,1"
                                HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <!-- Add-row button -->
              <Button x:Name="_addBarterBtn"
                      Command="{Binding SelectedShop.AddBarterCommand}"
                      HorizontalAlignment="Left" Margin="8,6" Padding="10,3"/>
            </StackPanel>
          </Border>

          <!-- ── Sales table: items sold for gold at the item's own Price ──
               A separate section rather than more columns on the barter table, because a sales row carries
               one fact (which item) where a trade row carries four. Store-only, same as trades. -->
          <Grid ColumnDefinitions="*,Auto" Margin="0,12,0,2" IsVisible="{Binding SelectedShop.IsStore}">
            <TextBlock x:Name="_salesHeader" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding SelectedShop.SalesSummary}"
                       Foreground="#AAFFAA" FontWeight="SemiBold" FontSize="11" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock x:Name="_salesHint" Margin="0,0,0,4" Foreground="#8B84AE" FontSize="11"
                     TextWrapping="Wrap" IsVisible="{Binding SelectedShop.IsStore}"/>
          <Border BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding SelectedShop.IsStore}">
            <StackPanel>
              <!-- Order | item picker | price | reorder + remove -->
              <Grid ColumnDefinitions="44,*,90,86" Background="#2A2A2A">
                <TextBlock x:Name="_colSalesOrder" Grid.Column="0" Padding="6,4" FontWeight="SemiBold"/>
                <TextBlock x:Name="_colSalesItem"  Grid.Column="1" Padding="6,4" FontWeight="SemiBold"/>
                <TextBlock x:Name="_colSalesPrice" Grid.Column="2" Padding="6,4" FontWeight="SemiBold"
                           HorizontalAlignment="Right"/>
              </Grid>
              <TextBlock x:Name="_noSalesHint" Margin="8,6" Foreground="#8B84AE" FontStyle="Italic"
                         IsVisible="{Binding SelectedShop.HasNoSales}"/>
              <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedShop.Sales}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="44,*,90,86" HorizontalAlignment="Stretch">
                        <TextBlock Grid.Column="0" Text="{Binding SlotIndex}" Padding="6,0"
                                   VerticalAlignment="Center" Foreground="#8B84AE"/>
                        <controls:DropdownAutoCompleteBox Grid.Column="1"
                                         ItemsSource="{Binding ItemEntries}"
                                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                         ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                                         FilterMode="Custom" MinimumPrefixLength="0"
                                         PlaceholderText="{Binding ItemPlaceholder}"
                                         BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <!-- Read-only: price lives on the item, so editing it here would be a lie about
                             which vendor it applies to. Two mutually exclusive TextBlocks rather than one
                             with a bound brush — HasPrice/HasNoPrice are exact complements, so exactly one
                             ever renders and there is nothing to overlap. -->
                        <TextBlock Grid.Column="2" Text="{Binding PriceText}" Padding="6,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   IsVisible="{Binding HasPrice}"/>
                        <TextBlock Grid.Column="2" Text="{Binding PriceText}" Padding="6,0"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="#E0A030" FontStyle="Italic"
                                   IsVisible="{Binding HasNoPrice}"/>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" Margin="2,0,0,1">
                          <Button Content="^" FontWeight="Bold" Classes="glyph"
                                  Command="{Binding $parent[ItemsControl].DataContext.SelectedShop.MoveSaleUpCommand}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="v" FontWeight="Bold" Classes="glyph"
                                  Command="{Binding $parent[ItemsControl].DataContext.SelectedShop.MoveSaleDownCommand}"
                                  CommandParameter="{Binding}"/>
                          <Button Content="-" FontWeight="Bold" Classes="glyph"
                                  Command="{Binding $parent[ItemsControl].DataContext.SelectedShop.RemoveSaleCommand}"
                                  CommandParameter="{Binding}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button x:Name="_addSaleBtn"
                      Command="{Binding SelectedShop.AddSaleCommand}"
                      HorizontalAlignment="Left" Margin="8,6" Padding="10,3"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding SelectedShop.SalesWarning}"
                     IsVisible="{Binding SelectedShop.HasSalesWarning}"
                     Foreground="#E0A030" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,2"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ── Footer: status line, and the always-visible Save / Discard strip ── -->
    <Border Classes="actionBar" Grid.Row="1" Grid.ColumnSpan="3" Padding="8,6"
            BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button x:Name="_copyBtn"
                  ToolTip.Tip="{Binding CopyTooltip}"
                  ToolTip.ShowOnDisabled="True"
                  Command="{Binding CopyCommand}"
                  IsEnabled="{Binding CanCopy}"/>
          <Button x:Name="_discardBtn"
                  Command="{Binding DiscardCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  Classes="danger"/>
          <Button x:Name="_discardAllBtn"
                  Command="{Binding DiscardAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  Classes="danger"/>
          <Button x:Name="_saveBtn"
                  Command="{Binding SaveCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  HotKey="Ctrl+S" ToolTip.Tip="Ctrl+S"
                  Classes="primary"/>
          <Button x:Name="_saveAllBtn"
                  Command="{Binding SaveAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  HotKey="Ctrl+Shift+S" ToolTip.Tip="Ctrl+Shift+S"
                  Classes="primary"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource MirageOkBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
