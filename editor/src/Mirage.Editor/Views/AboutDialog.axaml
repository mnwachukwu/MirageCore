<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Mirage.Editor.Views.AboutDialog"
        Width="420" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <StackPanel Margin="24,20" Spacing="4">

    <TextBlock x:Name="_product" FontSize="17" FontWeight="SemiBold"
               Foreground="{DynamicResource MirageTextBrush}"/>
    <TextBlock x:Name="_version" FontSize="11" Margin="0,0,0,14"
               Foreground="{DynamicResource MirageMutedBrush}"/>

    <TextBlock x:Name="_roleLabel" FontSize="11"
               Foreground="{DynamicResource MirageMutedBrush}"/>
    <TextBlock x:Name="_author" FontSize="14" Margin="0,0,0,12"
               Foreground="{DynamicResource MirageTextBrush}"/>

    <!-- Classes="link" is the shell's existing link styling, used by the reference panels. -->
    <Button x:Name="_siteLink" Classes="link"
            HorizontalAlignment="Left" HorizontalContentAlignment="Left"
            Padding="0" Click="Site_Click"/>

    <TextBlock x:Name="_copyright" FontSize="11" Margin="0,14,0,0"
               Foreground="{DynamicResource MirageMutedBrush}"/>

    <Button x:Name="_closeBtn" HorizontalAlignment="Right" Margin="0,18,0,0"
            IsDefault="True" IsCancel="True" Classes="primary" Click="Close_Click"/>

  </StackPanel>
</Window>
