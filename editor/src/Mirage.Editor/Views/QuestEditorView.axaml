<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Mirage.Editor.Models"
             xmlns:controls="using:Mirage.Editor.Controls"
             xmlns:mui="using:Mirage.Ui.Controls"
             xmlns:vm="using:Mirage.Editor.ViewModels"
             Grid.IsSharedSizeScope="True"
             x:DataType="vm:QuestEditorViewModel"
             x:Class="Mirage.Editor.Views.QuestEditorView">

  <Grid x:Name="PanelGrid" RowDefinitions="*,Auto">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" MinWidth="120"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*" MinWidth="200"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="220" MinWidth="140"/>
    </Grid.ColumnDefinitions>

    <!-- ── Left: quest list ── -->
    <DockPanel x:Name="LeftPanel" Grid.Column="0">
      <TextBox x:Name="_filterTextBox"
               DockPanel.Dock="Top"
               Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Margin="4,4,4,2"
               FontSize="11">
        <TextBox.InnerRightContent>
          <Button Classes="clearFilter" Content="×" Focusable="False"
                  Command="{Binding ClearFilterCommand}"
                  IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </TextBox.InnerRightContent>
      </TextBox>
      <TextBlock DockPanel.Dock="Bottom"
                 Text="{Binding FilterStatus}"
                 IsVisible="{Binding IsFilterActive}"
                 FontSize="11" Foreground="#8B84AE"
                 Margin="4,2" HorizontalAlignment="Right"/>
      <ListBox ItemsSource="{Binding FilteredItems}"
               SelectedItem="{Binding SelectedQuest}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="&#x1F512;" FontSize="10" VerticalAlignment="Center"
                         Foreground="{DynamicResource MirageFaintBrush}"
                         IsVisible="{Binding LockedByOther}"
                         ToolTip.Tip="{Binding LockHolder}"/>
              <Ellipse Width="7" Height="7" Fill="{DynamicResource MirageWarnBrush}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsDirty}"/>
              <TextBlock Text="{Binding DisplayName}" Padding="4,2"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource MirageLineSoftBrush}"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Right: editor panel ── -->
    <Grid Grid.Column="2">
      <TextBlock x:Name="_selectPrompt"
                 IsVisible="{Binding SelectedQuest, Converter={x:Static ObjectConverters.IsNull}}"
                 Foreground="#6B6491" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontStyle="Italic"/>
      <ScrollViewer IsVisible="{Binding SelectedQuest, Converter={x:Static ObjectConverters.IsNotNull}}"
                    IsEnabled="{Binding !IsSelectedLocked}">
        <StackPanel Margin="16" Spacing="8">

          <TextBlock x:Name="_sectionTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>

          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_nameLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding SelectedQuest.Name}" />
          </mui:FormRow>

          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_descriptionLabel" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <TextBox   Grid.Column="1" Text="{Binding SelectedQuest.Description}"
                       AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" VerticalContentAlignment="Top"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_giverLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <controls:DropdownAutoCompleteBox Grid.Column="1"
                             ItemsSource="{Binding SelectedQuest.NpcEntries}"
                             SelectedItem="{Binding SelectedQuest.SelectedGiver, Mode=TwoWay}"
                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                             FilterMode="Custom" MinimumPrefixLength="0"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_turnInLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <controls:DropdownAutoCompleteBox Grid.Column="1"
                             ItemsSource="{Binding SelectedQuest.NpcEntries}"
                             SelectedItem="{Binding SelectedQuest.SelectedTurnIn, Mode=TwoWay}"
                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                             FilterMode="Custom" MinimumPrefixLength="0"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_repeatableLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <CheckBox  Grid.Column="1" IsChecked="{Binding SelectedQuest.Repeatable}"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="110" IsVisible="{Binding SelectedQuest.Repeatable}">
            <TextBlock x:Name="_cadenceLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox  Grid.Column="1" ItemsSource="{Binding SelectedQuest.Cadences}"
                       SelectedItem="{Binding SelectedQuest.Cadence}" HorizontalAlignment="Stretch"/>
          </mui:FormRow>

          <!-- ── Requirements ── -->
          <TextBlock x:Name="_requirementsHeader" Margin="0,8,0,2" FontWeight="SemiBold"/>
          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_reqLevelLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" Value="{Binding SelectedQuest.ReqLevel}" Minimum="0" Maximum="255" FormatString="0"/>
          </mui:FormRow>
          <Grid ColumnDefinitions="110,*,110,*">
            <TextBlock x:Name="_reqStrLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" Value="{Binding SelectedQuest.ReqStr}" Minimum="0" Maximum="255" FormatString="0"/>
            <TextBlock x:Name="_reqDefLabel" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <NumericUpDown Grid.Column="3" Value="{Binding SelectedQuest.ReqDef}" Minimum="0" Maximum="255" FormatString="0"/>
          </Grid>
          <Grid ColumnDefinitions="110,*,110,*">
            <TextBlock x:Name="_reqSpdLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" Value="{Binding SelectedQuest.ReqSpd}" Minimum="0" Maximum="255" FormatString="0"/>
            <TextBlock x:Name="_reqIntLabel" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <NumericUpDown Grid.Column="3" Value="{Binding SelectedQuest.ReqInt}" Minimum="0" Maximum="255" FormatString="0"/>
          </Grid>
          <!-- Allowed classes: unlike the level and stat requirements above, this is a set — a quest
               outside it is invisible to that class, not merely unacceptable. -->
          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_allowedClassesLabel" Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <controls:ClassSelector Grid.Column="1" DataContext="{Binding ClassSelection}"/>
          </mui:FormRow>
          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_prereqLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <controls:DropdownAutoCompleteBox Grid.Column="1"
                             ItemsSource="{Binding SelectedQuest.QuestEntries}"
                             SelectedItem="{Binding SelectedQuest.SelectedPrereq, Mode=TwoWay}"
                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                             FilterMode="Custom" MinimumPrefixLength="0"/>
          </mui:FormRow>

          <!-- ── Objectives ── -->
          <TextBlock x:Name="_objectivesHeader" Margin="0,8,0,2" FontWeight="SemiBold"/>
          <Border BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Grid ColumnDefinitions="*,2*,*,34" Background="#2A2A2A">
                <TextBlock x:Name="_objColKind"   Grid.Column="0" Padding="6,4" FontWeight="SemiBold"/>
                <TextBlock x:Name="_objColTarget" Grid.Column="1" Padding="6,4" FontWeight="SemiBold"/>
                <TextBlock x:Name="_objColCount"  Grid.Column="2" Padding="6,4" FontWeight="SemiBold"/>
              </Grid>
              <TextBlock x:Name="_noObjectivesHint" Margin="8,6" Foreground="#8B84AE" FontStyle="Italic"
                         IsVisible="{Binding SelectedQuest.HasNoObjectives}"/>
              <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedQuest.Objectives}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="*,2*,*,34" HorizontalAlignment="Stretch">
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Kinds}" SelectedItem="{Binding Kind}"
                                  HorizontalAlignment="Stretch" BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <controls:DropdownAutoCompleteBox Grid.Column="1"
                                         ItemsSource="{Binding TargetEntries}"
                                         SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                                         ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                                         FilterMode="Custom" MinimumPrefixLength="0"
                                         PlaceholderText="{Binding TargetPlaceholder}"
                                         BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <NumericUpDown Grid.Column="2" Value="{Binding Count}" Minimum="0" Maximum="9999" FormatString="0"
                                       BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <Button Grid.Column="3" Content="-" FontWeight="Bold"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectedQuest.RemoveObjectiveCommand}"
                                CommandParameter="{Binding}"
                                Classes="glyph" Margin="2,0,0,1"
                                HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button x:Name="_addObjectiveBtn"
                      Command="{Binding SelectedQuest.AddObjectiveCommand}"
                      HorizontalAlignment="Left" Margin="8,6" Padding="10,3"/>
            </StackPanel>
          </Border>

          <!-- ── Rewards ── -->
          <TextBlock x:Name="_rewardsHeader" Margin="0,8,0,2" FontWeight="SemiBold"/>
          <mui:FormRow LabelWidth="110">
            <TextBlock x:Name="_rewardExpLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" Value="{Binding SelectedQuest.RewardExp}" Minimum="0" Maximum="1000000000" FormatString="0"/>
          </mui:FormRow>
          <Border BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="1" CornerRadius="4">
            <StackPanel>
              <Grid ColumnDefinitions="2*,*,34" Background="#2A2A2A">
                <TextBlock x:Name="_rewardColItem" Grid.Column="0" Padding="6,4" FontWeight="SemiBold"/>
                <TextBlock x:Name="_rewardColQty"  Grid.Column="1" Padding="6,4" FontWeight="SemiBold"/>
              </Grid>
              <TextBlock x:Name="_noRewardsHint" Margin="8,6" Foreground="#8B84AE" FontStyle="Italic"
                         IsVisible="{Binding SelectedQuest.HasNoRewards}"/>
              <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedQuest.RewardItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="2*,*,34" HorizontalAlignment="Stretch">
                        <controls:DropdownAutoCompleteBox Grid.Column="0"
                                         ItemsSource="{Binding ItemEntries}"
                                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                         ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                                         FilterMode="Custom" MinimumPrefixLength="0"
                                         PlaceholderText="{Binding ItemPlaceholder}"
                                         BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding Value}"
                                       Minimum="{Binding ValueMin}" Maximum="{Binding ValueMax}" FormatString="0"
                                       BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <Button Grid.Column="2" Content="-" FontWeight="Bold"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectedQuest.RemoveRewardCommand}"
                                CommandParameter="{Binding}"
                                Classes="glyph" Margin="2,0,0,1"
                                HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button x:Name="_addRewardBtn"
                      Command="{Binding SelectedQuest.AddRewardCommand}"
                      HorizontalAlignment="Left" Margin="8,6" Padding="10,3"/>
            </StackPanel>
          </Border>

          <!-- ── Repeat rewards (only meaningful for a repeatable quest) ── -->
          <TextBlock x:Name="_repeatRewardsHeader" Margin="0,8,0,2" FontWeight="SemiBold"
                     IsVisible="{Binding SelectedQuest.Repeatable}"/>
          <mui:FormRow LabelWidth="110" IsVisible="{Binding SelectedQuest.Repeatable}">
            <TextBlock x:Name="_repeatRewardExpLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" Value="{Binding SelectedQuest.RepeatRewardExp}" Minimum="0" Maximum="1000000000" FormatString="0"/>
          </mui:FormRow>
          <Border BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="1" CornerRadius="4"
                  IsVisible="{Binding SelectedQuest.Repeatable}">
            <StackPanel>
              <TextBlock x:Name="_noRepeatRewardsHint" Margin="8,6" Foreground="#8B84AE" FontStyle="Italic"
                         IsVisible="{Binding SelectedQuest.HasNoRepeatRewards}"/>
              <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedQuest.RepeatRewardItems}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnDefinitions="2*,*,34" HorizontalAlignment="Stretch">
                        <controls:DropdownAutoCompleteBox Grid.Column="0"
                                         ItemsSource="{Binding ItemEntries}"
                                         SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                         ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                                         FilterMode="Custom" MinimumPrefixLength="0"
                                         PlaceholderText="{Binding ItemPlaceholder}"
                                         BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <NumericUpDown Grid.Column="1" Value="{Binding Value}"
                                       Minimum="{Binding ValueMin}" Maximum="{Binding ValueMax}" FormatString="0"
                                       BorderThickness="0,0,1,1" CornerRadius="0"/>
                        <Button Grid.Column="2" Content="-" FontWeight="Bold"
                                Command="{Binding $parent[ItemsControl].DataContext.SelectedQuest.RemoveRepeatRewardCommand}"
                                CommandParameter="{Binding}"
                                Classes="glyph" Margin="2,0,0,1"
                                HorizontalAlignment="Center" VerticalAlignment="Stretch"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <Button x:Name="_addRepeatRewardBtn"
                      Command="{Binding SelectedQuest.AddRepeatRewardCommand}"
                      HorizontalAlignment="Left" Margin="8,6" Padding="10,3"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ── Footer: status line, and the always-visible Save / Discard strip ── -->

    <GridSplitter Grid.Column="3" Width="5" Background="{DynamicResource MirageLineSoftBrush}"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Far right: what refers to this record. Its own column rather than a block at the foot of the
         form, so it is visible without scrolling past every field first. Each row opens its record. ── -->
    <DockPanel x:Name="RightPanel" Grid.Column="4" Margin="8,16,8,8"
               IsVisible="{Binding SelectedQuest, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock x:Name="_refsHeader" DockPanel.Dock="Top"
                 FontSize="13" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
      <TextBlock x:Name="_noRefs" DockPanel.Dock="Top"
                 IsVisible="{Binding !HasInboundRefs}"
                 Foreground="{DynamicResource MirageMutedBrush}" FontStyle="Italic"
                 FontSize="11" TextWrapping="Wrap"/>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding InboundRefs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Header}" FontSize="11"
                           Foreground="{DynamicResource MirageMutedBrush}"/>
                <ItemsControl ItemsSource="{Binding Links}" Margin="8,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="link" Command="{Binding OpenCommand}"
                              Content="{Binding DisplayName}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <Border Classes="actionBar" Grid.Row="1" Grid.ColumnSpan="5" Padding="8,6"
            BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button x:Name="_copyBtn"
                  ToolTip.Tip="{Binding CopyTooltip}"
                  ToolTip.ShowOnDisabled="True"
                  Command="{Binding CopyCommand}"
                  IsEnabled="{Binding CanCopy}"/>
          <Button x:Name="_discardBtn"
                  Command="{Binding DiscardCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  Classes="danger"/>
          <Button x:Name="_discardAllBtn"
                  Command="{Binding DiscardAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  Classes="danger"/>
          <Button x:Name="_saveBtn"
                  Command="{Binding SaveCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  HotKey="Ctrl+S" ToolTip.Tip="Ctrl+S"
                  Classes="primary"/>
          <Button x:Name="_saveAllBtn"
                  Command="{Binding SaveAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  HotKey="Ctrl+Shift+S" ToolTip.Tip="Ctrl+Shift+S"
                  Classes="primary"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource MirageOkBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
