<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Mirage.Editor.ViewModels"
        x:Class="Mirage.Editor.Views.WorldSettingsDialog"
        x:DataType="vm:WorldSettingsDialogViewModel"
        Width="460" SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">

  <DockPanel Margin="20" Grid.IsSharedSizeScope="True">

    <TextBlock DockPanel.Dock="Top" Text="{Binding Intro}"
               TextWrapping="Wrap" Margin="0,0,0,12"
               Foreground="{DynamicResource MirageMutedBrush}" FontSize="12"/>

    <Border DockPanel.Dock="Top" Margin="0,0,0,12" Padding="10,8" CornerRadius="4"
            IsVisible="{Binding !IsConfigurable}"
            Background="{DynamicResource MirageBgAltBrush}"
            BorderBrush="{DynamicResource MirageBadBrush}" BorderThickness="1,0,0,0">
      <TextBlock Text="{Binding OfflineOnlyNotice}" TextWrapping="Wrap"
                 Foreground="{DynamicResource MirageBadBrush}" FontSize="12"/>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,14,0,0">
      <Button x:Name="_cancelBtn" Command="{Binding CancelCommand}" IsCancel="True"/>
      <Button x:Name="_confirmBtn" Command="{Binding ConfirmCommand}"
              IsEnabled="{Binding IsConfigurable}"
              IsDefault="True" Classes="primary"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Top" IsEnabled="{Binding IsConfigurable}" Margin="0,0,0,14">

      <TextBlock Text="{Binding NameLabel}" Margin="0,0,0,3"/>
      <TextBox Text="{Binding WorldName, Mode=TwoWay}" MaxLength="60"
               PlaceholderText="{Binding UntitledPlaceholder}"/>
      <TextBlock Text="{Binding NameHint}" TextWrapping="Wrap" Margin="0,3,0,0"
                 Foreground="{DynamicResource MirageMutedBrush}" FontSize="11"/>

      <TextBlock Text="{Binding DefaultMapSizeLabel}" Margin="0,12,0,3"/>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <NumericUpDown Width="120" Minimum="1" Maximum="4096" Increment="1" FormatString="0"
                       Value="{Binding DefaultMapWidth, Mode=TwoWay}"/>
        <TextBlock Text="x" VerticalAlignment="Center"
                   Foreground="{DynamicResource MirageMutedBrush}"/>
        <NumericUpDown Width="120" Minimum="1" Maximum="4096" Increment="1" FormatString="0"
                       Value="{Binding DefaultMapHeight, Mode=TwoWay}"/>
      </StackPanel>
      <TextBlock Text="{Binding DefaultMapSizeHint}" TextWrapping="Wrap" Margin="0,3,0,0"
                 Foreground="{DynamicResource MirageMutedBrush}" FontSize="11"/>
      <TextBlock Text="{Binding DefaultMapSizeWarning}" TextWrapping="Wrap" Margin="0,4,0,0"
                 IsVisible="{Binding DefaultMapSizeWarning, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                 Foreground="{DynamicResource MirageWarnBrush}" FontSize="11"/>

    </StackPanel>

    <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding IsConfigurable}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Grid Margin="0,3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto" SharedSizeGroup="WorldLimitValue"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1" Width="140" Margin="8,0"
                           Minimum="1" Maximum="100000" Increment="100"
                           FormatString="0"
                           Value="{Binding Value}"/>
          </Grid>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </DockPanel>
</Window>
