<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Mirage.Editor.Controls"
             xmlns:models="using:Mirage.Editor.Models"
             xmlns:mui="using:Mirage.Ui.Controls"
             xmlns:vm="using:Mirage.Editor.ViewModels"
             Grid.IsSharedSizeScope="True"
             x:DataType="vm:ClassEditorViewModel"
             x:Class="Mirage.Editor.Views.ClassEditorView">

  <Grid x:Name="PanelGrid" RowDefinitions="*,Auto">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" MinWidth="120"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*" MinWidth="200"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="220" MinWidth="140"/>
    </Grid.ColumnDefinitions>

    <!-- ── Left: class list ── -->
    <DockPanel x:Name="LeftPanel" Grid.Column="0">
      <TextBox x:Name="_filterTextBox"
               DockPanel.Dock="Top"
               Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Margin="4,4,4,2"
               FontSize="11">
        <TextBox.InnerRightContent>
          <Button Classes="clearFilter" Content="×" Focusable="False"
                  Command="{Binding ClearFilterCommand}"
                  IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </TextBox.InnerRightContent>
      </TextBox>
      <TextBlock DockPanel.Dock="Bottom"
                 Text="{Binding FilterStatus}"
                 IsVisible="{Binding IsFilterActive}"
                 FontSize="11" Foreground="#8B84AE"
                 Margin="4,2" HorizontalAlignment="Right"/>
      <ListBox ItemsSource="{Binding FilteredItems}"
               SelectedItem="{Binding SelectedClass}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="&#x1F512;" FontSize="10" VerticalAlignment="Center"
                         Foreground="{DynamicResource MirageFaintBrush}"
                         IsVisible="{Binding LockedByOther}"
                         ToolTip.Tip="{Binding LockHolder}"/>
              <Ellipse Width="7" Height="7" Fill="{DynamicResource MirageWarnBrush}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsDirty}"/>
              <TextBlock Text="{Binding DisplayName}" Padding="4,2"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource MirageLineSoftBrush}"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Right: editor panel ── -->
    <Grid Grid.Column="2">
      <TextBlock x:Name="_selectPrompt"
                 IsVisible="{Binding SelectedClass, Converter={x:Static ObjectConverters.IsNull}}"
                 Foreground="#6B6491" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontStyle="Italic"/>
      <ScrollViewer IsVisible="{Binding SelectedClass, Converter={x:Static ObjectConverters.IsNotNull}}"
                    IsEnabled="{Binding !IsSelectedLocked}">
        <StackPanel Margin="16" Spacing="8">

          <TextBlock x:Name="_sectionTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>

          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_nameLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding SelectedClass.Name}" />
          </mui:FormRow>

          <!-- The character-create screen shows this under the class list, on ONE line. Wrapping here
               is for the author's benefit while typing; the screen truncates and reveals on hover. -->
          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_descLabel" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0"/>
            <TextBox x:Name="_descBox" Grid.Column="1"
                     Text="{Binding SelectedClass.Description}"
                     AcceptsReturn="False" TextWrapping="Wrap" MaxLength="120"/>
          </mui:FormRow>

          <!-- A sheet and a row per sex, each sheet directly above the sprite it indexes. The number is
               what the record stores, so a sheet is picked by index-prefixed name the way a tileset is.
               The create screen previews whichever sex the player picked, and the choice is copied onto
               the character, so editing these restyles who is CREATED next, not who already plays this
               class. -->
          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_spriteSheetMaleLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <controls:DropdownAutoCompleteBox Grid.Column="1"
                                 ItemsSource="{Binding SpriteSheetEntries}"
                                 SelectedItem="{Binding SelectedSpriteSheetMaleEntry, Mode=TwoWay}"
                                 ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrIndex}"
                                 FilterMode="Custom"
                                 MinimumPrefixLength="0"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_spriteMaleLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SpriteEntriesMale}"
                      SelectedItem="{Binding SelectedClass.SpriteMale, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MaxDropDownHeight="320">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:AtlasFramePreview
                        FrameIndex="{Binding}"
                        Atlas="{Binding $parent[ComboBox].DataContext.SpriteBitmapMale}"
                        Mode="SpriteStrip"
                        Animated="True"
                        IsHighlighted="{Binding $parent[ComboBoxItem].IsPointerOver}"/>
                    <TextBlock Text="{Binding, StringFormat='#{0}'}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </mui:FormRow>

          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_spriteSheetFemaleLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <controls:DropdownAutoCompleteBox Grid.Column="1"
                                 ItemsSource="{Binding SpriteSheetEntries}"
                                 SelectedItem="{Binding SelectedSpriteSheetFemaleEntry, Mode=TwoWay}"
                                 ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrIndex}"
                                 FilterMode="Custom"
                                 MinimumPrefixLength="0"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_spriteFemaleLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding SpriteEntriesFemale}"
                      SelectedItem="{Binding SelectedClass.SpriteFemale, Mode=TwoWay}"
                      HorizontalAlignment="Stretch"
                      MaxDropDownHeight="320">
              <ComboBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <controls:AtlasFramePreview
                        FrameIndex="{Binding}"
                        Atlas="{Binding $parent[ComboBox].DataContext.SpriteBitmapFemale}"
                        Mode="SpriteStrip"
                        Animated="True"
                        IsHighlighted="{Binding $parent[ComboBoxItem].IsPointerOver}"/>
                    <TextBlock Text="{Binding, StringFormat='#{0}'}"
                               VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </mui:FormRow>

          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_strLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedClass.Str}"
                           Minimum="0" Maximum="255" FormatString="0"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_intLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedClass.Int}"
                           Minimum="0" Maximum="255" FormatString="0"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_defLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedClass.Def}"
                           Minimum="0" Maximum="255" FormatString="0"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_spdLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedClass.Spd}"
                           Minimum="0" Maximum="255" FormatString="0"/>
          </mui:FormRow>

          <Separator Margin="0,4,0,2" Background="{DynamicResource MirageLineSoftBrush}"/>

          <!-- Vital previews: theoretical fresh Lv.1 character of this class (playerStat = classStat) -->
          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_maxHpLabel" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#8B84AE" FontStyle="Italic"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedClass.LevelOneMaxHp}"
                       VerticalAlignment="Center"
                       Foreground="#88AAFF" FontWeight="SemiBold"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_maxMpLabel" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#8B84AE" FontStyle="Italic"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedClass.LevelOneMaxMp}"
                       VerticalAlignment="Center"
                       Foreground="#88AAFF" FontWeight="SemiBold"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="130">
            <TextBlock x:Name="_maxSpLabel" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#8B84AE" FontStyle="Italic"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedClass.LevelOneMaxSp}"
                       VerticalAlignment="Center"
                       Foreground="#88AAFF" FontWeight="SemiBold"/>
          </mui:FormRow>

          <TextBlock x:Name="_startingStatsNote"
                     FontSize="11" Foreground="#6B6491" Margin="130,0,0,4"/>

          <!-- Regen + base combat preview (compact two-column panel) -->
          <Border Background="#1F1F28" BorderBrush="{DynamicResource MirageLineSoftBrush}" BorderThickness="1"
                  CornerRadius="4" Padding="12,8" Margin="0,4,0,0">
            <Grid ColumnDefinitions="*,*" ColumnSpacing="16">

              <StackPanel Grid.Column="0" Spacing="3">
                <TextBlock x:Name="_regenHeader" FontWeight="SemiBold" FontSize="10" Foreground="#AAAACC" Margin="0,0,0,2"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="_hpRegenLabel" Grid.Column="0" Foreground="#8B84AE" FontStyle="Italic" FontSize="11"/>
                  <TextBlock Grid.Column="1" Text="{Binding SelectedClass.LevelOneHpRegen}" Foreground="{DynamicResource MirageOkBrush}" FontWeight="SemiBold" FontSize="11"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="_mpRegenLabel" Grid.Column="0" Foreground="#8B84AE" FontStyle="Italic" FontSize="11"/>
                  <TextBlock Grid.Column="1" Text="{Binding SelectedClass.LevelOneMpRegen}" Foreground="{DynamicResource MirageOkBrush}" FontWeight="SemiBold" FontSize="11"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="_spRegenLabel" Grid.Column="0" Foreground="#8B84AE" FontStyle="Italic" FontSize="11"/>
                  <TextBlock Grid.Column="1" Text="{Binding SelectedClass.LevelOneSpRegen}" Foreground="{DynamicResource MirageOkBrush}" FontWeight="SemiBold" FontSize="11"/>
                </Grid>
              </StackPanel>

              <StackPanel Grid.Column="1" Spacing="3">
                <TextBlock x:Name="_combatHeader" FontWeight="SemiBold" FontSize="10" Foreground="#AAAACC" Margin="0,0,0,2"/>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="_pdmgLabel" Grid.Column="0" Foreground="#8B84AE" FontStyle="Italic" FontSize="11"/>
                  <TextBlock Grid.Column="1" Text="{Binding SelectedClass.LevelOnePhysDamage}" Foreground="#FFCC66" FontWeight="SemiBold" FontSize="11"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="_mdmgLabel" Grid.Column="0" Foreground="#8B84AE" FontStyle="Italic" FontSize="11"/>
                  <TextBlock Grid.Column="1" Text="{Binding SelectedClass.LevelOneMagicDamage}" Foreground="#FFCC66" FontWeight="SemiBold" FontSize="11"/>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="_mitLabel" Grid.Column="0" Foreground="#8B84AE" FontStyle="Italic" FontSize="11"/>
                  <TextBlock Grid.Column="1" Text="{Binding SelectedClass.LevelOneMit}" Foreground="#FFCC66" FontWeight="SemiBold" FontSize="11"/>
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <!-- Formula notes panel -->
          <Expander x:Name="_notesExpander" IsExpanded="False" Margin="0,4,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="6">

              <TextBlock x:Name="_fmtVitalsHeader" FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtVitalsMaxHp"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtVitalsMaxMp"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtVitalsMaxSp"/>
              </StackPanel>

              <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtVitalsNote"/>

              <TextBlock x:Name="_fmtRegenHeader" FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtRegenHp"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtRegenMp"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtRegenSp"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11"
                         x:Name="_fmtRegenNote"/>

              <TextBlock x:Name="_fmtCombatHeader" FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtCombatPDmg"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtCombatMDmg"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtCombatMit"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11"
                         x:Name="_fmtCombatNote"/>

              <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11" Margin="0,6,0,0"
                         x:Name="_fmtPreviewNote"/>
            </StackPanel>
          </Expander>

          <!-- ── Starting loadout ──────────────────────────────────────────
               Equipment that clears its gates arrives WORN and spells arrive LEARNED, so nothing here
               requires the player to open a bag. The outcome column on each item row is the important
               part: character creation SKIPS a line the class cannot use, so an unusable row produces a
               missing item and no explanation in-game, and this is the only place that shows up. -->
          <Border BorderBrush="{DynamicResource MirageLineSoftBrush}" BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,8,0,0"
                  IsVisible="{Binding SelectedClass, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="4">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="_startItemsLabel" Grid.Column="0" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedClass.LoadoutSummary}"
                           Foreground="#AAFFAA" FontSize="11" VerticalAlignment="Center"/>
              </Grid>

              <ItemsControl ItemsSource="{Binding SelectedClass.StartingItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,70,150,28" Margin="0,0,0,3">
                      <controls:DropdownAutoCompleteBox Grid.Column="0"
                                       ItemsSource="{Binding ItemEntries}"
                                       SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                                       PlaceholderText="{Binding ItemPlaceholder}"
                                       ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                                       FilterMode="Custom" MinimumPrefixLength="0"/>
                      <!-- Quantity is meaningless off currency; the server zeroes it, so the spinner
                           disables rather than showing a number the game discards. -->
                      <NumericUpDown Grid.Column="1" Margin="4,0,0,0"
                                     Value="{Binding Value}"
                                     IsEnabled="{Binding ValueApplies}"
                                     Minimum="{Binding ValueMin}" Maximum="{Binding ValueMax}"
                                     FormatString="0" ShowButtonSpinner="False"/>
                      <TextBlock Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                                 Text="{Binding OutcomeText}" TextWrapping="NoWrap">
                        <TextBlock.Styles>
                          <Style Selector="TextBlock">
                            <Setter Property="Foreground" Value="#7C9"/>
                          </Style>
                        </TextBlock.Styles>
                      </TextBlock>
                      <Button Grid.Column="3" Content="X" Margin="4,0,0,0" Padding="6,2" FontSize="11"
                              Command="{Binding $parent[ItemsControl].DataContext.SelectedClass.RemoveStartingItemCommand}"
                              CommandParameter="{Binding}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button x:Name="_addStartItemButton" Command="{Binding SelectedClass.AddStartingItemCommand}"
                      Padding="8,2" FontSize="11" HorizontalAlignment="Left"/>

              <TextBlock x:Name="_startSkippedWarning" TextWrapping="Wrap" Foreground="#E0A030" FontSize="11"
                         Margin="0,4,0,0" IsVisible="{Binding SelectedClass.HasSkippedStartingItems}"/>

              <!-- Spells are restrictive by construction: the picker only offers what this class could
                   actually learn at level 1, so unlike items there is no illegal state to warn about. -->
              <TextBlock x:Name="_startSpellsLabel" FontWeight="SemiBold" FontSize="12" Margin="0,10,0,0"/>

              <ItemsControl ItemsSource="{Binding SelectedClass.StartingSpells}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid ColumnDefinitions="*,180,28" Margin="0,0,0,3">
                      <controls:DropdownAutoCompleteBox Grid.Column="0"
                                       ItemsSource="{Binding SpellEntries}"
                                       SelectedItem="{Binding SelectedSpell, Mode=TwoWay}"
                                       PlaceholderText="{Binding SpellPlaceholder}"
                                       ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                                       FilterMode="Custom" MinimumPrefixLength="0"/>
                      <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="11"
                                 Foreground="#99BBDD" Text="{Binding DetailText}"/>
                      <Button Grid.Column="2" Content="X" Margin="4,0,0,0" Padding="6,2" FontSize="11"
                              Command="{Binding $parent[ItemsControl].DataContext.SelectedClass.RemoveStartingSpellCommand}"
                              CommandParameter="{Binding}"/>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button x:Name="_addStartSpellButton" Command="{Binding SelectedClass.AddStartingSpellCommand}"
                      Padding="8,2" FontSize="11" HorizontalAlignment="Left"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ── Footer: status line, and the always-visible Save / Discard strip ── -->

    <GridSplitter Grid.Column="3" Width="5" Background="{DynamicResource MirageLineSoftBrush}"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Far right: what refers to this record. Its own column rather than a block at the foot of the
         form, so it is visible without scrolling past every field first. Each row opens its record. ── -->
    <DockPanel x:Name="RightPanel" Grid.Column="4" Margin="8,16,8,8"
               IsVisible="{Binding SelectedClass, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock x:Name="_refsHeader" DockPanel.Dock="Top"
                 FontSize="13" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
      <TextBlock x:Name="_noRefs" DockPanel.Dock="Top"
                 IsVisible="{Binding !HasInboundRefs}"
                 Foreground="{DynamicResource MirageMutedBrush}" FontStyle="Italic"
                 FontSize="11" TextWrapping="Wrap"/>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding InboundRefs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Header}" FontSize="11"
                           Foreground="{DynamicResource MirageMutedBrush}"/>
                <ItemsControl ItemsSource="{Binding Links}" Margin="8,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="link" Command="{Binding OpenCommand}"
                              Content="{Binding DisplayName}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <Border Classes="actionBar" Grid.Row="1" Grid.ColumnSpan="5" Padding="8,6"
            BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button x:Name="_copyBtn"
                  ToolTip.Tip="{Binding CopyTooltip}"
                  ToolTip.ShowOnDisabled="True"
                  Command="{Binding CopyCommand}"
                  IsEnabled="{Binding CanCopy}"/>
          <Button x:Name="_discardButton"
                  Command="{Binding DiscardCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  Classes="danger"/>
          <Button x:Name="_discardAllButton"
                  Command="{Binding DiscardAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  Classes="danger"/>
          <Button x:Name="_saveClassButton"
                  Command="{Binding SaveCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  HotKey="Ctrl+S" ToolTip.Tip="Ctrl+S"
                  Classes="primary"/>
          <Button x:Name="_saveAllButton"
                  Command="{Binding SaveAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  HotKey="Ctrl+Shift+S" ToolTip.Tip="Ctrl+Shift+S"
                  Classes="primary"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource MirageOkBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
