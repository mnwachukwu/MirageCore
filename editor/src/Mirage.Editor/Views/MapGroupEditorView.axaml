<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Mirage.Editor.Models"
             xmlns:controls="using:Mirage.Editor.Controls"
             xmlns:vm="using:Mirage.Editor.ViewModels"
             Grid.IsSharedSizeScope="True"
             x:DataType="vm:MapGroupEditorViewModel"
             x:Class="Mirage.Editor.Views.MapGroupEditorView">

  <Grid x:Name="PanelGrid" RowDefinitions="*,Auto">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" MinWidth="120"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*" MinWidth="200"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="220" MinWidth="140"/>
    </Grid.ColumnDefinitions>

    <!-- ── Left: group list ── -->
    <DockPanel x:Name="LeftPanel" Grid.Column="0">
      <TextBox x:Name="_filterTextBox"
               DockPanel.Dock="Top"
               Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Margin="4,4,4,2"
               FontSize="11">
        <TextBox.InnerRightContent>
          <Button Classes="clearFilter" Content="×" Focusable="False"
                  Command="{Binding ClearFilterCommand}"
                  IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </TextBox.InnerRightContent>
      </TextBox>
      <TextBlock DockPanel.Dock="Bottom"
                 Text="{Binding FilterStatus}"
                 IsVisible="{Binding IsFilterActive}"
                 FontSize="11" Foreground="#8B84AE"
                 Margin="4,2" HorizontalAlignment="Right"/>
      <ListBox ItemsSource="{Binding FilteredItems}"
               SelectedItem="{Binding SelectedMapGroup}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="&#x1F512;" FontSize="10" VerticalAlignment="Center"
                         Foreground="{DynamicResource MirageFaintBrush}"
                         IsVisible="{Binding LockedByOther}"
                         ToolTip.Tip="{Binding LockHolder}"/>
              <Ellipse Width="7" Height="7" Fill="{DynamicResource MirageWarnBrush}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsDirty}"/>
              <TextBlock Text="{Binding DisplayName}" Padding="4,2"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource MirageLineSoftBrush}"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Right: editor panel ── -->
    <Grid Grid.Column="2">
      <TextBlock x:Name="_selectPrompt"
                 IsVisible="{Binding SelectedMapGroup, Converter={x:Static ObjectConverters.IsNull}}"
                 Foreground="#6B6491" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontStyle="Italic"/>
      <ScrollViewer Grid.IsSharedSizeScope="True"
                    IsVisible="{Binding SelectedMapGroup, Converter={x:Static ObjectConverters.IsNotNull}}"
                    IsEnabled="{Binding !IsSelectedLocked}">
        <StackPanel Margin="16" Spacing="8">

          <TextBlock x:Name="_sectionTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_nameLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Text="{Binding SelectedMapGroup.Name}"/>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_displayNameLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Grid.Column="1" Text="{Binding SelectedMapGroup.DisplayNameText}"/>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_territoryLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <CheckBox  Grid.Column="1" IsChecked="{Binding SelectedMapGroup.Territory}"/>
          </Grid>

          <!-- Everything from here down is an inheritable fallback: a map's own value overrides it. -->
          <TextBlock x:Name="_fallbackHeader" Margin="0,8,0,0" FontWeight="SemiBold"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_moralLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox  Grid.Column="1" ItemsSource="{Binding SelectedMapGroup.MoralOptions}"
                       SelectedItem="{Binding SelectedMapGroup.SelectedMoral, Mode=TwoWay}"
                       HorizontalAlignment="Stretch"/>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_musicLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <NumericUpDown Grid.Column="1" Value="{Binding SelectedMapGroup.Music, Mode=TwoWay}"
                           Minimum="0" Maximum="255" FormatString="0"/>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_indoorsLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <CheckBox  Grid.Column="1" IsThreeState="True" IsChecked="{Binding SelectedMapGroup.Indoors}"/>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_alwaysLitLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <CheckBox  Grid.Column="1" IsThreeState="True" IsChecked="{Binding SelectedMapGroup.AlwaysLit}"/>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="_alwaysDarkLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <CheckBox  Grid.Column="1" IsThreeState="True" IsChecked="{Binding SelectedMapGroup.AlwaysDark}"/>
          </Grid>

          <HeaderedContentControl x:Name="_respawnGroup" Classes="propGroup">
            <StackPanel Spacing="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="_bootMapLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <controls:DropdownAutoCompleteBox x:Name="_searchBootMap" Grid.Column="1"
                                 ItemsSource="{Binding MapEntries}"
                                 SelectedItem="{Binding SelectedMapGroup.SelectedBootMap, Mode=TwoWay}"
                                 ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                                 FilterMode="Custom" MinimumPrefixLength="0"/>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="_bootXLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <NumericUpDown Grid.Column="1" Value="{Binding SelectedMapGroup.BootX, Mode=TwoWay}"
                               Minimum="0" Maximum="15" FormatString="0"/>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="_bootYLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <NumericUpDown Grid.Column="1" Value="{Binding SelectedMapGroup.BootY, Mode=TwoWay}"
                               Minimum="0" Maximum="11" FormatString="0"/>
              </Grid>
            </StackPanel>
          </HeaderedContentControl>

          <HeaderedContentControl x:Name="_greetingGroup" Classes="propGroup">
            <StackPanel Spacing="8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="_greetingSpeakerLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding SelectedMapGroup.GreetingSpeaker, Mode=TwoWay}"/>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="_joinSayLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding SelectedMapGroup.JoinSay, Mode=TwoWay}"/>
              </Grid>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" SharedSizeGroup="GroupPropLabel"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="_leaveSayLabel" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Text="{Binding SelectedMapGroup.LeaveSay, Mode=TwoWay}"/>
              </Grid>
            </StackPanel>
          </HeaderedContentControl>

          <TextBlock x:Name="_triStateHint" FontSize="11" Foreground="#8B84AE" FontStyle="Italic"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <GridSplitter Grid.Column="3" Width="5" Background="{DynamicResource MirageLineSoftBrush}"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Far right: the maps that name this group. Membership is a field on the MAP, so this is the only
         place the relationship reads in the direction an author thinks in. Each row opens its map. ── -->
    <DockPanel x:Name="RightPanel" Grid.Column="4" Margin="8,16,8,8"
               IsVisible="{Binding SelectedMapGroup, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock x:Name="_mapsHeader" DockPanel.Dock="Top"
                 FontSize="13" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
      <TextBlock x:Name="_noMaps" DockPanel.Dock="Top"
                 IsVisible="{Binding !HasGroupMaps}"
                 Foreground="{DynamicResource MirageMutedBrush}" FontStyle="Italic"
                 FontSize="11" TextWrapping="Wrap"/>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding GroupMaps}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="link" Command="{Binding OpenCommand}"
                      Content="{Binding DisplayName}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <!-- ── Footer: status line, and the always-visible Save / Discard strip ── -->
    <Border Classes="actionBar" Grid.Row="1" Grid.ColumnSpan="5" Padding="8,6"
            BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button x:Name="_copyBtn"
                  ToolTip.Tip="{Binding CopyTooltip}"
                  ToolTip.ShowOnDisabled="True"
                  Command="{Binding CopyCommand}"
                  IsEnabled="{Binding CanCopy}"/>
          <Button x:Name="_discardBtn"
                  Command="{Binding DiscardCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  Classes="danger"/>
          <Button x:Name="_discardAllBtn"
                  Command="{Binding DiscardAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  Classes="danger"/>
          <Button x:Name="_saveBtn"
                  Command="{Binding SaveCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  HotKey="Ctrl+S" ToolTip.Tip="Ctrl+S"
                  Classes="primary"/>
          <Button x:Name="_saveAllBtn"
                  Command="{Binding SaveAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  HotKey="Ctrl+Shift+S" ToolTip.Tip="Ctrl+Shift+S"
                  Classes="primary"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource MirageOkBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
