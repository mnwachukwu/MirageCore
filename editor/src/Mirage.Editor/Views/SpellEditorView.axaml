<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:Mirage.Editor.Models"
             xmlns:controls="using:Mirage.Editor.Controls"
             xmlns:mui="using:Mirage.Ui.Controls"
             xmlns:vm="using:Mirage.Editor.ViewModels"
             Grid.IsSharedSizeScope="True"
             x:DataType="vm:SpellEditorViewModel"
             x:Class="Mirage.Editor.Views.SpellEditorView">

  <Grid x:Name="PanelGrid" RowDefinitions="*,Auto">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="200" MinWidth="120"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="*" MinWidth="200"/>
      <ColumnDefinition Width="5"/>
      <ColumnDefinition Width="220" MinWidth="140"/>
    </Grid.ColumnDefinitions>

    <!-- ── Left: spell list ── -->
    <DockPanel x:Name="LeftPanel" Grid.Column="0">
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,4,4,2">
        <ComboBox x:Name="_typeFilterCombo"
                  Grid.Column="0"
                  ItemsSource="{Binding SpellTypeFilters}"
                  SelectedItem="{Binding TypeFilter, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  FontSize="11"/>
        <Button Grid.Column="1" Content="×"
                Command="{Binding ClearTypeFilterCommand}"
                IsVisible="{Binding TypeFilter, Converter={x:Static ObjectConverters.IsNotNull}}"
                FontSize="11" Padding="6,0" Margin="2,0,0,0"/>
      </Grid>
      <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="4,0,4,2">
        <ComboBox x:Name="_classReqFilterCombo"
                  Grid.Column="0"
                  ItemsSource="{Binding ClassReqFilterEntries}"
                  SelectedItem="{Binding ClassReqFilter, Mode=TwoWay}"
                  HorizontalAlignment="Stretch"
                  FontSize="11">
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:NamedEntry">
              <TextBlock Text="{Binding Name}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" Content="×"
                Command="{Binding ClearClassReqFilterCommand}"
                IsVisible="{Binding ClassReqFilter, Converter={x:Static ObjectConverters.IsNotNull}}"
                FontSize="11" Padding="6,0" Margin="2,0,0,0"/>
      </Grid>
      <TextBox x:Name="_filterTextBox"
               DockPanel.Dock="Top"
               Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               Margin="4,0,4,2"
               FontSize="11">
        <TextBox.InnerRightContent>
          <Button Classes="clearFilter" Content="×" Focusable="False"
                  Command="{Binding ClearFilterCommand}"
                  IsVisible="{Binding FilterText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        </TextBox.InnerRightContent>
      </TextBox>
      <TextBlock DockPanel.Dock="Bottom"
                 Text="{Binding FilterStatus}"
                 IsVisible="{Binding IsFilterActive}"
                 FontSize="11" Foreground="#8B84AE"
                 Margin="4,2" HorizontalAlignment="Right"/>
      <ListBox ItemsSource="{Binding FilteredItems}"
               SelectedItem="{Binding SelectedSpell}"
               Background="Transparent">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="4">
              <TextBlock Text="&#x1F512;" FontSize="10" VerticalAlignment="Center"
                         Foreground="{DynamicResource MirageFaintBrush}"
                         IsVisible="{Binding LockedByOther}"
                         ToolTip.Tip="{Binding LockHolder}"/>
              <Ellipse Width="7" Height="7" Fill="{DynamicResource MirageWarnBrush}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding IsDirty}"/>
              <TextBlock Text="{Binding DisplayName}" Padding="4,2"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </DockPanel>

    <GridSplitter Grid.Column="1" Width="5" Background="{DynamicResource MirageLineSoftBrush}"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Right: editor panel ── -->
    <Grid Grid.Column="2">
      <TextBlock x:Name="_selectPrompt"
                 IsVisible="{Binding SelectedSpell, Converter={x:Static ObjectConverters.IsNull}}"
                 Foreground="#6B6491" HorizontalAlignment="Center" VerticalAlignment="Center"
                 FontStyle="Italic"/>
      <ScrollViewer IsVisible="{Binding SelectedSpell, Converter={x:Static ObjectConverters.IsNotNull}}"
                    IsEnabled="{Binding !IsSelectedLocked}">
        <StackPanel Margin="16" Spacing="8">

          <TextBlock x:Name="_sectionTitle" FontSize="16" FontWeight="Bold" Margin="0,0,0,4"/>

          <mui:FormRow LabelWidth="165">
            <TextBlock x:Name="_nameLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <TextBox   Grid.Column="1" Text="{Binding SelectedSpell.Name}" />
          </mui:FormRow>

          <mui:FormRow LabelWidth="165">
            <TextBlock x:Name="_typeLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <ComboBox  Grid.Column="1"
                       ItemsSource="{Binding SpellTypes}"
                       SelectedItem="{Binding SelectedSpell.Type}"
                       HorizontalAlignment="Stretch"/>
          </mui:FormRow>

          <!-- Allowed classes: a multi-select, so one spell can be shared by a whole group (the three
               Magic classes, say) rather than locked to a single class. -->
          <mui:FormRow LabelWidth="165">
            <TextBlock x:Name="_allowedClassesLabel" Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0"/>
            <controls:ClassSelector Grid.Column="1" DataContext="{Binding ClassSelection}"/>
          </mui:FormRow>

          <!-- Magnitude: every type except GiveItem, which has none. -->
          <mui:FormRow LabelWidth="165" IsVisible="{Binding SelectedSpell.VitalAmountVisible}">
            <TextBlock Grid.Column="0"
                       Text="{Binding SelectedSpell.VitalAmountLabel}"
                       VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedSpell.VitalAmount}"
                           Minimum="0" Maximum="9999" FormatString="0"/>
          </mui:FormRow>

          <!-- The three GiveItem fields: what to hand over, how many, and what it costs to learn.
               Hidden (and zeroed on save) for every other type. -->
          <mui:FormRow LabelWidth="165" IsVisible="{Binding SelectedSpell.IsGiveItem}">
            <TextBlock x:Name="_giveItemLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <controls:DropdownAutoCompleteBox Grid.Column="1"
                             ItemsSource="{Binding ItemEntries}"
                             SelectedItem="{Binding SelectedGiveItem, Mode=TwoWay}"
                             ItemFilter="{x:Static models:NamedEntryFilter.ByNameOrId}"
                             FilterMode="Custom" MinimumPrefixLength="0"
                             x:Name="_giveItemPicker"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="165" IsVisible="{Binding SelectedSpell.IsGiveItem}">
            <TextBlock x:Name="_itemQuantityLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedSpell.ItemQuantity}"
                           Minimum="0" Maximum="9999" FormatString="0"/>
          </mui:FormRow>

          <mui:FormRow LabelWidth="165" IsVisible="{Binding SelectedSpell.IsGiveItem}">
            <TextBlock x:Name="_intReqLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedSpell.IntReq}"
                           Minimum="0" Maximum="9999" FormatString="0"/>
          </mui:FormRow>

          <!-- Level requirement: every spell type, unlike the fields above. INT decides who may learn a
               spell; this decides when, and it is the only one of the two that can pace a tier ladder. -->
          <mui:FormRow LabelWidth="165">
            <TextBlock x:Name="_levelReqLabel" Grid.Column="0" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Column="1"
                           Value="{Binding SelectedSpell.LevelReq}"
                           Minimum="0" Maximum="255" FormatString="0"/>
          </mui:FormRow>

          <Separator Margin="0,4,0,2" Background="{DynamicResource MirageLineSoftBrush}"/>

          <!-- Calculated MP cost preview -->
          <mui:FormRow LabelWidth="165">
            <TextBlock x:Name="_maxMpCostLabel" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#8B84AE" FontStyle="Italic"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedSpell.MpCostDisplay}"
                       VerticalAlignment="Center"
                       Foreground="#88AAFF" FontWeight="SemiBold"/>
          </mui:FormRow>
          <!-- Reagent-per-cast preview (SubHp only): what a cast takes, then how often it takes the larger. -->
          <mui:FormRow LabelWidth="165" IsVisible="{Binding SelectedSpell.ShowReagentCost}">
            <TextBlock x:Name="_reagentCostLabel" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#8B84AE" FontStyle="Italic"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedSpell.ReagentCost}"
                       VerticalAlignment="Center"
                       Foreground="#88AAFF" FontWeight="SemiBold"/>
          </mui:FormRow>
          <mui:FormRow LabelWidth="165" IsVisible="{Binding SelectedSpell.ShowReagentCost}">
            <TextBlock x:Name="_reagentChanceLabel" Grid.Column="0" VerticalAlignment="Center"
                       Foreground="#8B84AE" FontStyle="Italic"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedSpell.ReagentChance}"
                       VerticalAlignment="Center"
                       Foreground="#88AAFF" FontWeight="SemiBold"/>
          </mui:FormRow>
          <TextBlock x:Name="_mpCostNote"
                     FontSize="11" Foreground="#6B6491" Margin="165,0,0,8"/>

          <!-- Formula notes panel -->
          <Expander x:Name="_notesExpander" IsExpanded="False" Margin="0,4,0,0"
                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="6">

              <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtMagnitudeIntro"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11"
                           x:Name="_fmtMagnitudeBullet1"/>
                <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11"
                           x:Name="_fmtMagnitudeBullet2"/>
                <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11"
                           x:Name="_fmtMagnitudeBullet3"/>
              </StackPanel>

              <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtClassIntNote"/>

              <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtPlayerIntNote"/>

              <TextBlock x:Name="_fmtMagnitudeHeader" FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtMagnitudeRaw"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtMagnitudeContribution"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtMagnitudeActualHit"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11"
                         x:Name="_fmtMagnitudeMitNote"/>

              <TextBlock x:Name="_fmtMpCostHeader" FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtMpCostFormula"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtMpCostNote"/>

              <TextBlock TextWrapping="Wrap" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0" FontWeight="SemiBold"
                         x:Name="_fmtGiveItemHeader"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11"
                           x:Name="_fmtGiveItemBullet1"/>
                <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11"
                           x:Name="_fmtGiveItemBullet2"/>
                <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11"
                           x:Name="_fmtGiveItemBullet3"/>
              </StackPanel>

              <TextBlock x:Name="_fmtMaxMpHeader" FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtMaxMpFormula"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtMaxMpNote"/>

              <TextBlock x:Name="_fmtRangeHeader" FontWeight="SemiBold" Foreground="#99BBDD" FontSize="11" Margin="0,6,0,0"/>
              <StackPanel Margin="8,0,0,0" Spacing="3">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource MirageFaintBrush}" FontSize="11" FontFamily="Cascadia Code,Consolas,monospace"
                           x:Name="_fmtRangeFormula"/>
              </StackPanel>
              <TextBlock TextWrapping="Wrap" Foreground="#8B84AE" FontSize="11" Margin="0,4,0,0"
                         x:Name="_fmtRangeNote"/>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
    </Grid>

    <!-- ── Footer: status line, and the always-visible Save / Discard strip ── -->

    <GridSplitter Grid.Column="3" Width="5" Background="{DynamicResource MirageLineSoftBrush}"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"/>

    <!-- ── Far right: what refers to this record. Its own column rather than a block at the foot of the
         form, so it is visible without scrolling past every field first. Each row opens its record. ── -->
    <DockPanel x:Name="RightPanel" Grid.Column="4" Margin="8,16,8,8"
               IsVisible="{Binding SelectedSpell, Converter={x:Static ObjectConverters.IsNotNull}}">
      <TextBlock x:Name="_refsHeader" DockPanel.Dock="Top"
                 FontSize="13" FontWeight="Bold" Margin="0,0,0,6" TextWrapping="Wrap"/>
      <TextBlock x:Name="_noRefs" DockPanel.Dock="Top"
                 IsVisible="{Binding !HasInboundRefs}"
                 Foreground="{DynamicResource MirageMutedBrush}" FontStyle="Italic"
                 FontSize="11" TextWrapping="Wrap"/>
      <ScrollViewer>
        <ItemsControl ItemsSource="{Binding InboundRefs}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{Binding Header}" FontSize="11"
                           Foreground="{DynamicResource MirageMutedBrush}"/>
                <ItemsControl ItemsSource="{Binding Links}" Margin="8,0,0,0">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Classes="link" Command="{Binding OpenCommand}"
                              Content="{Binding DisplayName}"
                              HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </DockPanel>

    <Border Classes="actionBar" Grid.Row="1" Grid.ColumnSpan="5" Padding="8,6"
            BorderBrush="{DynamicResource MirageLineBrush}" BorderThickness="0,1,0,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button x:Name="_copyBtn"
                  ToolTip.Tip="{Binding CopyTooltip}"
                  ToolTip.ShowOnDisabled="True"
                  Command="{Binding CopyCommand}"
                  IsEnabled="{Binding CanCopy}"/>
          <Button x:Name="_discardBtn"
                  Command="{Binding DiscardCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  Classes="danger"/>
          <Button x:Name="_discardAllBtn"
                  Command="{Binding DiscardAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  Classes="danger"/>
          <Button x:Name="_saveBtn"
                  Command="{Binding SaveCommand}"
                  IsEnabled="{Binding IsSelectedDirty}"
                  HotKey="Ctrl+S" ToolTip.Tip="Ctrl+S"
                  Classes="primary"/>
          <Button x:Name="_saveAllBtn"
                  Command="{Binding SaveAllCommand}"
                  IsEnabled="{Binding HasAnyDirty}"
                  HotKey="Ctrl+Shift+S" ToolTip.Tip="Ctrl+Shift+S"
                  Classes="primary"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource MirageOkBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      </DockPanel>
    </Border>

  </Grid>
</UserControl>
