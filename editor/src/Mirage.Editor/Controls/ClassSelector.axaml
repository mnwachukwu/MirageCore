<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Mirage.Editor.ViewModels"
             x:DataType="vm:ClassSelectionViewModel"
             x:Class="Mirage.Editor.Controls.ClassSelector">

  <!-- The class multi-select shared by the item, spell and quest editors. Its DataContext is a
       ClassSelectionViewModel; the owning editor re-points that at whichever row is selected.

       No box ticked means EVERY class, which is what the summary line says out loud — fifty empty
       checkboxes on their own read as "nothing is allowed", the opposite of the truth. -->
  <StackPanel Spacing="3">
    <TextBlock x:Name="_summary"
               Text="{Binding Summary}"
               Foreground="#99BBDD" FontSize="11" TextWrapping="Wrap"/>
    <Border BorderBrush="{DynamicResource MirageLineSoftBrush}" BorderThickness="1" CornerRadius="3" Padding="6,4">
      <ScrollViewer MaxHeight="132" VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Classes}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ClassToggleViewModel">
              <CheckBox Content="{Binding Label}"
                        IsChecked="{Binding IsSelected, Mode=TwoWay}"
                        FontSize="11" Margin="0,-2"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <TextBlock x:Name="_hint" Foreground="{DynamicResource MirageFaintBrush}" FontSize="10" TextWrapping="Wrap"/>
  </StackPanel>
</UserControl>
