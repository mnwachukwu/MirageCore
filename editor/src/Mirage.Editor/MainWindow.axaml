<ui:FAAppWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Windowing"
        xmlns:vm="using:Mirage.Editor.ViewModels"
        x:Class="Mirage.Editor.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="720"
        MinWidth="800" MinHeight="500"
        Background="{DynamicResource MirageBgBrush}">

  <!-- InputGesture on the menu item only DRAWS the shortcut; the binding here is what makes the key work. -->
  <Window.KeyBindings>
    <KeyBinding Gesture="F5" Command="{Binding RefreshFromDiskCommand}"/>
  </Window.KeyBindings>

  <Grid>

  <DockPanel>

    <!-- ── Toolbar ── -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource MirageSurfaceBrush}"
            BorderBrush="{DynamicResource MirageLineSoftBrush}"
            BorderThickness="0,0,0,1"
            Padding="10,7">
      <DockPanel>
        <Menu DockPanel.Dock="Right" VerticalAlignment="Center" Background="Transparent">
          <!-- A world is a folder, opened from wherever it lives. Offline only: connected, the world is
               the server's. -->
          <MenuItem x:Name="_worldMenu">
            <MenuItem x:Name="_worldNewItem" Command="{Binding NewWorldCommand}"
                      IsVisible="{Binding !IsOnline}"/>
            <MenuItem x:Name="_worldOpenItem" Command="{Binding OpenWorldCommand}"
                      IsVisible="{Binding !IsOnline}"/>
            <MenuItem x:Name="_worldCloseItem" Command="{Binding CloseWorldCommand}"
                      IsVisible="{Binding !IsOnline}" IsEnabled="{Binding HasWorld}"/>
            <MenuItem x:Name="_worldCheckItem" Command="{Binding CheckWorldCommand}"
                      IsEnabled="{Binding HasWorld}"/>
            <MenuItem x:Name="_worldSettingsItem" Command="{Binding WorldSettingsCommand}"
                      IsVisible="{Binding !IsOnline}" IsEnabled="{Binding HasWorld}"/>
            <Separator IsVisible="{Binding !IsOnline}"/>
            <!-- The two directions of a whole-world move. Both need a server on the other end. -->
            <MenuItem x:Name="_worldDownloadItem" Command="{Binding DownloadWorldCommand}"
                      IsVisible="{Binding IsOnline}"/>
            <MenuItem x:Name="_worldUploadItem" Command="{Binding UploadWorldCommand}"
                      IsVisible="{Binding IsOnline}"/>
            <Separator IsVisible="{Binding IsOnline}"/>
            <MenuItem x:Name="_worldRecentItem" ItemsSource="{Binding RecentWorlds}"
                      IsVisible="{Binding !IsOnline}">
              <!-- Each row carries its own command, so the item binds to itself and never reaches back up
                   the tree for the window's view-model.

                   The header is the world's name, or its shortened path where it has no name, and the
                   tooltip is the whole path: a menu wide enough for a real world path is a menu nobody
                   can read, and one that scrolls to fit is worse. -->
              <MenuItem.Styles>
                <Style Selector="MenuItem > MenuItem" x:DataType="vm:RecentWorldViewModel">
                  <Setter Property="Header" Value="{Binding Display}"/>
                  <Setter Property="Command" Value="{Binding OpenCommand}"/>
                  <Setter Property="ToolTip.Tip" Value="{Binding Path}"/>
                </Style>
              </MenuItem.Styles>
            </MenuItem>
          </MenuItem>
          <MenuItem x:Name="_exportMenu">
            <MenuItem x:Name="_exportMapItem"
                      Command="{Binding MapEditor.ExportMapCommand}"
                      IsEnabled="{Binding MapEditor.HasSelectedMap}"/>
            <MenuItem x:Name="_exportAreaItem"
                      Command="{Binding MapEditor.ExportObservableAreaCommand}"
                      IsEnabled="{Binding MapEditor.HasSelectedMap}"/>
            <MenuItem x:Name="_exportWorldItem"
                      Command="{Binding MapEditor.ExportWorldCommand}"
                      IsEnabled="{Binding MapEditor.HasSelectedMap}"/>
          </MenuItem>
          <MenuItem x:Name="_autoSaveMenu">
            <!-- Caption and enablement both follow the connection: auto-save is offline only, so while
                 connected the item says so rather than opening a window that cannot be acted on. -->
            <MenuItem x:Name="_autoSaveConfigureItem"
                      Header="{Binding AutoSaveMenuItemLabel}"
                      IsEnabled="{Binding !IsOnline}"
                      Click="AutoSaveConfigure_Click"/>
          </MenuItem>
          <MenuItem x:Name="_dataMenu">
            <MenuItem x:Name="_dataRefreshItem"
                      Header="{Binding RefreshMenuItemLabel}"
                      Command="{Binding RefreshFromDiskCommand}"
                      InputGesture="F5"/>
            <!-- Enabled while connected: the graphics are this machine's, and a server has no say in
                 them. Only the world is the server's to hand out. -->
            <MenuItem x:Name="_dataReloadAssetsItem"
                      Command="{Binding ReloadAssetsCommand}"/>
          </MenuItem>
          <MenuItem x:Name="_assetsMenu">
            <MenuItem x:Name="_assetsManageItem" Click="AssetsManage_Click"/>
          </MenuItem>
          <MenuItem x:Name="_viewMenu">
            <MenuItem x:Name="_viewWorldPreviewItem"
                      ToggleType="CheckBox"
                      Click="ViewWorldPreview_Click"/>
            <MenuItem x:Name="_viewLayerVisibilityItem"
                      ToggleType="CheckBox"
                      Click="ViewLayerVisibility_Click"/>
            <MenuItem x:Name="_viewConsoleItem"
                      ToggleType="CheckBox"
                      Click="ViewConsole_Click"/>
          </MenuItem>
          <MenuItem x:Name="_languageMenu" />
          <MenuItem x:Name="_helpMenu">
            <MenuItem x:Name="_helpGeneralItem" Click="HelpGeneral_Click"/>
            <MenuItem x:Name="_helpMapEditorItem" Click="HelpMapControls_Click"/>
            <Separator/>
            <MenuItem x:Name="_helpLoggingItem" Click="HelpLogging_Click"/>
            <MenuItem x:Name="_helpAboutItem" Click="HelpAbout_Click"/>
          </MenuItem>
        </Menu>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button x:Name="_connectBtn"
                  Command="{Binding ConnectCommand}"
                  IsVisible="{Binding !IsOnline}" />
          <Button x:Name="_disconnectBtn"
                  Command="{Binding DisconnectCommand}"
                  IsVisible="{Binding IsOnline}" />
          <!-- State as a SHAPE as well as a color, the same badge the server window wears: a dot plus a
               word survives a screenshot and a colorblind reader, where a hue on its own does not. The
               server it is attached to sits OUTSIDE the badge — a pill that stretches to fit a host and
               port is no longer a badge. -->
          <Border Classes="pill" Classes.ok="{Binding IsOnline}" Classes.bad="{Binding !IsOnline}"
                  Margin="6,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <Ellipse Width="7" Height="7" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding ConnectionStatus}"
                         FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding ConnectionEndpoint}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource MirageMutedBrush}"
                     IsVisible="{Binding IsOnline}" />
          <TextBlock Text="{Binding LoadingStatus}"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource MirageWarnBrush}"
                     IsVisible="{Binding LoadingStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ── Navigation rail ──
         The selection model was already here; what it lacked was presentation. Each row is an icon, a
         label, and an accent pill down its left edge when selected — the shape every modern authoring
         tool uses, and the reason nine sections read as a tool rather than as a list box. -->
    <Border DockPanel.Dock="Left"
            Width="{Binding RailWidth}"
            Background="{DynamicResource MirageBgAltBrush}"
            BorderBrush="{DynamicResource MirageLineSoftBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <!-- The collapse toggle sits at the FOOT of the rail, out of the way of the sections it
             governs. Its glyph points where the rail is going, not where it is. -->
        <Button DockPanel.Dock="Bottom"
                Content="{Binding RailToggleGlyph}"
                Command="{Binding ToggleRailCommand}"
                ToolTip.Tip="{Binding RailToggleTooltip}"
                Background="Transparent" BorderThickness="0"
                Margin="6,4,6,8" Padding="0,4"
                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                Foreground="{DynamicResource MirageFaintBrush}" FontSize="13"/>
        <!-- With no world open there is nothing for a section to show, so none can be picked: an editor
             opened here would list the records of whatever was open last. -->
        <ListBox ItemsSource="{Binding Sections}"
                 SelectedItem="{Binding SelectedSection}"
                 IsEnabled="{Binding !ShowEmptyWorld}"
                 Classes="rail" Classes.collapsed="{Binding IsRailCollapsed}"
                 Background="Transparent"
                 Padding="6,8">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- Collapsed, the tooltip is the only thing that names the section, so it is bound on the
                   row rather than on the icon: the whole 64px strip is the hover target. -->
              <Grid ColumnDefinitions="Auto,*,Auto" Height="24"
                    Background="Transparent"
                    ToolTip.Tip="{Binding TooltipText}">
                <PathIcon Grid.Column="0"
                          Data="{Binding Name, Converter={StaticResource SectionIcon}}"
                          Width="15" Height="15"
                          VerticalAlignment="Center"/>
                <!-- The gap belongs to the label, not the icon — hiding the label has to take its
                     spacing with it, or the icon sits off-center in a 64px rail. -->
                <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                           VerticalAlignment="Center" FontSize="13" Margin="11,0,0,0"
                           IsVisible="{Binding IsLabelVisible}"/>
                <!-- Unsaved work on that section. Amber rather than the accent, so "needs attention" never
                     reads as "selected". Kept in both states: it is the reason to look at the rail. -->
                <Ellipse Grid.Column="2" Width="6" Height="6"
                         Fill="{DynamicResource MirageWarnBrush}"
                         VerticalAlignment="Center"
                         IsVisible="{Binding HasDirty}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ── Content area ── -->
    <!-- Both fill it and exactly one is ever visible, so they share a Grid: a DockPanel gives the fill to
         its LAST child only, and a sibling here would dock to an edge instead of centring.

         The editor is bound to the same condition rather than left to whatever last set CurrentEditor:
         a message centered over a populated editor reads as a broken window, and only one code path has
         to forget for that to happen. -->
    <Grid>
      <ContentControl Content="{Binding CurrentEditor}" Margin="0"
                      IsVisible="{Binding !ShowEmptyWorld}" />

      <!-- Nothing is open until something is opened, and the window says which. -->
      <StackPanel IsVisible="{Binding ShowEmptyWorld}"
                  HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
        <TextBlock x:Name="_emptyWorldTitle" FontSize="16" FontWeight="SemiBold"
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource MirageMutedBrush}"/>
        <TextBlock x:Name="_emptyWorldHint" FontSize="12" HorizontalAlignment="Center"
                   TextWrapping="Wrap" MaxWidth="360" TextAlignment="Center"
                   Foreground="{DynamicResource MirageFaintBrush}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
          <Button x:Name="_emptyWorldNew" Command="{Binding NewWorldCommand}" Classes="primary"/>
          <Button x:Name="_emptyWorldOpen" Command="{Binding OpenWorldCommand}"/>
        </StackPanel>
      </StackPanel>
    </Grid>

  </DockPanel>

    <!-- ── Startup overlay ──────────────────────────────────────────────────────────────────────
         App.axaml.cs starts loading fire-and-forget (`_ = vm.InitializeAsync()`), so this window is
         on screen and accepting clicks before any data exists. A click in that gap is SILENTLY
         dropped: the UI looks finished, so it reads as the app ignoring you rather than as the app
         not being ready. This covers the window until the data is in.

         The Border needs a non-null Background to swallow pointer input — a transparent one would
         dim the UI and let every click straight through, which is the worst of both. -->
    <Border IsVisible="{Binding IsLoading}" Background="#E616122A">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
        <TextBlock Text="{Binding LoadingStatus}"
                   HorizontalAlignment="Center" FontSize="13"
                   Foreground="{DynamicResource MirageTextBrush}"/>
        <ProgressBar IsIndeterminate="True" Width="240" Height="4"/>
      </StackPanel>
    </Border>

  </Grid>
</ui:FAAppWindow>
